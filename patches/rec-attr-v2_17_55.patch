 	DOIF_DRYRUN	= 0x0008,
+
+	/* Capture object attributes at iteration time; rec() can then return
+	 * them via struct dt_otable_rec (LFU).  Additive: OSDs without support
+	 * ignore the bit and rec() keeps the bare-FID contract. */
+	DOIF_ATTR	= 0x0010,
+};
+
+/* rec() attr bit requesting struct dt_otable_rec instead of a bare FID */
+#define DORA_ATTR 0x01
+
+struct dt_otable_rec {
+	struct lu_fid	dor_fid;
+	struct lu_attr	dor_attr;
 };
 
