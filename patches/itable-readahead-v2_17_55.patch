+/**
+ * osd_itable_readahead() - keep N inode-table blocks in flight ahead of the walk
+ * @it: the private iterator
+ * @desc: group descriptor for the group being walked
+ * @pos: the inode about to be read
+ *
+ * The private walk reaches each inode through osd_iget() -> ldiskfs_iget() ->
+ * __ldiskfs_get_inode_loc(), and cold the device sits mostly idle -- measured
+ * at 14-17% utilisation of an NVMe stripe while the userspace device scanner,
+ * which streams whole block groups, reached 93%.  Note that this is NOT a bare
+ * read per block: __ldiskfs_get_inode_loc() already issues a plugged 32-block
+ * window of its own (EXT4_DEF_INODE_READAHEAD_BLKS), so every number measured
+ * against this baseline is measured on top of that window, and a value below
+ * 32 here disrupts it rather than adding to it.
+ *
+ * Inodes are walked in ascending order within a group, so the blocks this
+ * walk is about to want are exactly the next ones.  Issue them as readahead
+ * and let the elevator overlap them.  Each block is submitted once per group;
+ * a block already in the buffer cache costs a lookup and no I/O (LFU).
+ */
+static void osd_itable_readahead(struct osd_otable_it *it,
+				 struct ldiskfs_group_desc *desc, __u32 pos)
+{
+	struct osd_iit_param *param = &it->ooi_iit_param;
+	struct super_block *sb = param->sb;
+	ldiskfs_fsblk_t itable;
+	__u32 ipb, cur, last;
+
+	if (lfu_ra_blocks == 0)
+		return;
+
+	ipb = sb->s_blocksize / LDISKFS_INODE_SIZE(sb);
+	if (unlikely(ipb == 0))
+		return;
+
+	/* block index of @pos within this group's inode table */
+	cur = (pos - param->gbase) / ipb;
+	last = LDISKFS_INODES_PER_GROUP(sb) / ipb;
+
+	if (it->ooi_ra_bg != param->bg + 1) {
+		/* new group: restart the cursor here.  +1 so that a zeroed
+		 * iterator does not look like "already done group 0". */
+		it->ooi_ra_bg = param->bg + 1;
+		it->ooi_ra_next = cur;
+	}
+
+	/* ldiskfs_inode_table() is not exported by the ldiskfs module, so read
+	 * the group descriptor directly -- this is that function's body. */
+	itable = le32_to_cpu(desc->bg_inode_table_lo);
+	if (LDISKFS_DESC_SIZE(sb) >= LDISKFS_MIN_DESC_SIZE_64BIT)
+		itable |= (ldiskfs_fsblk_t)
+			  le32_to_cpu(desc->bg_inode_table_hi) << 32;
+	while (it->ooi_ra_next < cur + lfu_ra_blocks &&
+	       it->ooi_ra_next < last) {
+		sb_breadahead(sb, itable + it->ooi_ra_next);
+		it->ooi_ra_next++;
+	}
+}
