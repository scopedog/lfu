+/**
+ * osd_otable_it_xattr() - DORA_XATTR: one xattr of the current object
+ * @env: the thread context
+ * @it: the iterator, positioned on the object rec() describes
+ * @dox: the request; see struct dt_otable_xattr
+ *
+ * Two places an xattr can be on osd-zfs, tried cheapest first:
+ *
+ *  1. The SA xattr nvlist (SA_ZPL_DXATTR).  it::next already unpacked it to
+ *     find the LMA, and with DOIF_ATTR it is kept until the next it::next; a
+ *     lookup in it costs no I/O and no dnode hold.  This is the tier-1 read
+ *     of the filter model, and it is where trusted.som, trusted.lov,
+ *     trusted.lmv and trusted.link normally are -- osd_xattr_set() prefers
+ *     the SA area for anything up to DXATTR_MAX_SA_SIZE.
+ *  2. The xattr directory ZAP (SA_ZPL_XATTR), for values that did not fit:
+ *     a ZAP lookup, a dnode hold and a dmu_read() per value, through the same
+ *     __osd_xattr_get_large() the object path uses.  This is tier 2, and it is
+ *     counted as such.
+ *
+ * "Not in the SA area and no xattr directory" is a definite -ENODATA and
+ * costs nothing beyond the walk, exactly as "not in the inode and no external
+ * block" is on osd-ldiskfs.
+ *
+ * Only served alongside DOIF_ATTR, because that is when it::next holds the SA
+ * handle long enough to read the directory number and keeps the nvlist;
+ * without it the answer is -EOPNOTSUPP, as before.
+ *
+ * Return: value length (>= 0), or negative errno per struct dt_otable_xattr.
+ */
+static int osd_otable_it_xattr(const struct lu_env *env,
+			       struct osd_otable_it *it,
+			       struct dt_otable_xattr *dox)
+{
+	struct lu_buf lb;
+	uchar_t *val;
+	uint_t vlen = 0;
+	int size = 0;
+	int rc;
+
+	ENTRY;
+
+	if (unlikely(dox->dox_name == NULL || dox->dox_buf == NULL))
+		RETURN(-EINVAL);
+	dox->dox_len = 0;
+	dox->dox_where = DOX_NONE;
+
+	if (!it->ooi_want_attr || it->ooi_nvbuf == NULL)
+		RETURN(-EOPNOTSUPP);
+
+	/* 1. the SA area, already in memory */
+	rc = -nvlist_lookup_byte_array(it->ooi_nvbuf, dox->dox_name, &val,
+				       &vlen);
+	if (rc == 0) {
+		it->ooi_st_xa_inline++;
+		dox->dox_len = vlen;
+		dox->dox_where = DOX_INLINE;
+		if (vlen > dox->dox_buflen)
+			RETURN(-ERANGE);
+		memcpy(dox->dox_buf, val, vlen);
+		RETURN(vlen);
+	}
+	if (rc != -ENOENT)
+		RETURN(rc);
+
+	/* Not in the SA area and nowhere else to look: a definite answer,
+	 * and a free one. */
+	if (it->ooi_xattr == ZFS_NO_OBJECT)
+		RETURN(-ENODATA);
+
+	/* 2. the xattr directory */
+	lb.lb_buf = dox->dox_buf;
+	lb.lb_len = dox->dox_buflen;
+	rc = __osd_xattr_get_large(env, it->ooi_dev, it->ooi_xattr, &lb,
+				   dox->dox_name, &size);
+	if (rc == -ENOENT)
+		RETURN(-ENODATA);
+	if (rc != 0 && rc != -ERANGE)
+		RETURN(rc);
+
+	it->ooi_st_xa_ext++;
+	dox->dox_len = size;
+	dox->dox_where = DOX_EXTERNAL;
+	RETURN(rc == -ERANGE ? -ERANGE : size);
+}
