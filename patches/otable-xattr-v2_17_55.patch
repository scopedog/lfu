diff --git a/lustre/include/dt_object.h b/lustre/include/dt_object.h
index 7502d99614..bf50d491d6 100644
--- a/lustre/include/dt_object.h
+++ b/lustre/include/dt_object.h
@@ -1881,6 +1881,61 @@ struct dt_otable_rec {
 	struct lu_attr	dor_attr;
 };
 
+/*
+ * rec() attr bit requesting one extended attribute of the current object,
+ * described by struct dt_otable_xattr in place of the record (LFU).
+ *
+ * This is the tier-1 read of the filter cost model: it exists so that a
+ * kernel-side filter can ask for trusted.som, trusted.lov, trusted.lmv or
+ * trusted.link *after* the tier-0 predicates have passed, and get the bytes
+ * from wherever the iterator already has the object -- the mapped inode-table
+ * block on a block-parsing ldiskfs iterator, at no I/O -- rather than through
+ * a dt_locate() + dt_xattr_get() pair, which is an OI lookup and an iget per
+ * object and would give back everything block parsing took away.
+ *
+ * Return value of rec(): the value's length in bytes on success (>= 0), or
+ *   -ENODATA     the object has no such attribute
+ *   -ERANGE      it exists but does not fit dox_buflen; dox_len holds its size
+ *   -EOPNOTSUPP  this OSD's iterator does not implement DORA_XATTR
+ *   other negative errors
+ *
+ * dox_where reports where the bytes came from, so a caller can count the
+ * tier-2 rate rather than guess at it.
+ */
+#define DORA_XATTR 0x02
+
+enum dt_otable_xattr_where {
+	DOX_NONE = 0,
+	DOX_INLINE,	/* the in-inode area of the mapped block: tier 1 */
+	DOX_EXTERNAL,	/* an external xattr block via iget: tier 2 */
+	DOX_IGET,	/* through a live inode; the iterator held no block */
+};
+
+struct dt_otable_xattr {
+	const char	*dox_name;	/* full name, e.g. XATTR_NAME_SOM */
+	void		*dox_buf;	/* caller's buffer */
+	__u32		 dox_buflen;	/* its size */
+	__u32		 dox_len;	/* [out] value size, also on -ERANGE */
+	__u32		 dox_where;	/* [out] enum dt_otable_xattr_where */
+};
+
+/*
+ * rec() attr bit requesting the iterator's own counters, in struct
+ * dt_otable_stats in place of the record (LFU).  How often the block parser
+ * had to fall back to iget, and how often a DORA_XATTR read went outside the
+ * inode, are the two numbers that decide whether the tier model holds on a
+ * given filesystem; nothing else can see them.
+ */
+#define DORA_STATS 0x04
+
+struct dt_otable_stats {
+	__u64	dos_raw;	/* objects decoded from the raw inode table */
+	__u64	dos_fallback;	/* objects the raw parse declined (-EAGAIN) */
+	__u64	dos_xa_inline;	/* DORA_XATTR served from the in-inode area */
+	__u64	dos_xa_ext;	/* DORA_XATTR that needed the external block */
+	__u64	dos_xa_iget;	/* DORA_XATTR served through a live inode */
+};
+
 /*
  * otable based iteration needs to use the common DT iteration APIs.
  * To initialize the iteration, it needs call dio_it::init() firstly.
diff --git a/lustre/osd-ldiskfs/osd_internal.h b/lustre/osd-ldiskfs/osd_internal.h
