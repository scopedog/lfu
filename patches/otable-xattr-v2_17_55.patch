+/**
+ * osd_otable_it_xattr() - DORA_XATTR: one xattr of the current object
+ * @env: the thread context
+ * @it: the iterator, positioned on the object rec() describes
+ * @dox: the request; see struct dt_otable_xattr
+ *
+ * Three ways to reach the bytes, tried cheapest first:
+ *
+ *  1. The in-inode area of the inode-table block a block-parsing private
+ *     iterator still holds in ooi_bp_bh.  No I/O, no inode: this is the tier-1
+ *     read of the filter model, and on an MDT formatted by mkfs.lustre it is
+ *     where LMA, LOV, SOM and linkea normally are.
+ *  2. If the attribute is not there but the raw inode has an external xattr
+ *     block (i_file_acl), a real inode is taken and __osd_xattr_get() follows
+ *     the block.  This is tier 2 -- one extra read -- and is counted as such.
+ *  3. Without a held block (the singleton iterator, or a block-parse fallback
+ *     that already went through iget), the same __osd_xattr_get() on a live
+ *     inode.  Counted separately: it is not a tier-2 event, it is the price of
+ *     not block parsing.
+ *
+ * "Not in the inode and no external block" is a definite -ENODATA and costs
+ * nothing beyond the walk: an unstriped file has no trusted.lov, a file never
+ * closed since SOM was enabled has no trusted.som, and neither must cost an
+ * iget to find out.
+ *
+ * Return: value length (>= 0), or negative errno per struct dt_otable_xattr.
+ */
+static int osd_otable_it_xattr(const struct lu_env *env,
+			       struct osd_otable_it *it,
+			       struct dt_otable_xattr *dox)
+{
+	struct osd_thread_info *info = osd_oti_get(env);
+	struct osd_device *dev = it->ooi_dev;
+	struct osd_otable_cache *ooc = &it->ooi_cache;
+	struct osd_iit_param *param = &it->ooi_iit_param;
+	struct osd_inode_id *lid;
+	struct inode *inode;
+	const char *name;
+	__u32 where = DOX_IGET;
+	int rc;
+
+	ENTRY;
+
+	if (unlikely(dox->dox_name == NULL || dox->dox_buf == NULL))
+		RETURN(-EINVAL);
+	dox->dox_len = 0;
+	dox->dox_where = DOX_NONE;
+
+	if (unlikely(ooc->ooc_consumer_idx < 0))
+		RETURN(-ENOENT);
+	lid = &ooc->ooc_cache[ooc->ooc_consumer_idx].oic_lid;
+
+	/* Only the "trusted." namespace is reachable from the raw inode area
+	 * by index; anything else goes through the inode. */
+	name = dox->dox_name;
+	if (strncmp(name, XATTR_TRUSTED_PREFIX,
+		    sizeof(XATTR_TRUSTED_PREFIX) - 1) == 0)
+		name += sizeof(XATTR_TRUSTED_PREFIX) - 1;
+	else
+		name = NULL;
+
+	/* 1. the held inode-table block */
+	if (it->ooi_private && it->ooi_bp_bh != NULL && name != NULL &&
+	    strlen(name) <= 255 && lid->oii_ino >= param->gbase) {
+		struct super_block *sb = param->sb;
+		struct ldiskfs_group_desc *desc;
+		__u32 isize = LDISKFS_INODE_SIZE(sb);
+		__u32 ipb = sb->s_blocksize / isize;
+		__u32 index = lid->oii_ino - param->gbase;
+
+		desc = ldiskfs_get_group_desc(sb, param->bg, NULL);
+		if (desc != NULL && ipb != 0 &&
+		    index < LDISKFS_INODES_PER_GROUP(sb) &&
+		    osd_group_itable(sb, desc) + index / ipb == it->ooi_bp_blk) {
+			struct ldiskfs_inode *raw;
+			const void *val;
+			__u32 vlen;
+
+			raw = (struct ldiskfs_inode *)
+			      (it->ooi_bp_bh->b_data + (index % ipb) * isize);
+			rc = osd_raw_xattr(sb, raw, LFU_XATTR_INDEX_TRUSTED,
+					   name, (__u8)strlen(name),
+					   &val, &vlen);
+			if (rc == 0) {
+				it->ooi_st_xa_inline++;
+				dox->dox_len = vlen;
+				dox->dox_where = DOX_INLINE;
+				if (vlen > dox->dox_buflen)
+					RETURN(-ERANGE);
+				memcpy(dox->dox_buf, val, vlen);
+				RETURN(vlen);
+			}
+			/* Not in the inode and nowhere else to look: a
+			 * definite answer, and a free one. */
+			if (rc == -ENODATA && raw->i_file_acl_lo == 0 &&
+			    raw->osd2.linux2.l_i_file_acl_high == 0)
+				RETURN(-ENODATA);
+			/* 2. an external block, or an ea_inode value */
+			where = DOX_EXTERNAL;
+		}
+	}
+
+	/* 2./3. through a live inode */
+	inode = osd_iget(info, dev, lid, LDISKFS_IGET_NO_CHECKS);
+	if (IS_ERR(inode))
+		RETURN(PTR_ERR(inode));
+
+	rc = __osd_xattr_get(inode, &info->oti_obj_dentry, dox->dox_name,
+			     dox->dox_buf, dox->dox_buflen);
+	if (rc == -ERANGE) {
+		/* size probe, so the caller can say how big it was */
+		int sz = __osd_xattr_get(inode, &info->oti_obj_dentry,
+					 dox->dox_name, NULL, 0);
+
+		dox->dox_len = sz > 0 ? sz : 0;
+	} else if (rc >= 0) {
+		dox->dox_len = rc;
+	}
+	iput(inode);
+
+	if (rc >= 0 || rc == -ERANGE) {
+		dox->dox_where = where;
+		if (where == DOX_EXTERNAL)
+			it->ooi_st_xa_ext++;
+		else
+			it->ooi_st_xa_iget++;
+	}
+	if (rc == 0)
+		rc = -ENODATA;	/* __vfs_getxattr: 0 bytes means absent */
+
+	RETURN(rc);
+}
