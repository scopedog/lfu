 {
 	struct osd_otable_it    *it  = (struct osd_otable_it *)di;
 	struct osd_otable_cache *ooc = &it->ooi_cache;
 
+	/* Two requests that are not the record at all (LFU) */
+	if (attr & DORA_XATTR)
+		return osd_otable_it_xattr(env, it, (struct dt_otable_xattr *)rec);
+	if (attr & DORA_STATS) {
+		struct dt_otable_stats *dos = (struct dt_otable_stats *)rec;
+
+		dos->dos_raw = it->ooi_st_raw;
+		dos->dos_fallback = it->ooi_st_fallback;
+		dos->dos_xa_inline = it->ooi_st_xa_inline;
+		dos->dos_xa_ext = it->ooi_st_xa_ext;
+		dos->dos_xa_iget = it->ooi_st_xa_iget;
+		return 0;
+	}
+
 	if ((attr & DORA_ATTR) && it->ooi_want_attr) {
 		struct dt_otable_rec *dor = (struct dt_otable_rec *)rec;
 
