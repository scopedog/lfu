+/**
+ * osd_otable_it_next_private() - advance a DOIF_PARALLEL iterator
+ * @env: pointer to the thread context
+ * @it: the private iterator
+ *
+ * The inode-table walk of osd_inode_iteration() without its two couplings:
+ * no 64-entry preload cache handed to a separate consumer, and no scrub
+ * thread pacing.  The same osd_iit_next()/osd_iit_iget() primitives run
+ * inline, so the objects returned -- and their attributes under DOIF_ATTR --
+ * are exactly those the otable iterator would return.  Every piece of walk
+ * state lives in it->ooi_iit_param, which is what lets N instances walk N
+ * inode ranges concurrently; the group bitmap is kept across calls and
+ * released on group change and in fini().
+ *
+ * Return:
+ * * %0 positioned on the next object (rec() and store() describe it)
+ * * %1 end of the inode table
+ * * %negative on error
+ */
+static int osd_otable_it_next_private(const struct lu_env *env,
+				      struct osd_otable_it *it)
+{
+	struct osd_device *dev = it->ooi_dev;
+	struct osd_thread_info *info = osd_oti_get(env);
+	struct osd_otable_cache *ooc = &it->ooi_cache;
+	struct osd_iit_param *param = &it->ooi_iit_param;
+	__u64 *pos = &ooc->ooc_pos_preload;
+	__u32 limit;
+	int rc;
+	ENTRY;
+
+	limit = le32_to_cpu(LDISKFS_SB(param->sb)->s_es->s_inodes_count);
+	while (*pos <= limit) {
+		struct ldiskfs_group_desc *desc;
+
+		desc = ldiskfs_get_group_desc(param->sb, param->bg, NULL);
+		if (!desc)
+			GOTO(out, rc = -EIO);
+
+		if (desc->bg_flags & cpu_to_le16(LDISKFS_BG_INODE_UNINIT) ||
+		    param->offset +
+		    ldiskfs_itable_unused_count(param->sb, desc) >=
+		    LDISKFS_INODES_PER_GROUP(param->sb))
+			goto next_group;
+
+		if (param->bitmap == NULL) {
+			param->bitmap = ldiskfs_read_inode_bitmap(param->sb,
+								  param->bg);
+			if (IS_ERR_OR_NULL(param->bitmap)) {
+				rc = param->bitmap ? PTR_ERR(param->bitmap) :
+						     -EIO;
+				param->bitmap = NULL;
+				CERROR("%s: fail to read bitmap for %u, private iteration will stop: rc = %d\n",
+				       osd_dev2name(dev), (__u32)param->bg, rc);
+				GOTO(out, rc);
+			}
+		}
+
+		rc = osd_iit_next(param, pos);
+		if (rc == SCRUB_NEXT_BREAK)
+			goto next_group;
+
+		rc = osd_iit_iget(info, dev, &ooc->ooc_cache[0].oic_fid,
+				  &ooc->ooc_cache[0].oic_lid, *pos, param->sb,
+				  false,
+				  it->ooi_want_attr ? &ooc->ooc_attr[0] : NULL);
+		if (rc == 0)
+			RETURN(0);
+		if (rc < 0)
+			GOTO(out, rc);
+		/* SCRUB_NEXT_CONTINUE: not a visible Lustre object */
+		continue;
+
+next_group:
+		if (param->bitmap != NULL) {
+			brelse(param->bitmap);
+			param->bitmap = NULL;
+		}
+		param->bg++;
+		param->offset = 0;
+		param->gbase = 1 +
+			param->bg * LDISKFS_INODES_PER_GROUP(param->sb);
+		*pos = param->gbase;
+		param->start = *pos;
+	}
+
+	rc = 1;
+
+out:
+	if (param->bitmap != NULL) {
+		brelse(param->bitmap);
+		param->bitmap = NULL;
+	}
+
+	RETURN(rc);
+}
