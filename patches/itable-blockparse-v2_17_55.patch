+/* The in-inode extended attribute area, from fs/ext4/xattr.h.  That header is
+ * not part of the OSD's include set, and these are on-disk definitions that
+ * cannot change, so the three things needed to walk the area are repeated here
+ * rather than reaching into the ldiskfs build tree (LFU). */
+#define LFU_XATTR_MAGIC		0xEA020000
+#define LFU_XATTR_PAD		4
+#define LFU_XATTR_INDEX_TRUSTED	4
+
+struct lfu_xattr_entry {
+	__u8	e_name_len;
+	__u8	e_name_index;
+	__le16	e_value_offs;
+	__le32	e_value_inum;
+	__le32	e_value_size;
+	__le32	e_hash;
+	char	e_name[];
+};
+
+#define LFU_XATTR_LEN(nlen) \
+	(((nlen) + LFU_XATTR_PAD - 1 + sizeof(struct lfu_xattr_entry)) & \
+	 ~(LFU_XATTR_PAD - 1))
+
+/**
+ * osd_raw_xattr() - find one attribute in a raw inode's in-inode xattr area
+ * @sb: the ldiskfs super block
+ * @raw: the on-disk inode, inside a mapped inode-table block
+ * @index: the ldiskfs name index (LFU_XATTR_INDEX_TRUSTED for "trusted.")
+ * @name: the name without its prefix, e.g. "lma", "som", "lov"
+ * @nlen: strlen(@name)
+ * @val: set to point at the value, inside the same mapped block [out]
+ * @vlen: set to the value's length [out]
+ *
+ * ldiskfs stores small extended attributes in the space between the end of the
+ * 128-byte "good old" inode and the end of the inode record.  Every Lustre
+ * xattr mkfs.lustre sizes the inode for -- LMA, LOV, SOM, linkea -- normally
+ * lives here, which is what lets a FID, a size or a layout be read out of the
+ * same inode-table block the attributes come from, with no second I/O and no
+ * inode allocation.  This is tier 1 of the filter cost model (LFU).
+ *
+ * The value is returned by reference into the caller's mapped block, so it is
+ * valid only for as long as that buffer_head is held.  Nothing is copied here;
+ * what to do with the bytes is the caller's business.
+ *
+ * Return:
+ * * %0 found, @val/@vlen describe it
+ * * %-ENODATA not present in the in-inode area (it may be in an external
+ *   block -- test i_file_acl -- or absent entirely)
+ * * %-EOPNOTSUPP present but not usable here (value in an ea_inode, or an
+ *   entry that does not fit the record)
+ */
+static int osd_raw_xattr(struct super_block *sb, struct ldiskfs_inode *raw,
+			 __u8 index, const char *name, __u8 nlen,
+			 const void **val, __u32 *vlen)
+{
+	struct lfu_xattr_entry *entry;
+	char *ibody, *first, *end;
+	__u32 isize = LDISKFS_INODE_SIZE(sb);
+	__u16 extra;
+
+	if (isize <= LDISKFS_GOOD_OLD_INODE_SIZE)
+		return -ENODATA;
+
+	extra = le16_to_cpu(raw->i_extra_isize);
+	/* i_extra_isize is the size of the extension the kernel wrote; the
+	 * xattr area starts after it.  Reject anything that would put the
+	 * header outside the inode record. */
+	if (extra & 3 || LDISKFS_GOOD_OLD_INODE_SIZE + extra + sizeof(__le32) >
+			 isize)
+		return -EOPNOTSUPP;
+
+	ibody = (char *)raw + LDISKFS_GOOD_OLD_INODE_SIZE + extra;
+	if (le32_to_cpu(*(__le32 *)ibody) != LFU_XATTR_MAGIC)
+		return -ENODATA;
+
+	first = ibody + sizeof(__le32);
+	end = (char *)raw + isize;
+
+	for (entry = (struct lfu_xattr_entry *)first;
+	     (char *)entry + sizeof(*entry) <= end;
+	     entry = (struct lfu_xattr_entry *)
+		     ((char *)entry + LFU_XATTR_LEN(entry->e_name_len))) {
+		__u32 vsize, voffs;
+
+		/* a zeroed name_len/name_index/value_offs is the terminator */
+		if (*(__le32 *)entry == 0)
+			return -ENODATA;
+
+		if (entry->e_name_index != index ||
+		    entry->e_name_len != nlen ||
+		    (char *)entry + LFU_XATTR_LEN(nlen) > end ||
+		    memcmp(entry->e_name, name, nlen) != 0)
+			continue;
+
+		/* e_value_inum != 0 means the value lives in a separate inode
+		 * (ea_inode feature); not worth handling on this path. */
+		if (entry->e_value_inum != 0)
+			return -EOPNOTSUPP;
+
+		vsize = le32_to_cpu(entry->e_value_size);
+		voffs = le16_to_cpu(entry->e_value_offs);
+		if (first + voffs + vsize > end || first + voffs < first)
+			return -EOPNOTSUPP;
+
+		*val = first + voffs;
+		*vlen = vsize;
+		return 0;
+	}
+
+	return -ENODATA;
+}
+
+/**
+ * osd_raw_lma() - find trusted.lma in a raw inode's in-inode xattr area
+ * @sb: the ldiskfs super block
+ * @raw: the on-disk inode, inside a mapped inode-table block
+ * @loa: filled with the swabbed LMA on success
+ *
+ * trusted.lma is 24-48 bytes and is written when the object is created, so on
+ * an MDT it is essentially always in the inode.  When it is not (attribute
+ * moved to an external xattr block, or absent entirely) the caller falls back
+ * to the iget path, which also knows how to synthesise IGIF and IDIF FIDs.
+ *
+ * Return:
+ * * %0 found, @loa is valid
+ * * %-ENODATA not present in the in-inode area
+ * * %-EOPNOTSUPP present but not usable (bad magic, truncated, unsupported)
+ */
+static int osd_raw_lma(struct super_block *sb, struct ldiskfs_inode *raw,
+		       struct lustre_ost_attrs *loa)
+{
+	const void *val;
+	__u32 vlen;
+	int rc;
+
+	rc = osd_raw_xattr(sb, raw, LFU_XATTR_INDEX_TRUSTED, "lma", 3,
+			   &val, &vlen);
+	if (rc != 0)
+		return rc;
+
+	if (vlen < sizeof(struct lustre_mdt_attrs))
+		return -EOPNOTSUPP;
+
+	memset(loa, 0, sizeof(*loa));
+	memcpy(loa, val, min_t(__u32, vlen, sizeof(*loa)));
+	lustre_loa_swab(loa, true);
+	if (loa->loa_lma.lma_incompat & ~LMA_INCOMPAT_SUPP)
+		return -EOPNOTSUPP;
+
+	return 0;
+}
+
+/**
+ * osd_raw_attr() - fill a lu_attr from a raw on-disk inode
+ * @sb: the ldiskfs super block
+ * @raw: the on-disk inode
+ * @lma_incompat: the object's LMA incompat flags, for the orphan and
+ *                encrypted bits that live there rather than in i_flags
+ * @la: filled with exactly the fields the iget path reports
+ *
+ * The same conversions ldiskfs_iget() performs when it populates struct inode,
+ * for the fields DOIF_ATTR reports, plus the three osd_inode_getattr() adds on
+ * top -- crtime, projid and the flag word -- so that every tier-0 predicate of
+ * the filter model is answerable from the raw inode.  Kept field-for-field
+ * identical to the iget path so that a checksum over the attributes of a whole
+ * device matches between the two (LFU).
+ */
+static void osd_raw_attr(struct super_block *sb, struct ldiskfs_inode *raw,
+			 __u32 lma_incompat, struct lu_attr *la)
+{
+	__u64 blocks;
+	__u32 extra = le16_to_cpu(raw->i_extra_isize);
+
+	la->la_valid = LA_MODE | LA_NLINK | LA_UID | LA_GID | LA_SIZE |
+		       LA_BLOCKS | LA_ATIME | LA_MTIME | LA_CTIME |
+		       LA_BTIME | LA_PROJID | LA_FLAGS;
+	la->la_mode = le16_to_cpu(raw->i_mode);
+	la->la_nlink = le16_to_cpu(raw->i_links_count);
+	la->la_uid = le16_to_cpu(raw->i_uid) |
+		     ((__u32)le16_to_cpu(raw->osd2.linux2.l_i_uid_high) << 16);
+	la->la_gid = le16_to_cpu(raw->i_gid) |
+		     ((__u32)le16_to_cpu(raw->osd2.linux2.l_i_gid_high) << 16);
+	la->la_size = le32_to_cpu(raw->i_size_lo) |
+		      ((__u64)le32_to_cpu(raw->i_size_high) << 32);
+
+	/* i_blocks is in 512-byte units unless HUGE_FILE_FL says the on-disk
+	 * value counts file system blocks -- ldiskfs_inode_blocks(). */
+	blocks = le32_to_cpu(raw->i_blocks_lo);
+	if (ldiskfs_has_feature_huge_file(sb)) {
+		blocks |= ((__u64)le16_to_cpu(
+				raw->osd2.linux2.l_i_blocks_high)) << 32;
+		if (le32_to_cpu(raw->i_flags) & LDISKFS_HUGE_FILE_FL)
+			blocks <<= (sb->s_blocksize_bits - 9);
+	}
+	la->la_blocks = blocks;
+
+	la->la_atime = (__s64)le32_to_cpu(raw->i_atime);
+	la->la_mtime = (__s64)le32_to_cpu(raw->i_mtime);
+	la->la_ctime = (__s64)le32_to_cpu(raw->i_ctime);
+
+	/* post-2038 timestamps carry two epoch bits in the *_extra fields --
+	 * ldiskfs_decode_extra_time().  Only present in a large inode whose
+	 * extension actually reaches that far. */
+#define LFU_HAS_EXTRA(field) \
+	(LDISKFS_GOOD_OLD_INODE_SIZE + extra >= \
+	 offsetof(struct ldiskfs_inode, field) + sizeof(__le32))
+	if (LFU_HAS_EXTRA(i_atime_extra))
+		la->la_atime |= (__s64)(le32_to_cpu(raw->i_atime_extra) & 3)
+				<< 32;
+	if (LFU_HAS_EXTRA(i_mtime_extra))
+		la->la_mtime |= (__s64)(le32_to_cpu(raw->i_mtime_extra) & 3)
+				<< 32;
+	if (LFU_HAS_EXTRA(i_ctime_extra))
+		la->la_ctime |= (__s64)(le32_to_cpu(raw->i_ctime_extra) & 3)
+				<< 32;
+
+	/* crtime and projid are entirely in the extension, so they exist only
+	 * if the extension reaches them; a smaller one means 0, which is what
+	 * ldiskfs_iget() leaves in the inode too. */
+	la->la_btime = 0;
+	if (LFU_HAS_EXTRA(i_crtime))
+		la->la_btime = (__s64)le32_to_cpu(raw->i_crtime);
+	if (LFU_HAS_EXTRA(i_crtime_extra))
+		la->la_btime |= (__s64)(le32_to_cpu(raw->i_crtime_extra) & 3)
+				<< 32;
+	la->la_projid = 0;
+	if (ldiskfs_has_feature_project(sb) && LFU_HAS_EXTRA(i_projid))
+		la->la_projid = le32_to_cpu(raw->i_projid);
+#undef LFU_HAS_EXTRA
+
+	/* The flag word osd_inode_getattr() reports: the on-disk bits Lustre
+	 * shows users, plus the two that are kept in the LMA rather than in
+	 * i_flags.  LUSTRE_*_FL values coincide with the ldiskfs ones for the
+	 * on-disk bits, which is what makes the mask a plain AND. */
+	la->la_flags = (le32_to_cpu(raw->i_flags) & LUSTRE_FL_USER_VISIBLE) |
+		       lma_to_lustre_flags(lma_incompat);
+}
+
+/**
+ * osd_iit_iget_raw() - return one object by parsing the inode-table block
+ * @info: thread environment
+ * @dev: the OSD device
+ * @it: the private iterator, which caches the mapped block
+ * @desc: group descriptor of the group being walked
+ * @fid: filled with the object's FID
+ * @lid: filled with the object's inode id
+ * @pos: inode number to return
+ * @la: filled with the object's attributes, or NULL if not wanted
+ *
+ * The alternative to osd_iit_iget(), which reaches each inode through
+ * osd_iget() -> ldiskfs_iget() and therefore pays iget_locked() -- an
+ * allocation and a walk of the kernel-wide inode hash under inode_hash_lock --
+ * plus one dependent 4 KiB read per inode-table block.  Here the block is
+ * mapped once and every inode in it is read out of that mapping: at a 1 KiB
+ * inode size that is one buffer for four objects, and no struct inode at all.
+ *
+ * This is what the userspace device scanner does, and it is the reason it
+ * saturates a device with a single thread.  Anything this path cannot decode
+ * -- no in-inode LMA, an external xattr block, an unsupported LMA -- returns
+ * -EAGAIN and the caller repeats the object through osd_iit_iget(), so the
+ * object set is identical either way (LFU).
+ *
+ * One thing is deliberately not done here: ldiskfs_iget() verifies the inode's
+ * metadata checksum and this does not, so a corrupt inode is reported rather
+ * than refused.  That is the right trade for a scanner whose consumer treats
+ * the result as a hint and re-reads the object before acting on it, and the
+ * wrong one for anything that trusts the attributes; a caller that needs the
+ * check should use the iget path.
+ *
+ * Return:
+ * * %0 @fid, @lid and @la describe the object at @pos
+ * * %SCRUB_NEXT_CONTINUE not a visible Lustre object, skip it
+ * * %-EAGAIN cannot be decoded from the raw inode, use the iget path
+ * * %negative on error
+ */
+static int osd_iit_iget_raw(struct osd_thread_info *info,
+			    struct osd_device *dev, struct osd_otable_it *it,
+			    struct ldiskfs_group_desc *desc,
+			    struct lu_fid *fid, struct osd_inode_id *lid,
+			    __u32 pos, struct lu_attr *la)
+{
+	struct lustre_ost_attrs *loa = &info->oti_ost_attrs;
+	struct lustre_mdt_attrs *lma = &loa->loa_lma;
+	struct osd_iit_param *param = &it->ooi_iit_param;
+	struct super_block *sb = param->sb;
+	struct ldiskfs_inode *raw;
+	ldiskfs_fsblk_t blk;
+	__u32 isize = LDISKFS_INODE_SIZE(sb);
+	__u32 ipb = sb->s_blocksize / isize;
+	__u32 index, off;
+	int rc;
+
+	ENTRY;
+
+	if (unlikely(ipb == 0))
+		RETURN(-EAGAIN);
+
+	/* Same two objects osd_iit_iget() declines to handle: they are neither
+	 * visible to the namespace nor have OI mappings. */
+	if (unlikely(pos == osd_sb(dev)->s_root->d_inode->i_ino ||
+		     is_remote_parent_ino(dev, pos)))
+		RETURN(SCRUB_NEXT_CONTINUE);
+
+	if (ldiskfs_has_feature_project(sb) &&
+	    pos == le32_to_cpu(LDISKFS_SB(sb)->s_es->s_prj_quota_inum))
+		RETURN(SCRUB_NEXT_CONTINUE);
+
+	if (unlikely(pos < param->gbase))
+		RETURN(-EAGAIN);
+	index = pos - param->gbase;
+	if (unlikely(index >= LDISKFS_INODES_PER_GROUP(sb)))
+		RETURN(-EAGAIN);
+
+	blk = osd_group_itable(sb, desc) + index / ipb;
+	off = (index % ipb) * isize;
+
+	if (it->ooi_bp_blk != blk) {
+		struct buffer_head *bh;
+
+		bh = sb_bread(sb, blk);
+		if (bh == NULL) {
+			CDEBUG(D_LFSCK,
+			       "%s: fail to read inode table block %llu for ino %u\n",
+			       osd_dev2name(dev), (unsigned long long)blk, pos);
+			RETURN(-EIO);
+		}
+		if (it->ooi_bp_bh != NULL)
+			brelse(it->ooi_bp_bh);
+		it->ooi_bp_bh = bh;
+		it->ooi_bp_blk = blk;
+	}
+
+	raw = (struct ldiskfs_inode *)(it->ooi_bp_bh->b_data + off);
+
+	/* The bitmap said this inode is allocated, but it may have been freed
+	 * since, or not yet initialised.  This is ldiskfs_iget()'s own rule for
+	 * -ESTALE, which osd_iit_iget() turns into a skip: an unlinked inode is
+	 * only real if it still has a mode and a deletion time, which is the
+	 * orphan-recovery case.  Note that unlike ldiskfs_iget() this path does
+	 * not verify the inode checksum. */
+	if (le16_to_cpu(raw->i_links_count) == 0 &&
+	    (raw->i_mode == 0 || raw->i_dtime == 0))
+		RETURN(SCRUB_NEXT_CONTINUE);
+
+	/* An attribute is never in both places, so an in-inode hit is
+	 * authoritative even when the inode also has an external xattr block:
+	 * that is the common shape on an MDT, where a wide-striped file pushes
+	 * trusted.lov out of the inode and leaves trusted.lma in it.  Only when
+	 * the in-inode area does not have it does the external block matter,
