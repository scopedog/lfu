+/* ldiskfs_inode_table() is not exported by the ldiskfs module, so read the
+ * group descriptor directly -- this is that function's body (LFU). */
+static inline ldiskfs_fsblk_t osd_group_itable(struct super_block *sb,
+					       struct ldiskfs_group_desc *desc)
+{
+	ldiskfs_fsblk_t itable = le32_to_cpu(desc->bg_inode_table_lo);
+
+	if (LDISKFS_DESC_SIZE(sb) >= LDISKFS_MIN_DESC_SIZE_64BIT)
+		itable |= (ldiskfs_fsblk_t)
+			  le32_to_cpu(desc->bg_inode_table_hi) << 32;
+
+	return itable;
+}
+
 static void osd_itable_readahead(struct osd_otable_it *it,
 				 struct ldiskfs_group_desc *desc, __u32 pos)
 {
 	struct osd_iit_param *param = &it->ooi_iit_param;
 	struct super_block *sb = param->sb;
 	ldiskfs_fsblk_t itable;
+	struct blk_plug plug;
 	__u32 ipb, cur, last;
 
 	if (lfu_ra_blocks == 0)
@@ -2992,17 +3030,411 @@ static void osd_itable_readahead(struct osd_otable_it *it,
 		it->ooi_ra_next = cur;
 	}
 
-	/* ldiskfs_inode_table() is not exported by the ldiskfs module, so read
-	 * the group descriptor directly -- this is that function's body. */
-	itable = le32_to_cpu(desc->bg_inode_table_lo);
-	if (LDISKFS_DESC_SIZE(sb) >= LDISKFS_MIN_DESC_SIZE_64BIT)
-		itable |= (ldiskfs_fsblk_t)
-			  le32_to_cpu(desc->bg_inode_table_hi) << 32;
+	itable = osd_group_itable(sb, desc);
+	if (it->ooi_ra_next >= cur + lfu_ra_blocks || it->ooi_ra_next >= last)
+		return;
+
+	/* Plugged only because __ldiskfs_get_inode_loc() plugs its own 32-block
+	 * window; it was never shown to help.  What sets the cold rate is how
+	 * far the window reaches -- queue depth, not request size: at ra=64 on
+	 * one thread, plugged gave 594,180 obj/s against 666,026 unplugged. */
+	blk_start_plug(&plug);
 	while (it->ooi_ra_next < cur + lfu_ra_blocks &&
 	       it->ooi_ra_next < last) {
 		sb_breadahead(sb, itable + it->ooi_ra_next);
 		it->ooi_ra_next++;
 	}
+	blk_finish_plug(&plug);
+}
