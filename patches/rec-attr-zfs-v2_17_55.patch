+	if (blksize == 0)
+		blksize = o->od_max_blksz;
+	la->la_blksize = blksize;
+	la->la_blocks = blocks;
+	la->la_valid |= LA_BLOCKS | LA_BLKSIZE;
+
+	RETURN(0);
+}
