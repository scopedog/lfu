+	 * acted, and that arrives as lfsr_event_uid, so the owner the lookup
+	 * found is the one -uid matches and nothing here overwrites it.
+	 */
+	if (cl->lfsr_valid & LLAPI_SCAN_EVENT_UID) {
+		rec.lfsr_event_uid = cl->lfsr_event_uid;
+		rec.lfsr_event_gid = cl->lfsr_event_gid;
+	}
