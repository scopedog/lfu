diff --git a/config/lustre-build-zfs.m4 b/config/lustre-build-zfs.m4
index 52785bc1cd..1b70470c3b 100644
--- a/config/lustre-build-zfs.m4
+++ b/config/lustre-build-zfs.m4
@@ -221,6 +221,93 @@ AC_DEFUN([LB_ZFS_USER], [
 	AC_SUBST(ZFS_LIBZFS_INCLUDE)
 	AC_SUBST(ZFS_LIBZFS_LDFLAGS)
 	AC_SUBST(ZFS_LIBZFS_LIBS)
+
+	#
+	# The scan backend needs the DMU headers, not just libzfs.h, and
+	# reaching them takes more than ZFS_LIBZFS_INCLUDE does.  libzpool is
+	# the kernel DMU compiled for userspace, so it wants the os/linux/zfs
+	# headers and LIB_ZPOOL_BUILD, exactly as OpenZFS builds libzpool
+	# itself -- and it must NOT see os/linux/spl, whose sys/types.h
+	# collides with libspl's.  Which of these sets exists depends on
+	# whether zfs came from source, from DKMS, or from a devel package,
+	# and a directory test cannot tell a usable set from an unusable one:
+	# compile something and see.
+	#
+	AC_MSG_CHECKING([zfs libzpool headers usable from userspace])
+	ZFS_LIBZPOOL_INCLUDE=""
+	enable_zfs_scan="no"
+	zpool_saved_CPPFLAGS="$CPPFLAGS"
+	zpool_src_set=""
+	AS_IF([test -n "${zfssrc}" && test -d "${zfssrc}/include/os/linux/zfs"], [
+		zpool_src_set="-DLIB_ZPOOL_BUILD -I $zfssrc/lib/libspl/include -I $zfssrc/lib/libspl/include/os/linux -I $zfssrc/include -I $zfssrc/include/os/linux/zfs"
+	])
+	# $zfsinc from --with-zfs-devel has no libzpool directory and no
+	# -DLIB_ZPOOL_BUILD, so it cannot pass on its own: the packaged layout
+	# is spelled out here, under $zfsdevel when there is one.
+	zpool_pkg_set="-DLIB_ZPOOL_BUILD -I${zfsdevel}/usr/include/libspl -I${zfsdevel}/usr/include/libzfs -I${zfsdevel}/usr/include/libzpool"
+	# ZFS 2.3's sys/abd.h needs sys/abd_os.h, which installs only into the
+	# kernel header tree that $zfssrc names -- not into the devel headers.
+	zpool_kern_set=""
+	AS_IF([test -n "${zfssrc}" && test -d "${zfssrc}/include/sys"], [
+		zpool_kern_set="${zpool_pkg_set} -I ${zfssrc}/include"
+	])
+	for zpoolinc in "${zpool_src_set}" "${zpool_pkg_set}" "${zpool_kern_set}"; do
+		AS_IF([test -z "$zpoolinc"], [continue])
+		AS_IF([test "x$enable_zfs_scan" = "xno"], [
+			# the macros lustre/utils/Makefile.am gives libscan_zfs.c
+			CPPFLAGS="-D_GNU_SOURCE -D_LARGEFILE64_SOURCE=1 -D_FILE_OFFSET_BITS=64 $zpoolinc"
+			AC_COMPILE_IFELSE([AC_LANG_PROGRAM([[
+				/* as libscan_zfs.c does: libzpool's headers
+				 * name these without declaring them */
+				struct page;
+				struct bio;
+				#include <sys/zfs_context.h>
+				#include <sys/spa.h>
+				#include <sys/spa_impl.h>
+				#include <sys/arc_impl.h>
+				#include <sys/dmu.h>
+				#include <sys/dsl_prop.h>
+				#include <sys/zap.h>
+				#include <sys/sa.h>
+				#include <sys/dnode.h>
+				#include <sys/zfs_acl.h>
+				#include <sys/zfs_sa.h>
+				#include <sys/zfs_znode.h>
+				#include <sys/nvpair.h>
+				#include <libzutil.h>
+			]],[[
+				/* and name the API it calls, so that a header
