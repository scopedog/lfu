+/*
+ * The ZFS backend of llapi_scan_device(): an MDT's or OST's objects read
+ * out of the dataset with libzpool, the way zdb reads it, without the
+ * server.  The pool is held read-only; there is no write path here.
+ *
+ * What this file knows is the DMU and the ZPL's SA layout.  What an LMA
+ * means is liblustreapi's, on the other side of struct llapi_scan_sink.
+ *
+ * Author: Hiroshi Nishida <hnishida@thelustrecollective.com>
+ */
+
+/*
+ * A --with-zfs build defines _KERNEL in config.h for the kABI checks, and
+ * config.h is force-included ahead of this file.  The DMU headers switch on
+ * it, and this is userspace: libzpool provides the kernel emulation itself.
+ */
+#undef _KERNEL
+
+/*
+ * libzpool's abd_os.h names these in prototypes without declaring them, which
+ * this tree's -Werror will not have.  Declaring the tags first costs nothing
+ * and keeps -Werror on for our own code.
+ */
+struct page;
+struct bio;
+
+#include <sys/zfs_context.h>
+#include <sys/spa.h>
+#include <sys/spa_impl.h>
+#include <sys/arc_impl.h>
+#include <sys/dmu.h>
+#include <sys/dsl_prop.h>
+#include <sys/zap.h>
+#include <sys/sa.h>
+#include <sys/dnode.h>
+#include <sys/zfs_acl.h>
+#include <sys/zfs_sa.h>
+#include <sys/zfs_znode.h>
+#include <sys/nvpair.h>
+#include <libzutil.h>
+
+#include <ctype.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <linux/limits.h>
+#include <linux/stat.h>
+#include <linux/lustre/lustre_idl.h>
+
+#include "lustreapi_scan_backend.h"
+
+/* libzpool's FTAG expands to __func__, so an own and a disown in different
+ * functions would mismatch; one tag for everything here.
+ */
+static const char *scan_zfs_tag = "scan_zfs";
+
+/* Object ids per unit of work.  dnode allocation is sparse and clustered,
+ * so equal slices imbalance badly; chunks off a shared cursor do not.
+ */
+#define SCAN_CHUNK_OBJS		(64ULL * 1024)
+
+/* The whole id space, as <sys/dnode.h> defines it.  A worker that finds
+ * nothing at or beyond its chunk ends the scan for everyone, so this is a
+ * ceiling and not a count.
+ */
+#define SCAN_CHUNKS_MAX		(DN_MAX_OBJECT / SCAN_CHUNK_OBJS)
+
+static const char *const scan_zfs_xattr_name[LLAPI_SCAN_XA_MAX] = {
+	[LLAPI_SCAN_XA_LMA]	= XATTR_NAME_LMA,
+	[LLAPI_SCAN_XA_LOV]	= XATTR_NAME_LOV,
+	[LLAPI_SCAN_XA_LMV]	= XATTR_NAME_LMV,
+	[LLAPI_SCAN_XA_SOM]	= XATTR_NAME_SOM,
+	[LLAPI_SCAN_XA_LINK]	= XATTR_NAME_LINK,
+	[LLAPI_SCAN_XA_HSM]	= XATTR_NAME_HSM,
+};
+
+/* kernel_init() is process-global; scans may nest or repeat. */
+static pthread_mutex_t scan_zfs_lock = PTHREAD_MUTEX_INITIALIZER;
+static int scan_zfs_users;
+
+/* libzpool's, created by every kernel_init() and never deleted */
+extern uint_t rrw_tsd_key;
+
+/*
+ * kernel_fini(), and the thread-specific key kernel_init() created: left
+ * alone, each scan uses up one of the process's PTHREAD_KEYS_MAX, and a
+ * sweep of many ZFS targets runs out.  Called under scan_zfs_lock.
+ */
+static void scan_zfs_fini(void)
+{
+	kernel_fini();
+	pthread_key_delete((pthread_key_t)rrw_tsd_key);
+}
+
+struct scan_zfs_tgt {
+	objset_t	*zt_os;
+	sa_attr_type_t	*zt_atable;	/* per-dataset SA slots, never fixed */
+	uint64_t	 zt_unlinked;	/* ZFS_UNLINKED_SET zap, 0 if none */
+	char		 zt_pool[ZFS_MAX_DATASET_NAME_LEN];
+};
+
+struct scan_zfs_worker {
+	struct scan_zfs_tgt	*zw_tgt;
+	nvlist_t		*zw_nv;		/* this object's DXATTR */
+	void			*zw_bufs[LLAPI_SCAN_XA_MAX];
+	size_t			 zw_buflen[LLAPI_SCAN_XA_MAX];
+};
+
+/*
+ * Find the pool by reading vdev labels and import it into this process.
+ * Lustre creates its pools with cachefile=none, so the config cache that
+ * kernel_init() loads knows nothing and dmu_objset_own() says ENOENT; the
+ * pool has to be found the way zpool import and zdb -e find it.
+ *
+ * multihost=on is skipped (SPA_MODE_READ holds no write claim), which also
+ * skips ZFS's "someone else has this pool" guard -- so make that check here
+ * from the label, and refuse an ACTIVE pool.  Whether a quiesced imported
+ * pool can be read safely is exactly the open question on the ticket; until
+ * it is answered the honest response is EBUSY, not a wrong scan.
+ */
+#define SCAN_ZFS_SEARCH_MAX	16
+
+static int scan_zfs_import(struct scan_zfs_tgt *t, const char *search)
+{
+	libpc_handle_t lpch = {
+		.lpc_lib_handle = NULL,
+		.lpc_ops = &libzpool_config_ops,
+		.lpc_printerr = B_FALSE,
+	};
+	char dev_dir[] = "/dev";	/* importargs_t wants it writable */
+	char *dev_path = dev_dir;
+	char *dirs[SCAN_ZFS_SEARCH_MAX];
+	importargs_t args = {
+		.path = &dev_path,
+		.paths = 1,
+	};
+	uint64_t state;
+	nvlist_t *cfg = NULL;
+	char *dup = NULL;
+	int err;
+
+	/* a pool on file vdevs is not under /dev; the caller says where */
+	if (search != NULL) {
+		char *dir, *save = NULL;
+		int n = 0;
+
+		dup = strdup(search);
+		if (dup == NULL)
+			return -ENOMEM;
+		for (dir = strtok_r(dup, ":", &save); dir != NULL;
+		     dir = strtok_r(NULL, ":", &save)) {
+			if (n == SCAN_ZFS_SEARCH_MAX) {
+				/*
+				 * Dropping the rest silently would then look
+				 * like ENOENT, which this call documents as
+				 * "no pool of that name under the search
+				 * path" -- a wrong answer to a right name.
+				 */
+				free(dup);
+				return -E2BIG;
+			}
+			dirs[n++] = dir;
+		}
+		if (n > 0) {
+			args.path = dirs;
+			args.paths = n;
+		}
+	}
+
+	err = zpool_find_config(&lpch, t->zt_pool, &cfg, &args);
+	free(dup);
+	if (err != 0 || cfg == NULL) {
+		char kstat[ZFS_MAX_DATASET_NAME_LEN + 32];
+		struct stat st;
+
+		/*
+		 * A pool this kernel holds is skipped by the label scan, so
+		 * "in service right here" would otherwise read as "does not
+		 * exist".  The kstat directory says which it is.
+		 */
+		snprintf(kstat, sizeof(kstat), "/proc/spl/kstat/zfs/%s",
+			 t->zt_pool);
+		/*
+		 * A directory, not merely something of that name: the ~20
+		 * global kstats live in the same place as regular files, so
+		 * an exported pool called zil or fm would otherwise read as
+		 * one this kernel holds.
+		 */
+		if (stat(kstat, &st) == 0 && S_ISDIR(st.st_mode))
+			return -EBUSY;
+
+		/*
+		 * Two more that are not "no pool of that name", and saying
+		 * ENOENT for either sends the caller looking for a spelling
+		 * mistake that is not there.
+		 *
+		 * zpool_find_config() answers EINVAL when the search path
+		 * held more than one pool of this name: it cannot choose
+		 * between them and neither can this.
+		 */
+		if (err == EINVAL)
+			return -EINVAL;
+
+		/*
+		 * And the label scan needs /dev/zfs -- zutil_pool_active()
+		 * opens it for each candidate and get_configs() abandons the
+		 * whole search when that fails -- so with the module not
+		 * loaded an exported pool sitting right there is
+		 * indistinguishable from one that does not exist.  The
+		 * device's own absence is what tells them apart.
+		 */
+		if (access(ZFS_DEV, F_OK) != 0)
+			return -ENODEV;
+
+		return -ENOENT;
+	}
+
+	if (nvlist_lookup_uint64(cfg, ZPOOL_CONFIG_POOL_STATE, &state) == 0 &&
+	    state == POOL_STATE_ACTIVE) {
+		nvlist_free(cfg);
+		return -EBUSY;
+	}
+
+	err = spa_import(t->zt_pool, cfg, NULL,
+			 ZFS_IMPORT_MISSING_LOG | ZFS_IMPORT_SKIP_MMP);
+	nvlist_free(cfg);
+	/* another thread of this process imported it first */
+	if (err == EEXIST)
+		err = 0;
+	/* a pool feature this libzpool lacks, as ENOPKG is for libext2fs */
+	if (err == ENOTSUP)
+		return -ENOPKG;
+	if (err != 0)
+		return err > 0 ? -err : -EIO;
+
+	return 0;
+}
+
+/*
+ * A target's label: what mkfs.lustre stored as the lustre:svname dataset
+ * property, fsname-MDT0000.  Same parse as the ldiskfs backend's, and the
+ * same four separators: zfs_set_prop_str() writes ldd_svname through
+ * unchanged, so a target that has never been mounted carries ':', '=' or
+ * '+' here exactly as it does on ldiskfs.
+ */
+static void scan_zfs_label(const char *dsname, struct llapi_scan_tgt *tgt)
+{
+	char name[sizeof(tgt->tt_label)] = "";
+	const char *sep;
+	size_t len;
+	char *end;
+	long idx;
+
+	if (dsl_prop_get(dsname, "lustre:svname", 1, sizeof(name),
+			 name, NULL) != 0)
+		return;
+
+	memcpy(tgt->tt_label, name, sizeof(name));
+	tgt->tt_label[sizeof(tgt->tt_label) - 1] = '\0';
+
+	len = strlen(tgt->tt_label);
+	if (len < 8)
+		return;
+	sep = tgt->tt_label + len - 8;
+	/* the four separators mount_lustre.c reads, as libscan_ldiskfs.c */
+	if (sep[0] != '-' && sep[0] != ':' && sep[0] != '=' && sep[0] != '+')
+		return;
+
+	idx = strtol(sep + 4, &end, 16);
+	if (end != sep + 8 || idx < 0)
+		return;
+
+	if (strncmp(sep + 1, "OST", 3) == 0)
+		tgt->tt_flags |= LLAPI_SCAN_TGT_OST;
+	else if (strncmp(sep + 1, "MDT", 3) == 0)
+		tgt->tt_flags |= LLAPI_SCAN_TGT_MDT;
+	else
+		return;
+
+	/* INDEX_UNASSIGNED: a target, but not one with a number yet */
+	if (idx == 0xffff)
+		return;
+
+	tgt->tt_index = (__u32)idx;
+	tgt->tt_flags |= LLAPI_SCAN_TGT_INDEX;
+}
+
+int scan_zfs_open(const char *device, const char *search, void **tgtp,
+		  struct llapi_scan_tgt *tgt)
+{
+	struct scan_zfs_tgt *t;
+	uint64_t sa_obj = 0;
+	char *sep;
+	int rc;
+
+	t = calloc(1, sizeof(*t));
+	if (t == NULL)
+		return -ENOMEM;
+
+	/* the device here is a dataset: pool/dataset or pool/dataset@snap */
+	if (strlen(device) >= sizeof(t->zt_pool)) {
+		free(t);
+		return -ENAMETOOLONG;
+	}
+	snprintf(t->zt_pool, sizeof(t->zt_pool), "%s", device);
+	sep = strpbrk(t->zt_pool, "/@");
+	if (sep != NULL)
+		*sep = '\0';
+	/*
+	 * An empty name or "@snap" has no pool, and neither do "." and "..":
+	 * a pool name has to start with an alphanumeric.  All three would
+	 * reach the kstat probe below as a directory that exists whenever
+	 * the module is loaded -- "/proc/spl/kstat/zfs/", and for ".." its
+	 * parent -- and be answered "in use", telling the caller to export a
+	 * pool that was never named.  "lfs find --device .." is the way in:
+	 * scan_backend_kind() sends a relative name that stats as a
+	 * directory here.
+	 */
+	if (!isalnum((unsigned char)t->zt_pool[0])) {
+		free(t);
+		return -ENOENT;
+	}
+
+	pthread_mutex_lock(&scan_zfs_lock);
+	if (scan_zfs_users++ == 0) {
+		/*
+		 * Load no zpool.cache.  A pool listed there would be opened
+		 * even while the kernel holds it, before the EBUSY checks in
+		 * scan_zfs_import().
+		 */
+		spa_config_path = (char *)"";
+		/* a scan reads each block once: cap the ARC as zdb does */
+		zfs_arc_min = 2ULL << SPA_MAXBLOCKSHIFT;
+		zfs_arc_max = 256ULL << 20;
+		kernel_init(SPA_MODE_READ);
+	}
+	pthread_mutex_unlock(&scan_zfs_lock);
+
+	rc = dmu_objset_own(device, DMU_OST_ANY, B_TRUE, B_FALSE,
+			    scan_zfs_tag, &t->zt_os);
+	if (rc == ENOENT) {
+		rc = scan_zfs_import(t, search);
+		if (rc == 0)
+			rc = dmu_objset_own(device, DMU_OST_ANY, B_TRUE,
+					    B_FALSE, scan_zfs_tag, &t->zt_os);
+	}
+	if (rc != 0) {
+		rc = rc > 0 ? -rc : rc;
+		goto out;
+	}
+
+	/*
+	 * A zvol or a snapshot of one holds no ZPL objects to scan.  That is
+	 * this backend refusing this dataset, not the ENOTSUP the library
+	 * returns when it has no backend to ask -- a caller that skips its
+	 * work on the second must not skip it on the first.
+	 */
+	if (dmu_objset_type(t->zt_os) != DMU_OST_ZFS) {
+		rc = -EMEDIUMTYPE;
+		goto out_disown;
+	}
+
+	/* This dataset's SA registry; slot numbers are per-dataset, and
+	 * assuming fixed offsets is the silent-wrong-attributes bug.
+	 */
+	rc = zap_lookup(t->zt_os, MASTER_NODE_OBJ, ZFS_SA_ATTRS, 8, 1,
+			&sa_obj);
+	if (rc == 0)
+		rc = sa_setup(t->zt_os, sa_obj, zfs_attr_table, ZPL_END,
+			      &t->zt_atable);
+	if (rc != 0) {
+		rc = -EIO;
+		goto out_disown;
+	}
+
+	/*
+	 * osd_destroy()'s OSD_DESTROY_ASYNC branch leaves the dnode allocated
+	 * and records its id here; the commit callback frees it moments
+	 * later, but after a crash nothing has -- osd_unlinked_drain() runs
+	 * at the next mount, and a failover partner's copy has not had one.
+	 * Such an object keeps its SA and its trusted.lma, so the walk would
+	 * report a destroyed object as a live one.  ldiskfs gates every
+	 * object on the inode bitmap for the same reason.
+	 */
+	if (zap_lookup(t->zt_os, MASTER_NODE_OBJ, ZFS_UNLINKED_SET, 8, 1,
+		       &t->zt_unlinked) != 0)
+		t->zt_unlinked = 0;
+	/* empty once drained, as on a clean stop: skip the per-object lookup */
+	if (t->zt_unlinked != 0) {
+		uint64_t n;
+
+		if (zap_count(t->zt_os, t->zt_unlinked, &n) == 0 && n == 0)
+			t->zt_unlinked = 0;
+	}
+
+	memset(tgt, 0, sizeof(*tgt));
+	scan_zfs_label(device, tgt);
+	tgt->tt_chunks = SCAN_CHUNKS_MAX;
+
+	*tgtp = t;
+	return 0;
+
+out_disown:
+	dmu_objset_disown(t->zt_os, B_FALSE, scan_zfs_tag);
+out:
+	/* our import lasts until kernel_fini(): no export in read mode */
+	pthread_mutex_lock(&scan_zfs_lock);
+	if (--scan_zfs_users == 0)
+		scan_zfs_fini();
+	pthread_mutex_unlock(&scan_zfs_lock);
+	free(t);
+	return rc;
+}
+
+void scan_zfs_close(void *tgt)
+{
+	struct scan_zfs_tgt *t = tgt;
+
+	if (t == NULL)
+		return;
+	if (t->zt_atable != NULL)
+		sa_tear_down(t->zt_os);
+	dmu_objset_disown(t->zt_os, B_FALSE, scan_zfs_tag);
+	pthread_mutex_lock(&scan_zfs_lock);
+	if (--scan_zfs_users == 0)
+		scan_zfs_fini();
+	pthread_mutex_unlock(&scan_zfs_lock);
+	free(t);
+}
+
+/* The DMU handle is thread-safe: workers share the objset. */
+int scan_zfs_worker_init(void *tgt, void **wctxp)
+{
+	struct scan_zfs_worker *wk;
+
+	wk = calloc(1, sizeof(*wk));
+	if (wk == NULL)
+		return -ENOMEM;
+	wk->zw_tgt = tgt;
+	*wctxp = wk;
+	return 0;
+}
+
+void scan_zfs_worker_fini(void *tgt, void *wctx)
+{
+	struct scan_zfs_worker *wk = wctx;
+	int x;
+
+	if (wk == NULL)
+		return;
+	for (x = 0; x < LLAPI_SCAN_XA_MAX; x++)
+		free(wk->zw_bufs[x]);
+	free(wk);
+}
+
+/* Both answer in sa_lookup()'s currency: 0, or a positive errno. */
+static int scan_zfs_sa_get_u64(sa_handle_t *hdl, sa_attr_type_t attr,
+			       uint64_t *out)
+{
+	return sa_lookup(hdl, attr, out, sizeof(*out));
+}
+
+static int scan_zfs_sa_get_time(sa_handle_t *hdl, sa_attr_type_t attr,
+				__s64 *out)
+{
+	uint64_t tm[2];
+	int rc;
+
+	rc = sa_lookup(hdl, attr, tm, sizeof(tm));
+	if (rc != 0) {
+		*out = 0;
+		return rc;
+	}
+	*out = (__s64)tm[0];
+	return 0;
+}
+
+/* z_pflags bits are ZFS's own; IMMUTABLE and APPEND are the two a namespace
+ * scan also reports.  ZFS_NODUMP is left out for the reason
+ * libscan_ldiskfs.c gives.  Per-file compressed or encrypted does not exist
+ * on ZFS -- both are dataset properties.
+ */
+static __u32 scan_zfs_attrs(uint64_t pflags)
+{
+	return ((pflags & ZFS_IMMUTABLE) ? STATX_ATTR_IMMUTABLE : 0) |
+	       ((pflags & ZFS_APPENDONLY) ? STATX_ATTR_APPEND : 0);
+}
+
+/*
+ * One wanted xattr that DXATTR did not carry, out of the xattr directory:
+ * the name resolves through the directory ZAP to a znode whose content is
+ * the value.  This is where osd-zfs spills an EA too large for the SA, a
+ * wide layout being the usual case.
+ */
+static int scan_zfs_spill(struct scan_zfs_worker *wk, uint64_t xattr_obj,
+			  enum llapi_scan_xattr x, struct llapi_scan_obj *obj)
+{
+	struct scan_zfs_tgt *t = wk->zw_tgt;
+	sa_handle_t *hdl = NULL;
+	dmu_buf_t *db = NULL;
+	uint64_t xobj = 0;
+	uint64_t size = 0;
+	void *buf;
+	int rc;
+
+	rc = zap_lookup(t->zt_os, xattr_obj, scan_zfs_xattr_name[x], 8, 1,
+			&xobj);
+	if (rc == ENOENT)
+		return 0;	/* absent, which is normal */
+	if (rc != 0)
+		return -1;
+
+	/*
+	 * Spelled out rather than sa_handle_get(): that takes the bonus
+	 * buffer itself and, when sa_handle_get_from_db() then fails --
+	 * sa_build_index() returns EIO for an SA header whose magic is
+	 * neither SA_MAGIC nor its byte-swapped form -- returns the error
+	 * with the hold still taken.  A leaked bonus hold pins the dnode
+	 * until the process exits, which dmu_objset_disown() meets at close.
+	 */
+	rc = dmu_bonus_hold(t->zt_os, xobj, NULL, &db);
+	if (rc != 0)
+		return -1;
+	rc = sa_handle_get_from_db(t->zt_os, db, NULL, SA_HDL_PRIVATE, &hdl);
+	if (rc != 0) {
+		/*
+		 * *handlepp is assigned before sa_build_index()'s error is
+		 * returned, so hdl here can be a live cache handle whose
+		 * sa_bonus is this db.  Destroying it releases the bonus, so
+		 * the db must not be released again; releasing only the db
+		 * would leave the handle itself in the sa_cache.
+		 * scan_zfs_read_obj() takes the same two branches.
+		 */
+		if (hdl != NULL)
+			sa_handle_destroy(hdl);
+		else
+			dmu_buf_rele(db, NULL);
+		return -1;
+	}
+	rc = scan_zfs_sa_get_u64(hdl, t->zt_atable[ZPL_SIZE], &size);
+	sa_handle_destroy(hdl);
+	/* osd-zfs writes no xattr above OBD_MAX_EA_SIZE (XATTR_SIZE_MAX) */
+	if (rc != 0 || size > XATTR_SIZE_MAX)
+		return -1;
+	if (size == 0) {
+		static const char empty;
+
+		/* an empty value, as the SA-resident path delivers it */
+		obj->so_xattr[x].sv_buf = &empty;
+		obj->so_xattr[x].sv_len = 0;
+		obj->so_xa_valid |= LLAPI_SCAN_XA_BIT(x);
+		return 0;
+	}
+
+	if (size > wk->zw_buflen[x]) {
+		buf = realloc(wk->zw_bufs[x], size);
+		if (buf == NULL)
+			return -1;
+		wk->zw_bufs[x] = buf;
+		wk->zw_buflen[x] = size;
+	}
+
+	rc = dmu_read(t->zt_os, xobj, 0, size, wk->zw_bufs[x],
+		      DMU_READ_PREFETCH);
+	if (rc != 0)
+		return -1;
+
+	obj->so_xattr[x].sv_buf = wk->zw_bufs[x];
+	obj->so_xattr[x].sv_len = size;
+	obj->so_xa_valid |= LLAPI_SCAN_XA_BIT(x);
+	return 0;
+}
+
+/*
+ * The demanded xattrs.  One DXATTR unpack yields all the SA-resident ones,
+ * which is the common case and the reason tier 1 costs what tier 0 costs on
+ * this backend; anything missing is looked for in the spill directory.
+ *
+ * A failure means the object's Lustre state is unreadable: the caller must
+ * skip and count the object, not use it.
+ */
+static int scan_zfs_read_xattrs(struct scan_zfs_worker *wk, sa_handle_t *hdl,
+				__u32 want, struct llapi_scan_obj *obj)
+{
+	struct scan_zfs_tgt *t = wk->zw_tgt;
+	uint64_t xattr_obj = 0;
+	__u32 missing;
+	int have_dir;
+	int x;
+	int sz;
+	int rc;
+
+	rc = sa_size(hdl, t->zt_atable[ZPL_DXATTR], &sz);
+	if (rc == 0 && sz > 0) {
+		char *buf;
+
+		buf = malloc(sz);
+		if (buf == NULL)
+			return -1;
+		rc = sa_lookup(hdl, t->zt_atable[ZPL_DXATTR], buf, sz);
+		if (rc == 0)
+			rc = nvlist_unpack(buf, sz, &wk->zw_nv, 0);
+		free(buf);
+		if (rc != 0)
+			return -1;
+
+		for (x = 0; x < LLAPI_SCAN_XA_MAX; x++) {
+			uchar_t *val = NULL;
+			uint_t vlen = 0;
+
+			if (!(want & LLAPI_SCAN_XA_BIT(x)))
+				continue;
+			if (nvlist_lookup_byte_array(wk->zw_nv,
+					scan_zfs_xattr_name[x],
+					&val, &vlen) != 0)
+				continue;
+			obj->so_xattr[x].sv_buf = val;
+			obj->so_xattr[x].sv_len = vlen;
+			obj->so_xa_valid |= LLAPI_SCAN_XA_BIT(x);
+		}
+	} else if (rc != 0 && rc != ENOENT) {
+		return -1;
+	}
+
+	missing = want & ~obj->so_xa_valid;
+	have_dir = scan_zfs_sa_get_u64(hdl, t->zt_atable[ZPL_XATTR],
+				       &xattr_obj) == 0 && xattr_obj != 0;
+	if (missing == 0 || !have_dir)
+		return 0;
+
+	for (x = 0; x < LLAPI_SCAN_XA_MAX; x++) {
+		if (!(missing & LLAPI_SCAN_XA_BIT(x)))
+			continue;
+		if (scan_zfs_spill(wk, xattr_obj, x, obj) < 0)
+			return -1;
+	}
+	return 0;
+}
+
+static void scan_zfs_obj_done(struct scan_zfs_worker *wk)
+{
+	if (wk->zw_nv != NULL) {
+		nvlist_free(wk->zw_nv);
+		wk->zw_nv = NULL;
+	}
+}
+
+/* a value object from __osd_xattr_set(): no attributes but its size */
+static bool scan_zfs_is_xattr_value(sa_handle_t *hdl, const sa_attr_type_t *a,
+				    const dmu_object_info_t *doi)
+{
+	uint64_t v;
+
+	if (doi->doi_type != DMU_OT_PLAIN_FILE_CONTENTS &&
+	    doi->doi_type != DMU_OTN_UINT8_METADATA)
+		return false;
+
+	return sa_lookup(hdl, a[ZPL_SIZE], &v, sizeof(v)) == 0 &&
+	       sa_lookup(hdl, a[ZPL_LINKS], &v, sizeof(v)) == ENOENT &&
+	       sa_lookup(hdl, a[ZPL_PARENT], &v, sizeof(v)) == ENOENT &&
+	       sa_lookup(hdl, a[ZPL_GEN], &v, sizeof(v)) == ENOENT;
+}
+
+/*
+ * One object.  Held once: the obvious spelling, dmu_object_info() then
+ * sa_handle_get(), takes two independent dnode holds per object, and
+ * profiling put the pair at 40% of the scan; the by-dnode entry points
+ * halve that.
+ */
+static int scan_zfs_read_obj(struct scan_zfs_worker *wk, uint64_t id,
+			     const struct llapi_scan_sink *sink)
+{
+	struct scan_zfs_tgt *t = wk->zw_tgt;
+	struct llapi_scan_obj obj;
+	dmu_object_info_t doi;
+	sa_attr_type_t *a = t->zt_atable;
+	sa_handle_t *hdl = NULL;
+	dmu_buf_t *db = NULL;
+	dnode_t *dn = NULL;
+	uint64_t v;
+	int rc;
+
+	/*
+	 * Destroyed, and waiting for a drain that a crashed or failed-over
+	 * target has not run: allocated, with its SA and trusted.lma intact,
+	 * so nothing further down would tell it from a live object.
+	 */
+	if (t->zt_unlinked != 0 &&
+	    zap_lookup_int(t->zt_os, t->zt_unlinked, id) == 0)
+		return 0;
+
+	rc = dnode_hold(t->zt_os, id, scan_zfs_tag, &dn);
+	if (rc != 0) {
+		sink->sk_skip(sink->sk_ctx, LLAPI_SCAN_SKIP_IO);
+		return 0;
+	}
+
+	dmu_object_info_from_dnode(dn, &doi);
+
+	/* No SA bonus, so nothing a scan can describe: the ZPL master node,
+	 * the SA registry, the delete queue.  osd-zfs ZAPs are not excluded
+	 * here -- osd_zap_create_flags() gives them a DMU_OT_SA bonus, which
+	 * is how a directory, an OI file or an index reaches the sink.
+	 */
+	if (doi.doi_bonus_type != DMU_OT_SA) {
+		dnode_rele(dn, scan_zfs_tag);
+		return 0;
+	}
+
+	/* NULL tag: sa_handle_destroy() releases the bonus with one */
+	rc = dmu_bonus_hold_by_dnode(dn, NULL, &db, 0);
+	if (rc != 0) {
+		dnode_rele(dn, scan_zfs_tag);
+		sink->sk_skip(sink->sk_ctx, LLAPI_SCAN_SKIP_IO);
+		return 0;
+	}
+	/*
+	 * An xattr directory from __osd_xattr_set(): its SA is never
+	 * written, so the header is still zero.  Like an ldiskfs ea_inode,
+	 * it holds another object's xattrs and is not counted.
+	 */
+	if (doi.doi_type == DMU_OT_DIRECTORY_CONTENTS &&
+	    db->db_size >= sizeof(uint32_t) &&
+	    *(uint32_t *)db->db_data == 0) {
+		dmu_buf_rele(db, NULL);
+		dnode_rele(dn, scan_zfs_tag);
+		return 0;
+	}
+	rc = sa_handle_get_from_db(t->zt_os, db, NULL, SA_HDL_PRIVATE, &hdl);
+	if (rc != 0) {
+		/*
+		 * *handlepp is assigned before sa_build_index()'s error is
+		 * returned, so on this path hdl is a live cache handle whose
+		 * sa_bonus is this db.  Destroying it releases the bonus, so
+		 * the db must not be released again here.
+		 */
+		if (hdl != NULL)
+			sa_handle_destroy(hdl);
+		else
+			dmu_buf_rele(db, NULL);
+		dnode_rele(dn, scan_zfs_tag);
+		sink->sk_skip(sink->sk_ctx, LLAPI_SCAN_SKIP_INVALID);
+		return 0;
+	}
+
+	memset(&obj, 0, sizeof(obj));
+	obj.so_id = id;
+
+	if (scan_zfs_sa_get_u64(hdl, a[ZPL_MODE], &v) != 0) {
+		/*
+		 * A value spilled into that directory: its SA holds only
+		 * ZPL_SIZE.  Anything else without a mode is damage.
+		 */
+		if (!scan_zfs_is_xattr_value(hdl, a, &doi))
+			sink->sk_skip(sink->sk_ctx, LLAPI_SCAN_SKIP_INVALID);
+		rc = 0;
+		goto out;
+	}
+	obj.so_mode = (__u32)v;
+
+	/*
+	 * links == 0 is not "deleted" here: osd-zfs's own object hierarchy
+	 * carries zero links while live, so unlike the ldiskfs backend this
+	 * one delivers such objects and lets the LMA say what they are.
+	 */
+	if (scan_zfs_sa_get_u64(hdl, a[ZPL_LINKS], &v) == 0)
+		obj.so_nlink = (__u32)v;
+	if (scan_zfs_sa_get_u64(hdl, a[ZPL_UID], &v) == 0)
+		obj.so_uid = (__u32)v;
+	if (scan_zfs_sa_get_u64(hdl, a[ZPL_GID], &v) == 0)
+		obj.so_gid = (__u32)v;
+	/* osd-zfs keeps la_rdev in ZPL_RDEV as it was given */
+	if ((S_ISCHR(obj.so_mode) || S_ISBLK(obj.so_mode)) &&
+	    scan_zfs_sa_get_u64(hdl, a[ZPL_RDEV], &v) == 0)
+		obj.so_rdev = (__u32)v;
+	if (scan_zfs_sa_get_u64(hdl, a[ZPL_SIZE], &v) == 0)
+		obj.so_size = v;
+	/* osd-zfs keeps no size for a directory ZAP: report what a client
+	 * sees, the ZAP's length (osd_attr_get(), LU-15842)
+	 */
+	if (S_ISDIR(obj.so_mode))
+		obj.so_size = doi.doi_max_offset;
+	/*
+	 * ZPL_GEN is not reported.  LLAPI_SCAN_SO_GEN means "this object has
+	 * an IGIF", and a dnode id is wider than the 32 bits one holds: two
+	 * dnodes 2^32 apart with the same generation would be given the same
+	 * FID.  An object with no LMA is named by lfsr_ino here, which is
+	 * what llapi_scan_device.3 says of this backend.
+	 */
+	/*
+	 * Only when the flags were actually read: an object whose ZPL_FLAGS
+	 * is unreadable is one this scan cannot answer for, and declaring
+	 * the mask beside a zero so_flags would say "not immutable" instead.
+	 * Compressed and encrypted are dataset properties on ZFS, so they
+	 * are not in the set and scan_zfs_attrs() never returns them.
+	 */
+	if (scan_zfs_sa_get_u64(hdl, a[ZPL_FLAGS], &v) == 0) {
+		obj.so_flags = scan_zfs_attrs(v);
+		obj.so_attrs_mask = STATX_ATTR_IMMUTABLE | STATX_ATTR_APPEND;
+	}
+	/*
+	 * ZPL_PROJID is a feature, and a dataset without it says ENOENT:
+	 * projid 0 is then the answer, not a gap.  Any other failure is a
+	 * spill block that could not be read, and claiming 0 for that would
+	 * be inventing one -- so only these two set the bit.
+	 */
+	rc = scan_zfs_sa_get_u64(hdl, a[ZPL_PROJID], &v);
+	if (rc == 0)
+		obj.so_projid = (__u32)v;
+	if (rc == 0 || rc == ENOENT)
+		obj.so_valid |= LLAPI_SCAN_SO_PROJID;
+	scan_zfs_sa_get_time(hdl, a[ZPL_ATIME], &obj.so_atime);
+	scan_zfs_sa_get_time(hdl, a[ZPL_MTIME], &obj.so_mtime);
+	scan_zfs_sa_get_time(hdl, a[ZPL_CTIME], &obj.so_ctime);
+	/* zero is a legal birth time; only a present one is an answer */
+	if (scan_zfs_sa_get_time(hdl, a[ZPL_CRTIME], &obj.so_btime) == 0)
+		obj.so_valid |= LLAPI_SCAN_SO_BTIME;
+
+	/* dnode accounting, 512-byte units.  Post-compression physical: a
+	 * blocks test differs from ldiskfs semantics for compressible data.
+	 * Plus the dnode's own slots, as sa_object_size() gives osd_attr_get().
+	 */
+	obj.so_blocks = doi.doi_physical_blocks_512 + dn->dn_num_slots;
+
+	/* the cheap stage: no xattr has been unpacked yet */
+	rc = sink->sk_prefilter(sink->sk_ctx, &obj);
+	if (rc > 0) {
+		rc = 0;
+		goto out;
+	}
+	if (rc < 0)
+		goto out;
+
+	if (scan_zfs_read_xattrs(wk, hdl, sink->sk_want_xattr, &obj) < 0) {
+		sink->sk_skip(sink->sk_ctx, LLAPI_SCAN_SKIP_XATTR);
+		rc = 0;
+		goto out;
+	}
+
+	rc = sink->sk_object(sink->sk_ctx, &obj);
+	if (rc > 0)
+		rc = 0;
+out:
+	scan_zfs_obj_done(wk);
+	sa_handle_destroy(hdl);	/* releases the bonus buffer */
+	dnode_rele(dn, scan_zfs_tag);
+	return rc;
+}
+
+int scan_zfs_scan_chunk(void *tgt, void *wctx, __u64 idx,
+			const struct llapi_scan_sink *sink, int *done)
+{
+	struct scan_zfs_tgt *t = tgt;
+	struct scan_zfs_worker *wk = wctx;
+	uint64_t start = idx * SCAN_CHUNK_OBJS;
+	uint64_t end = start + SCAN_CHUNK_OBJS;
+	uint64_t id = start != 0 ? start - 1 : 0;
+
+	for (;;) {
+		int rc;
+
+		rc = dmu_object_next(t->zt_os, &id, B_FALSE, 0);
+		if (rc == ESRCH) {
+			/* the walk is global-forward: nothing at or beyond
+			 * this chunk means nothing beyond it at all
+			 */
+			*done = 1;
+			return 0;
+		}
+		/*
+		 * Anything else is a read that failed -- dnode_next_offset()
+		 * passes up dbuf_read()'s errors -- and reporting it as the
+		 * end would tell every other worker the target is finished
+		 * and return 0, so a truncated object set would look like a
+		 * complete one.
+		 */
+		if (rc != 0)
+			return -EIO;
+		if (id >= end)
+			return 0;
+
+		rc = scan_zfs_read_obj(wk, id, sink);
+		if (rc < 0)
+			return rc;
+	}
+}
