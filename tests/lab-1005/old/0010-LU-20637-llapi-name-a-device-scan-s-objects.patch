+run_test 303 "lfs find --paths names an MDT with no mount at all"
+
+test_304() {
+	# The offline half of test_303.  303 reads an MDT in service, which
+	# only ldiskfs allows, so the pre-pass that composes --paths has never
+	# run on ZFS: a ZFS target is readable only with its pool exported.
+	# Stopping the MDT is what lets both backends take the same route.
+	remote_mds_nodsh && skip "remote MDS with nodsh"
+
+	(( MDS1_VERSION >= $(version_code 2.17.58) )) ||
+		skip "Need MDS >= 2.17.58 for lfs find --paths"
+
+	local mdt1=$(mdsdevname 1)
+	local got=$TMP/$tfile.got
+	local want=$TMP/$tfile.want
+	local search=""
+	local missing
+
+	stack_trap "rm -f $got $got.raw $got.err $want $want.all"
+
+	is_mounted $MOUNT || setup_noconfig
+	check_mount || error "check_mount failed"
+	stack_trap "rm -rf $MOUNT/$tdir"
+
+	# on MDT0000: the map covers only the target scanned, so under DNE an
+	# object whose ancestors live elsewhere is nameless by construction
+	mkdir_on_mdt0 $MOUNT/$tdir || error "mkdir $tdir failed"
+	createmany -o $MOUNT/$tdir/f 20 || error "createmany failed"
+	sync; sync
+	do_facet mds1 "sync; sync"
+
+	# root-relative, as --paths answers: see test_303
+	$LFS find $MOUNT/$tdir -type f | sed "s|^$MOUNT||" | sort > $want
+	(( $(wc -l < $want) == 20 )) ||
+		error "client sees $(wc -l < $want) names, want 20"
+
+	# out of service, which is the only state a ZFS target can be read in
+	stop mds1 || error "stop mds1 failed"
+	stack_trap "start mds1 $mdt1 $MDS_MOUNT_OPTS || true"
+	if [[ "$mds1_FSTYPE" == zfs ]]; then
+		local poolname=$(zpool_name mds1)
+
+		export_zpool mds1 || error "export_zpool mds1 failed"
+		stack_trap "import_zpool mds1 || true"
+		# as test_302: export_zpool() answers 0 without exporting when
+		# something of the pool is still mounted, and an imported pool
+		# is refused rather than read.  Assert the state this needs.
+		do_facet mds1 "! $ZPOOL list -H $poolname >/dev/null 2>&1" ||
+			error "$poolname is still imported after export_zpool"
+		# the vdev is a file in $TMP, invisible to a scan of /dev
+		search="--search $(dirname $(mdsvdevname 1))"
+	fi
+
+	do_facet mds1 "$LFS find --device $mdt1 $search --paths --type f" \
+		> $got.raw 2> $got.err || {
+		# as test_300: ENOTSUP is a ZFS build with no backend, or lfs in
+		# a build without plugins, which does not link it
+		[[ "$mds1_FSTYPE" == zfs ]] &&
+			grep -q "Operation not supported" $got.err &&
+			skip "no zfs scan backend for lfs in this build"
+		error "lfs find --paths on stopped $mdt1: $(cat $got.err)"
+	}
+	grep "^/$tdir/" $got.raw | sort > $got
+
+	# the names, not merely some output: a scan that composed nothing and
+	# one that composed everything both exit 0
+	missing=$(comm -23 $want $got)
+	[[ -z "$missing" ]] || {
+		echo "$missing" | head -10
+		error "--paths lost $(echo "$missing" | wc -l) paths offline"
+	}
+
+	grep -q "^\[0x" $got.raw &&
+		error "--paths printed a FID where a path was asked for"
+	grep -q "^$MOUNT/" $got.raw &&
+		error "--paths printed a mounted pathname"
+
+	echo "offline --paths named $(wc -l < $got) objects on $mds1_FSTYPE"
+}
+run_test 304 "lfs find --paths names a stopped MDT"
