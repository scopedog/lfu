+ *
+ * The cursor, the end, the stop and the per-worker counters are reset here
+ * rather than by the caller: a second sweep starts at the first chunk with
+ * nothing carried over from the first, and a pre-pass that stopped early
+ * must not stop the sweep after it.  The end is one of them because a
+ * worker lowers it when it sees the last chunk.
+ */
+static int scan_device_sweep(struct scan_dev *dev, struct scan_worker *workers,
+			     unsigned int nworkers,
+			     struct llapi_scan_stats *stats)
+{
+	unsigned int started;
+	unsigned int i;
+	int rc = 0;
