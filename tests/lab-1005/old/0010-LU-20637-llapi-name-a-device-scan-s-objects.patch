+/*
+ * The directory map: what turns a scan of an MDT into pathnames without a
+ * lookup per object.
+ *
+ * An MDT object's trusted.link names its parent and the name it has there,
+ * which is one step of a path.  The rest is the same question asked of each
+ * ancestor, so a map of every directory on the target -- FID to (parent,
+ * name) -- answers all of them, and no request leaves the node.
+ *
+ * It is built by a pass of its own because objects arrive in inode order:
+ * an object is usually delivered before its ancestors are, so resolving
+ * inline would mean holding every match until the scan ended.  A
+ * directory-only pass asks for no layout, no SOM and no HSM, and a
+ * filesystem holds far fewer directories than files, so it is the cheaper
+ * half of that trade -- and it leaves the search itself streaming.
+ *
+ * Open addressing, power-of-two capacity, no deletion: built once, read
+ * many times.
+ */
+#define SCAN_DIRMAP_MIN		1024
+#define SCAN_DIRMAP_MAX_DEPTH	4096	/* a cycle, not a path */
+
+static size_t scan_dirmap_hash(const struct lu_fid *f, size_t cap)
+{
+	__u64 h = f->f_seq * 0x9e3779b97f4a7c15ULL + f->f_oid;
+
+	h ^= h >> 29;
+	h *= 0xbf58476d1ce4e5b9ULL;
+	h ^= h >> 32;
+
+	return (size_t)h & (cap - 1);
+}
+
+static bool scan_fid_eq(const struct lu_fid *a, const struct lu_fid *b)
+{
+	return a->f_seq == b->f_seq && a->f_oid == b->f_oid;
+}
+
+static bool scan_fid_zero(const struct lu_fid *f)
+{
+	return f->f_seq == 0 && f->f_oid == 0;
+}
+
+static int scan_dirmap_grow(struct scan_dirmap *m, size_t cap);
+
+static int scan_dirmap_put(struct scan_dirmap *m, const struct lu_fid *fid,
+			   const struct lu_fid *parent, const char *name)
+{
+	size_t i;
+
+	if (m->dm_used * 4 >= m->dm_cap * 3) {
+		int rc = scan_dirmap_grow(m, m->dm_cap * 2);
+
+		if (rc < 0)
+			return rc;
+	}
+
+	i = scan_dirmap_hash(fid, m->dm_cap);
+	while (!scan_fid_zero(&m->dm_tab[i].sd_fid)) {
+		/* the same directory twice is not an error */
+		if (scan_fid_eq(&m->dm_tab[i].sd_fid, fid))
+			return 0;
+		i = (i + 1) & (m->dm_cap - 1);
+	}
+	m->dm_tab[i].sd_fid = *fid;
+	m->dm_tab[i].sd_parent = *parent;
+	strncpy(m->dm_tab[i].sd_name, name, sizeof(m->dm_tab[i].sd_name) - 1);
+	m->dm_tab[i].sd_name[sizeof(m->dm_tab[i].sd_name) - 1] = '\0';
+	m->dm_used++;
+
+	return 0;
+}
+
+static int scan_dirmap_grow(struct scan_dirmap *m, size_t cap)
+{
+	struct scan_dirmap bigger = { 0 };
+	size_t i;
+
+	bigger.dm_tab = calloc(cap, sizeof(*bigger.dm_tab));
+	if (bigger.dm_tab == NULL)
+		return -ENOMEM;
+	bigger.dm_cap = cap;
+
+	for (i = 0; i < m->dm_cap; i++) {
+		if (scan_fid_zero(&m->dm_tab[i].sd_fid))
+			continue;
+		scan_dirmap_put(&bigger, &m->dm_tab[i].sd_fid,
+				&m->dm_tab[i].sd_parent, m->dm_tab[i].sd_name);
+	}
+	free(m->dm_tab);
+	m->dm_tab = bigger.dm_tab;
+	m->dm_cap = bigger.dm_cap;
+
+	return 0;
+}
+
+static const struct scan_dirent *scan_dirmap_get(const struct scan_dirmap *m,
+						 const struct lu_fid *fid)
+{
+	size_t i;
+
+	if (m->dm_tab == NULL)
+		return NULL;
+
+	i = scan_dirmap_hash(fid, m->dm_cap);
+	while (!scan_fid_zero(&m->dm_tab[i].sd_fid)) {
+		if (scan_fid_eq(&m->dm_tab[i].sd_fid, fid))
+			return &m->dm_tab[i];
+		i = (i + 1) & (m->dm_cap - 1);
+	}
+
+	return NULL;
+}
+
+void scan_dirmap_free(struct scan_dirmap *m)
+{
+	if (m == NULL)
+		return;
+	free(m->dm_tab);
+	m->dm_tab = NULL;
+	m->dm_cap = 0;
+	m->dm_used = 0;
+}
+
+/* every directory the target holds, with the name and parent its linkea
+ * gives; anything else is skipped
+ */
+static int scan_dirmap_cb(const struct llapi_scan_rec *rec, void *data)
+{
+	struct scan_dirmap *m = data;
+
+	if (!(rec->lfsr_stx.stx_mask & STATX_MODE) ||
+	    !S_ISDIR(rec->lfsr_stx.stx_mode))
+		return 0;
+	if ((rec->lfsr_valid & (LLAPI_SCAN_FID | LLAPI_SCAN_PARENT)) !=
+	    (LLAPI_SCAN_FID | LLAPI_SCAN_PARENT))
+		return 0;
+	if (rec->lfsr_name == NULL)
+		return 0;
+
+	/*
+	 * A shard is mapped with no name of its own, so the walk steps
+	 * through it to the master and the path it composes is the one the
+	 * filesystem has.  Its linkea name, "<DFID>:<index>", is not a path
+	 * element; mdt_path_current() drops it on the same test.
+	 */
+	if (rec->lfsr_valid & LLAPI_SCAN_LMV_SHARD)
+		return scan_dirmap_put(m, &rec->lfsr_fid, &rec->lfsr_parent_fid,
+				       "");
+
+	return scan_dirmap_put(m, &rec->lfsr_fid, &rec->lfsr_parent_fid,
+			       rec->lfsr_name);
+}
+
+/* the map holds directories: the rest is dropped before its xattrs */
+static int scan_dirmap_filter(const struct llapi_scan_rec *rec, void *data)
+{
+	return S_ISDIR(rec->lfsr_stx.stx_mode) ? 0 : 1;
+}
+
+/*
+ * Set up the map and the pass that fills it: a pass over the target asking
+ * only for what a directory's place in the tree needs.  It is the scan's
+ * pre-pass and not a scan of its own: the search that needs the map runs
+ * on the same open, and on ZFS an open is an import and a close an export.
+ *
+ * Only an MDT has directories to map.  pp_missing_rc is the caller's answer
+ * for a target that has none: --paths has no other way to name an object
+ * and refuses, while --fid2path names them through the mount and carries on.
+ */
+int scan_dirmap_prepass(struct scan_dirmap *m, int missing_rc,
+			struct scan_prepass *pre)
+{
+	memset(m, 0, sizeof(*m));
+	m->dm_tab = calloc(SCAN_DIRMAP_MIN, sizeof(*m->dm_tab));
+	if (m->dm_tab == NULL)
+		return -ENOMEM;
+	m->dm_cap = SCAN_DIRMAP_MIN;
+
+	memset(pre, 0, sizeof(*pre));
+	/*
+	 * LLAPI_SCAN_LMV costs a trusted.lmv read per directory and is what
+	 * tells a shard from a directory: without it the shards land in the
+	 * map as directories and their names reach the pathnames.
+	 */
+	pre->pp_want = LLAPI_SCAN_FID | LLAPI_SCAN_MODE | LLAPI_SCAN_TYPE |
+		       LLAPI_SCAN_CLASS | LLAPI_SCAN_PARENT |
+		       LLAPI_SCAN_LINKEA | LLAPI_SCAN_LMV;
+	pre->pp_cb = scan_dirmap_cb;
+	pre->pp_filter = scan_dirmap_filter;
+	pre->pp_data = m;
+	pre->pp_tgt_flags = LLAPI_SCAN_TGT_MDT;
+	pre->pp_missing_rc = missing_rc;
+
+	return 0;
+}
+
+/*
+ * The path of an object whose own name and parent are known, composed from
+ * the map by walking up to the root.
+ *
+ * Written from the back of @buf forward, which is the direction the walk
+ * discovers the components in.  The answer is relative to the filesystem
+ * root and begins with '/'.  fid2path's does not: mdt_path_current()
+ * steps over the leading separator before its memmove(), so only the root
+ * itself comes back with one.  A caller therefore does not prefix a mount
+ * point the same way for both -- llapi_scan_rec_path() joins fid2path's
+ * answer with "%s/%s", where find_decide() concatenates this one with
+ * "%s%s".
+ *
+ * Return: 0 and a path in @buf; -ENOENT if an ancestor is not in the map,
+ * which is what an object outside this target's tree looks like; -ERANGE if
+ * @buf is too small; -ELOOP if the walk does not reach the root.
+ */
+int scan_dirmap_path(const struct scan_dirmap *m, const struct lu_fid *parent,
+		     const char *name, char *buf, size_t buflen)
+{
+	const struct scan_dirent *e;
+	struct lu_fid cur;
+	size_t at = buflen;
+	unsigned int depth = 0;
+	size_t len;
+
+	if (m == NULL || parent == NULL || name == NULL || buf == NULL ||
+	    buflen < 2)
+		return -EINVAL;
+
+	cur = *parent;
+
+	buf[--at] = '\0';
+	len = strlen(name);
+	if (len + 1 > at)
+		return -ERANGE;
+	at -= len;
+	memcpy(buf + at, name, len);
+	buf[--at] = '/';
+
+	/*
+	 * Only LU_ROOT_FID ends the walk.  A filesystem upgraded from before
+	 * 2.4 has an IGIF root, so every path there fails with -ENOENT.
+	 */
+	while (!scan_fid_eq(&cur, &LU_ROOT_FID)) {
+		if (++depth > SCAN_DIRMAP_MAX_DEPTH)
+			return -ELOOP;
+		e = scan_dirmap_get(m, &cur);
+		if (e == NULL)
+			return -ENOENT;
+		len = strlen(e->sd_name);
+		/* a striped directory's shard: a step, not a component */
+		if (len == 0) {
+			cur = e->sd_parent;
+			continue;
+		}
+		if (len + 1 > at)
+			return -ERANGE;
+		at -= len;
+		memcpy(buf + at, e->sd_name, len);
+		buf[--at] = '/';
+		cur = e->sd_parent;
+	}
+
+	memmove(buf, buf + at, buflen - at);
+
+	return 0;
+}
+
 /**
  * llapi_scan_device() - scan a target's own objects, one record per object
  * @device:	block device, image or snapshot holding an MDT or OST
@@ -1306,6 +1670,96 @@ int scan_device_target(const char *device, const char *search,
  */
 int llapi_scan_device(const char *device, const struct llapi_scan_param *sp,
 		      llapi_scan_cb_t cb, void *data)
+{
+	/*
+	 * lfsp_fsname, not NULL: the check belongs to the scan because only the
