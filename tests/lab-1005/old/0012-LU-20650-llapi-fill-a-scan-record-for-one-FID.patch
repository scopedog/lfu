 	ASSERTF(rc == 0, "cannot clean %s: %s", root, strerror(errno));
 }
 
+/* what test17 keeps of the one record it asks for */
+struct fid_seen {
+	unsigned int	fs_count;
+	char		fs_path[PATH_MAX];
+	char		fs_name[NAME_MAX + 1];
+	__u64		fs_valid;
+	int		fs_fd;
+	int		fs_parent_fd;
+	__u32		fs_stx_mask;
+	__u32		fs_lmmsize;
+};
+
+static int fid_cb(const struct llapi_scan_rec *rec, void *data)
+{
+	struct fid_seen *fs = data;
+
+	fs->fs_count++;
+	fs->fs_valid = rec->lfsr_valid;
+	fs->fs_fd = rec->lfsr_fd;
+	fs->fs_stx_mask = rec->lfsr_stx.stx_mask;
+	fs->fs_lmmsize = rec->lfsr_lmmsize;
+	fs->fs_parent_fd = rec->lfsr_parent_fd;
+	if (rec->lfsr_path != NULL)
+		snprintf(fs->fs_path, sizeof(fs->fs_path), "%s",
+			 rec->lfsr_path);
+	if (rec->lfsr_name != NULL)
+		snprintf(fs->fs_name, sizeof(fs->fs_name), "%s",
+			 rec->lfsr_name);
+
+	return 0;
+}
+
+/* skip: a success with no record delivered */
+static int fid_skip_cb(const struct llapi_scan_rec *rec, void *data)
+{
+	(void)rec;
+	(void)data;
+
+	return 1;
+}
+
+#define T17_DESC "llapi_scan_fid fills one record for one FID"
+static void test17(void)
+{
+	struct llapi_scan_param sp = { .lfsp_size = sizeof(sp) };
+	char mnt[PATH_MAX], want[PATH_MAX], copy[PATH_MAX];
+	char slashed[PATH_MAX + 1];
+	struct fid_seen fs;
+	struct lu_fid fid;
+	struct lu_fid dfid;
+	int mnt_fd = -1;
+	int rc;
+
+	make_tree();
+
