diff --git a/lustre/tests/llapi_scan_test.c b/lustre/tests/llapi_scan_test.c
index 1904f58154..e4aa9cc267 100644
--- a/lustre/tests/llapi_scan_test.c
+++ b/lustre/tests/llapi_scan_test.c
@@ -17,6 +17,7 @@
 #include <ftw.h>
 #include <fnmatch.h>
