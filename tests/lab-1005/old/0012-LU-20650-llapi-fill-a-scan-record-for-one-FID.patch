+		 * that reads them, so neither pays for them.  The FID lookup
+		 * above is paid either way.
+		 * find_param_fini() at out: is safe on the zeroed struct a
+		 * path that never gets here leaves behind.
+		 */
+		rc = common_param_init(&param, path);
+		if (rc != 0)
+			goto out;
+
+		if (S_ISDIR(mode)) {
+			d = openat(mnt_fd, at,
+				   O_RDONLY | O_NDELAY | O_DIRECTORY);
+			if (d < 0) {
+				/* replaced by a non-directory */
+				rc = errno == ENOTDIR ? -ESTALE : -errno;
+				goto out;
+			}
+		} else {
+			char *slash = strrchr(rp, '/');
+
+			/*
+			 * open_parent() is open() plus dirname(); this is the
+			 * same thing from the mount.  An object directly
+			 * under it has the mount for a parent -- opened again
+			 * rather than dup()ed, so the close at out: owns it
+			 * whichever arm ran.  Only a directory reaches the
+			 * arm above with no name at all, so rp is not empty
+			 * here.
+			 */
+			if (slash == NULL) {
+				p = openat(mnt_fd, ".",
+					   O_RDONLY | O_NDELAY | O_DIRECTORY);
+			} else {
+				*slash = '\0';
+				p = openat(mnt_fd, rp,
+					   O_RDONLY | O_NDELAY | O_DIRECTORY);
+				*slash = '/';
+			}
+			if (p < 0) {
+				rc = -errno;
+				goto out;
+			}
+		}
+		rec.lfsr_parent_fd = p;
+		rec.lfsr_fd = d;
+
+		rc = scan_rec_gather(&param, path, p, d, &fd, want, &rec);
+		if (rc < 0)
+			goto out;
+	}
+
+	/*
+	 * The gather ran against the pathname, and a name can be unlinked and
+	 * recreated between the resolve above and here -- a build tree does
+	 * it -- so the record would describe whatever holds the name now.
+	 * The FID it carries is the object actually found.
+	 *
+	 * Only the gather fetches that FID, so this catches nothing in the
+	 * name-only mode above: there the record describes whatever holds the
+	 * name at the moment it was read.  The kernel-doc says so.  A gather
+	 * that ran and found no FID found something off Lustre -- a symlink
+	 * swapped in on the path, or a mount over a directory -- and that is
+	 * not the object asked for either.
+	 */
+	if ((want & LLAPI_SCAN_MDT_MASK) &&
+	    (!(rec.lfsr_valid & LLAPI_SCAN_FID) ||
+	     !lu_fid_eq(&rec.lfsr_fid, fid))) {
+		rc = -ESTALE;
+		goto out;
+	}
+
+	rc = cb(&rec, data);
+out:
+	if (fd >= 0)
+		close(fd);
+	if (d >= 0)
+		close(d);
+	if (p >= 0)
+		close(p);
+	find_param_fini(&param);
+	return rc;
+}
