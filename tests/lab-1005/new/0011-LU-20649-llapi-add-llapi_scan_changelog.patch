+	       (unsigned long long)masked.cr_with_event,
+	       (unsigned long long)all.cr_with_event);
+}
+
+struct busy_state {
+	char		 path[PATH_MAX + 16];	/* testdir, plus the name */
+	struct lu_fid	 fid;
+	bool		 running;	/* the writer is still writing */
+	bool		 stop;
+	bool		 delivered;
+	bool		 while_running;
+};
+
+/* 200 ms apart for 20 s: never quiet for the 1 s sc_min_age below */
+static void *busy_writer(void *arg)
+{
+	struct busy_state *bs = arg;
+	char marker[PATH_MAX + 32];
+	int fd;
+	int i;
+
+	for (i = 0; i < 100 && !__atomic_load_n(&bs->stop, __ATOMIC_ACQUIRE);
+	     i++) {
+		(void)chmod(bs->path, i % 2 ? 0644 : 0640);
+		usleep(200000);
+	}
+	__atomic_store_n(&bs->running, false, __ATOMIC_RELEASE);
+
+	/* an event elsewhere, so a scan still holding the file sees it go
+	 * quiet and ends rather than waiting for a record that never comes
+	 */
+	sleep(2);
+	snprintf(marker, sizeof(marker), "%s.marker", bs->path);
+	fd = creat(marker, 0644);
+	if (fd >= 0)
+		close(fd);
+	return NULL;
+}
+
+static int busy_cb(const struct llapi_scan_rec *rec, void *data)
+{
+	struct busy_state *bs = data;
+
+	if (!(rec->lfsr_valid & LLAPI_SCAN_FID) ||
+	    memcmp(&rec->lfsr_fid, &bs->fid, sizeof(bs->fid)) != 0)
+		return 0;
+	bs->delivered = true;
+	bs->while_running = __atomic_load_n(&bs->running, __ATOMIC_ACQUIRE);
+	return 1;	/* stop: this is what the case waits for */
+}
+
+#define T10_DESC "an object changed without pause is delivered, not held"
+static void test10(void)
+{
+	struct llapi_scan_changelog_param sc;
+	struct busy_state bs = { .running = true };
+	pthread_t th;
+	int rc;
+	int fd;
+
+	snprintf(bs.path, sizeof(bs.path), "%s/busy", testdir);
+	fd = creat(bs.path, 0644);
+	ASSERTF(fd >= 0, "cannot create %s: %s", bs.path, strerror(errno));
+	close(fd);
+	rc = llapi_path2fid(bs.path, &bs.fid);
+	ASSERTF(rc == 0, "no FID for %s: %s", bs.path, strerror(-rc));
+	ASSERTF(pthread_create(&th, NULL, busy_writer, &bs) == 0,
+		"cannot start the writer");
+
+	/* the hold limit is six sc_min_age, so 6 s of changes here */
+	param_init(&sc);
+	sc.sc_flags = LLAPI_SCAN_CL_F_COALESCE | LLAPI_SCAN_CL_F_FOLLOW;
+	sc.sc_min_age = 1;
+	rc = llapi_scan_changelog(&sc, busy_cb, &bs);
+	__atomic_store_n(&bs.stop, true, __ATOMIC_RELEASE);
+	pthread_join(th, NULL);
+
+	ASSERTF(rc == 1, "the scan returned %d, not the consumer's stop", rc);
+	ASSERTF(bs.delivered, "the busy file was never delivered");
+	ASSERTF(bs.while_running,
+		"the busy file was held until it went quiet");
+}
+
+static struct test_tbl_entry test_tbl[] = {
+	TEST_REGISTER(0),
+	TEST_REGISTER(1),
+	TEST_REGISTER(2),
+	TEST_REGISTER(3),
+	TEST_REGISTER(4),
+	TEST_REGISTER(5),
+	TEST_REGISTER(6),
+	TEST_REGISTER(7),
+	TEST_REGISTER(8),
+	TEST_REGISTER(9),
+	TEST_REGISTER(10),
+	TEST_REGISTER_END
+};
+
+static void usage(char *prog)
+{
+	printf("Usage: %s -m MDTNAME -d MOUNT [-u CHANGELOG_USER] [-e TESTS] [-o TESTS]\n"
+	       "       -m  the MDT whose Changelog to read\n"
+	       "       -d  a client mount of the same filesystem\n"
+	       "       -u  a registered Changelog user, to clear and to filter\n"
+	       "       -e  tests to skip, \"1,3,4\"\n"
+	       "       -o  tests to run\n", prog);
+	exit(EXIT_FAILURE);
+}
+
+static void process_args(int argc, char *argv[])
+{
+	int c;
+
+	while ((c = getopt(argc, argv, "d:e:hm:o:u:")) != -1) {
+		switch (c) {
+		case 'd':
+			mntpath = optarg;
+			break;
+		case 'e':
+			set_tests_to_skip(optarg, test_tbl);
+			break;
+		case 'm':
+			mdtname = optarg;
+			break;
+		case 'o':
+			set_tests_to_run(optarg, test_tbl);
+			break;
+		case 'u':
+			cluser = optarg;
+			break;
+		case 'h':
+		default:
+			usage(argv[0]);
+		}
+	}
+
+	if (mdtname == NULL || mntpath == NULL)
+		usage(argv[0]);
+}
+
+/*
+ * Under DNE the events this test makes land in the log of whichever MDT its
+ * directory was created on, which need not be the one -m names: the cases
+ * then read a log full of somebody else's records and fail on what is
+ * missing from it rather than on anything the library did.  Said here,
+ * where it can be said plainly.
+ */
+static void check_mdt_holds_testdir(void)
+{
+	const char *tag = strstr(mdtname, "MDT");
+	int idx = -1;
+	int want;
+	int fd;
+	int rc;
+
+	if (tag == NULL)
+		DIE("'%s' does not name an MDT\n", mdtname);
+	want = (int)strtol(tag + 3, NULL, 16);
+
+	fd = open(testdir, O_RDONLY | O_DIRECTORY);
+	if (fd < 0)
+		DIE("cannot open %s: %s\n", testdir, strerror(errno));
+	rc = llapi_file_fget_mdtidx(fd, &idx);
+	close(fd);
+	if (rc < 0)
+		DIE("cannot read the MDT index of %s: %s\n",
+		    testdir, strerror(-rc));
+
+	if (idx != want)
+		DIE("%s is on MDT%04x, not the MDT%04x that -m names\n",
+		    testdir, idx, want);
+}
+
+int main(int argc, char *argv[])
+{
+	process_args(argc, argv);
+
+	snprintf(testdir, sizeof(testdir), "%s/llapi_scan_changelog_test.d",
+		 mntpath);
+	if (make_events(testdir) == 0)
+		fprintf(stderr,
+			"warning: could not make events under %s; the tests read whatever the log already has\n",
+			testdir);
+	check_mdt_holds_testdir();
+
+	return run_tests(mntpath, test_tbl);
+}
