+#define T5_DESC "_ONCE delivers an object once where object mode repeats it"
+static void test5(void)
+{
+	struct llapi_scan_changelog_param sc;
+	struct cl_result again = { 0 }, once = { 0 };
+	struct lu_fid fid;
+	int rc;
+
+	rc = make_reappearing_object(testdir, &fid);
+	ASSERTF(rc == 0, "cannot make the workload under %s: %s",
+		testdir, strerror(-rc));
+	again.cr_target = fid;
+	once.cr_target = fid;
+
+	/*
+	 * The premise, and not an assumption: object mode with a cache of one
+	 * has to deliver this object more than once, or the flag below has
+	 * nothing to suppress and the test would pass on an empty stream.
+	 */
+	param_init(&sc);
+	sc.sc_flags = LLAPI_SCAN_CL_F_COALESCE;
+	sc.sc_max_cached = 1;
+	rc = llapi_scan_changelog(&sc, cl_cb, &again);
+	ASSERTF(rc == 0, "object mode failed: %s", strerror(-rc));
+	ASSERTF(again.cr_target_hits > 1,
+		"object mode delivered "DFID" %u times, so there is no repeat to suppress",
+		PFID(&fid), again.cr_target_hits);
+
+	param_init(&sc);
+	sc.sc_flags = LLAPI_SCAN_CL_F_COALESCE | LLAPI_SCAN_CL_F_ONCE;
+	sc.sc_max_cached = 1;
+	rc = llapi_scan_changelog(&sc, cl_cb, &once);
+	ASSERTF(rc == 0, "_ONCE failed: %s", strerror(-rc));
+	ASSERTF(once.cr_target_hits == 1,
+		"_ONCE delivered "DFID" %u times", PFID(&fid),
+		once.cr_target_hits);
+	ASSERTF(once.cr_records <= again.cr_records,
+		"_ONCE delivered %u records, more than the %u without it",
+		once.cr_records, again.cr_records);
+
+	printf("  "DFID" arrives %u times, once with _ONCE; %u records of %u\n",
+	       PFID(&fid), again.cr_target_hits, once.cr_records,
+	       again.cr_records);
