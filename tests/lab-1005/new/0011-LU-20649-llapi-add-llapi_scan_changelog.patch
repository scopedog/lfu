+#define T7_DESC "sc_got reports the subset this scan will answer for"
+static void test7(void)
+{
+	struct llapi_scan_changelog_param sc;
+	struct cl_result res = { 0 };
+	__u64 got = 0;
+	int rc;
+
+	/*
+	 * The field is reachable at all, which is the half a compiler cannot
+	 * check: sc_got is read out of the caller's struct through
+	 * scan_cl_param_whole(), so a field missing from that list is copied
+	 * over and the answer never comes back.
+	 */
+	param_init(&sc);
+	sc.sc_want = LLAPI_SCAN_EVENT | LLAPI_SCAN_FID | LLAPI_SCAN_SIZE;
+	sc.sc_got = &got;
+	rc = llapi_scan_changelog(&sc, cl_cb, &res);
+	ASSERTF(rc == 0, "the scan failed: %s", strerror(-rc));
+	ASSERTF(got != 0, "sc_got came back 0; the scan answers for something");
+	ASSERTF((got & ~sc.sc_want) == 0,
+		"sc_got 0x%llx has bits sc_want 0x%llx did not ask for",
+		(unsigned long long)got, (unsigned long long)sc.sc_want);
+
+	/*
+	 * And that it is the scan's answer rather than an echo: a size needs
+	 * a lookup, which needs _RESOLVE and a mount, so without them it has
+	 * to be dropped from what was asked for.
+	 */
+	ASSERTF(!(got & LLAPI_SCAN_SIZE),
+		"sc_got claims a size with no resolve to supply one");
+	ASSERTF(got & LLAPI_SCAN_EVENT,
+		"sc_got dropped LLAPI_SCAN_EVENT, which every record carries");
+
+	printf("  want 0x%llx -> got 0x%llx without a resolve\n",
+	       (unsigned long long)sc.sc_want, (unsigned long long)got);
+}
