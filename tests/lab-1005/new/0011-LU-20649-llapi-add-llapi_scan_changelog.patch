+	ASSERTF(masked.cr_types & (1ULL << CL_CREATE),
+		"the mask delivered no CL_CREATE, though a file was created");
+	ASSERTF(!(masked.cr_types & ~((1ULL << CL_CREATE) | (1ULL << CL_MARK))),
+		"the mask let other types through: %#llx",
+		(unsigned long long)masked.cr_types);
