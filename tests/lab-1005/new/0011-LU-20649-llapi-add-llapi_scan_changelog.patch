+/*
+ * One object with another object's records in between, which is what makes
+ * the coalescing cache give it up and take it back: with sc_max_cached at 1
+ * the second file evicts the first, so the first is delivered before its own
+ * last event is read.  Returns its FID.
+ */
+static int make_reappearing_object(const char *dir, struct lu_fid *fid)
+{
+	char first[PATH_MAX + 16];
+	char second[PATH_MAX + 16];
+	int fd;
+	int rc;
+
+	if (mkdir(dir, 0755) < 0 && errno != EEXIST)
+		return -errno;
+
+	snprintf(first, sizeof(first), "%s/twice", dir);
+	snprintf(second, sizeof(second), "%s/between", dir);
+
+	fd = open(first, O_CREAT | O_WRONLY | O_TRUNC, 0644);
+	if (fd < 0)
+		return -errno;
+	close(fd);
+
+	fd = open(second, O_CREAT | O_WRONLY | O_TRUNC, 0644);
+	if (fd < 0)
+		return -errno;
+	close(fd);
+
+	/* back to the first, after the second has taken its place */
+	fd = open(first, O_WRONLY | O_APPEND);
+	if (fd < 0)
+		return -errno;
+	rc = write(fd, "x", 1) == 1 ? 0 : -errno;
+	fsync(fd);
+	close(fd);
+	if (rc < 0)
+		return rc;
+
+	sync();
+
+	return llapi_path2fid(first, fid);
+}
