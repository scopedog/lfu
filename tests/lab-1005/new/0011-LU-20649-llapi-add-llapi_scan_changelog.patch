new file mode 100644
index 0000000000..c81ccd54e8
--- /dev/null
+++ b/lustre/tests/llapi_scan_changelog_test.c
@@ -0,0 +1,862 @@
+// SPDX-License-Identifier: LGPL-2.1+
+/*
+ * Copyright (c) 2026, The Lustre Collective.
+ */
+/*
+ * This file is part of Lustre, http://www.lustre.org/
+ *
+ * Tests for llapi_scan_changelog(): what a compiler cannot check.
+ *
+ * What a compiler cannot check about llapi_scan_changelog(): that the events
+ * it delivers are the ones the workload produced, that object mode collapses
+ * a burst into one record, that a consumer's return value reaches the caller,
+ * that the demand mask keeps a lookup from happening, and that bad arguments
+ * are refused rather than crashed on.
+ *
+ * Usage: llapi_scan_changelog_test -m MDTNAME -d MOUNT [-u USER]
+ *			[-e TESTS] [-o TESTS]
+ *
+ * The changelog user is the caller's to register, as it is for any consumer:
+ *	lctl --device MDTNAME changelog_register -m ALL
+ * -m ALL, because the filter test9 sets cannot find a user registered
+ * without a mask (LU-20647).  Without -u, test6 and test9 skip.
+ *
+ * The cases are registered and run through run_tests(), as this suite's
+ * siblings are: each one is forked, so a case that crashes ends itself
+ * rather than the run -- which is test4's whole subject -- and -e and -o
+ * select what runs.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <getopt.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <lustre/lustreapi.h>
+
+#include "llapi_test_utils.h"
+
+static char *mdtname;
+static char *mntpath;
+static char *cluser;
+static char testdir[PATH_MAX];		/* where every case makes its events */
+
+struct cl_result {
+	unsigned int	cr_records;
+	unsigned int	cr_with_fid;
+	unsigned int	cr_with_event;
+	unsigned int	cr_with_name;
+	unsigned int	cr_resolved;	/* carried a size, so a lookup ran */
+	unsigned int	cr_stop_after;	/* 0: never stop */
+	struct lu_fid	cr_target;	/* counted on its own; 0: none */
+	unsigned int	cr_target_hits;
+	__u64		cr_seen_valid;	/* union of every lfsr_valid seen */
+	__u64		cr_first_index;
+	__u64		cr_last_index;
+	__u64		cr_types;	/* BIT(cr_type) of everything seen */
+};
+
+static int cl_cb(const struct llapi_scan_rec *rec, void *data)
+{
+	struct cl_result *res = data;
+
+	res->cr_records++;
+	res->cr_seen_valid |= rec->lfsr_valid | rec->lfsr_stx.stx_mask;
+
+	if (rec->lfsr_valid & LLAPI_SCAN_FID)
+		res->cr_with_fid++;
+	if ((rec->lfsr_valid & LLAPI_SCAN_FID) &&
+	    rec->lfsr_fid.f_seq == res->cr_target.f_seq &&
+	    rec->lfsr_fid.f_oid == res->cr_target.f_oid &&
+	    res->cr_target.f_seq != 0)
+		res->cr_target_hits++;
+	if (rec->lfsr_valid & LLAPI_SCAN_EVENT) {
+		res->cr_with_event++;
+		if (res->cr_first_index == 0)
+			res->cr_first_index = rec->lfsr_event_index;
+		res->cr_last_index = rec->lfsr_event_index;
+		if (rec->lfsr_event_type < 64)
+			res->cr_types |= 1ULL << rec->lfsr_event_type;
+	}
+	if (rec->lfsr_name != NULL && rec->lfsr_name[0] != '\0')
+		res->cr_with_name++;
+	if (rec->lfsr_stx.stx_mask & STATX_SIZE)
+		res->cr_resolved++;
+
+	if (res->cr_stop_after != 0 && res->cr_records >= res->cr_stop_after)
+		return -ESHUTDOWN;	/* a value of the consumer's choosing */
+
+	return 0;
+}
+
+static void param_init(struct llapi_scan_changelog_param *sc)
+{
+	memset(sc, 0, sizeof(*sc));
+	sc->sc_size = sizeof(*sc);
+	sc->sc_mdtname = mdtname;
+	sc->sc_user = cluser;
+	sc->sc_mnt = mntpath;
+}
+
+/* A workload with one of each event this test reasons about. */
+static __u64 make_events(const char *dir)
+{
+	/* room for dir plus the longest name below, so the compiler can see
+	 * that neither snprintf() can truncate
+	 */
+	char sub[PATH_MAX + 16];
+	char path[PATH_MAX + 32];
+	char other[PATH_MAX + 32];
+	int fd;
+	int i;
+
+	if (mkdir(dir, 0755) < 0 && errno != EEXIST)
+		return 0;
+
+	/*
+	 * The workload gets a directory of its own, named for the process
+	 * that makes it.  @dir is the caller's and may well predate the
+	 * Changelog user -- sanity 56Eea creates it with "lfs mkdir -i 0",
+	 * before registering, to put it on the MDT whose log is read -- and
+	 * a CL_MKDIR outside the window is one test0 cannot see.  Each case
+	 * is forked, so the pid also keeps two calls from colliding.
+	 */
+	snprintf(sub, sizeof(sub), "%s/w%d", dir, (int)getpid());
+	if (mkdir(sub, 0755) < 0)
+		return 0;
+
+	snprintf(path, sizeof(path), "%s/file", sub);
+	snprintf(other, sizeof(other), "%s/renamed", sub);
+
+	fd = open(path, O_CREAT | O_WRONLY | O_TRUNC, 0644);
+	if (fd < 0)
+		return 0;
+
+	/* a burst: object mode must make one record of this */
+	for (i = 0; i < 20; i++) {
+		if (write(fd, "x", 1) != 1)
+			break;
+		fsync(fd);
+	}
+	close(fd);
+
+	if (rename(path, other) < 0)
+		return 0;
+	if (unlink(other) < 0)
+		return 0;
+
+	sync();
+	return 1;
+}
+
+#define T0_DESC "the stream delivers records that describe events"
+static void test0(void)
+{
+	struct llapi_scan_changelog_param sc;
+	struct cl_result res = { 0 };
+	int rc;
+
+	param_init(&sc);
+
+	rc = llapi_scan_changelog(&sc, cl_cb, &res);
+	ASSERTF(rc == 0, "llapi_scan_changelog() failed: %s", strerror(-rc));
+	ASSERTF(res.cr_records > 0, "no records delivered");
+	ASSERTF(res.cr_with_event == res.cr_records,
+		"%u of %u records carry no event",
+		res.cr_records - res.cr_with_event, res.cr_records);
+	ASSERTF(res.cr_with_fid > 0, "no record carried a FID");
+
+	/*
+	 * The workload creates, writes, renames and unlinks one file under a
+	 * new directory, so those four types have to be in the stream: the
+	 * accumulators are what say the events arrived as themselves and not
+	 * merely in the right number.
+	 */
+	ASSERTF(res.cr_types & (1ULL << CL_MKDIR), "no CL_MKDIR in the stream");
+	ASSERTF(res.cr_types & (1ULL << CL_CREATE),
+		"no CL_CREATE in the stream");
+	ASSERTF(res.cr_types & (1ULL << CL_RENAME),
+		"no CL_RENAME in the stream");
+	ASSERTF(res.cr_types & (1ULL << CL_UNLINK),
+		"no CL_UNLINK in the stream");
+	ASSERTF(res.cr_seen_valid & LLAPI_SCAN_EVENT,
+		"no record reported LLAPI_SCAN_EVENT");
+	ASSERTF(res.cr_seen_valid & LLAPI_SCAN_FID,
+		"no record reported LLAPI_SCAN_FID");
+
+	printf("  %u records, %u with a FID, %u with a name, last index %llu\n",
+	       res.cr_records, res.cr_with_fid, res.cr_with_name,
+	       (unsigned long long)res.cr_last_index);
+}
