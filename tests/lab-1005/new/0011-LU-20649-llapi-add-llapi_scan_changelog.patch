+/**
+ * struct llapi_scan_changelog_param - what llapi_scan_changelog() is asked for
+ *
+ * sc_size says how much of this structure the caller built, so a field added
+ * at the end later is answerable from the size alone.  sc_padding must be
+ * zero, which is what lets a field be carved out of it later: those bytes are
+ * already counted in sc_size, so a newer caller setting one could not
+ * otherwise be told from an older caller that did not.
+ */
+struct llapi_scan_changelog_param {
+	__u32			 sc_size;	/* sizeof(*sc) */
+	__u32			 sc_min_age;	/* seconds to hold an object
+						 * while coalescing; 0 = the
+						 * default
+						 */
+	__u64			 sc_flags;	/* LLAPI_SCAN_CL_F_* */
+	__u64			 sc_want;	/* LLAPI_SCAN_*; 0: all */
+	llapi_scan_cb_t		 sc_filter;	/* before any lookup, or NULL */
+	const char		*sc_mdtname;	/* "testfs-MDT0000" */
+	const char		*sc_user;	/* "cl1"; required to clear */
+	const char		*sc_mnt;	/* a client mount, for
+						 * LLAPI_SCAN_CL_F_RESOLVE
+						 */
+	__u64			 sc_startrec;	/* 0: the oldest kept */
+	__u64			 sc_endrec;	/* 0: to the end */
+	__u64			 sc_type_mask;	/* BIT(CL_*); 0: every type */
+	__u32			 sc_max_cached;	/* objects held while
+						 * coalescing; 0 = the default
+						 */
+	__u32			 sc_padding;	/* must be zero */
+	struct llapi_scan_stats	*sc_stats;	/* NULL: not wanted */
+	/*
+	 * Filled before the first record with the subset of sc_want this
+	 * scan will answer for, or NULL if the caller does not want to
+	 * know -- lfsp_got for the other two scanners, so one consumer can
+	 * ask all three the same question.  A changelog answers for fewer
+	 * fields than either: it has no layout, no linkea and no inode
+	 * number to give, and what a lookup can add depends on
+	 * LLAPI_SCAN_CL_F_RESOLVE and on a mount being named.
+	 */
+	__u64			*sc_got;
