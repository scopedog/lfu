+/*
+ * One rename to a new name and one over an existing name, each in a
+ * directory of its own.  @moved and @over are the objects that moved, and
+ * @victim the object the second rename replaced.
+ */
+static int make_renames(const char *dir, struct lu_fid *moved,
+			struct lu_fid *over, struct lu_fid *victim)
+{
+	char sub[PATH_MAX + 16];
+	char a[PATH_MAX + 32];
+	char b[PATH_MAX + 32];
+	int fd;
+	int rc;
+
+	snprintf(sub, sizeof(sub), "%s/rn%d", dir, (int)getpid());
+	if (mkdir(sub, 0755) < 0)
+		return -errno;
+
+	snprintf(a, sizeof(a), "%s/a", sub);
+	snprintf(b, sizeof(b), "%s/new", sub);
+	fd = open(a, O_CREAT | O_WRONLY | O_TRUNC, 0644);
+	if (fd < 0)
+		return -errno;
+	close(fd);
+	rc = llapi_path2fid(a, moved);
+	if (rc < 0)
+		return rc;
+	if (rename(a, b) < 0)
+		return -errno;
+
+	snprintf(a, sizeof(a), "%s/c", sub);
+	snprintf(b, sizeof(b), "%s/d", sub);
+	fd = open(a, O_CREAT | O_WRONLY | O_TRUNC, 0644);
+	if (fd < 0)
+		return -errno;
+	close(fd);
+	fd = open(b, O_CREAT | O_WRONLY | O_TRUNC, 0644);
+	if (fd < 0)
+		return -errno;
+	close(fd);
+	rc = llapi_path2fid(a, over);
+	if (rc < 0)
+		return rc;
+	rc = llapi_path2fid(b, victim);
+	if (rc < 0)
+		return rc;
+	if (rename(a, b) < 0)
+		return -errno;
+
+	sync();
+	return 0;
+}
+
+struct rn_result {
+	struct lu_fid	rn_moved;
+	struct lu_fid	rn_over;
+	struct lu_fid	rn_victim;
+	unsigned int	rn_moved_hits;
+	unsigned int	rn_over_hits;
+	unsigned int	rn_victim_hits;
+};
+
+static bool fid_same(const struct lu_fid *a, const struct lu_fid *b)
+{
+	return a->f_seq == b->f_seq && a->f_oid == b->f_oid;
+}
+
+static int rn_cb(const struct llapi_scan_rec *rec, void *data)
+{
+	struct rn_result *res = data;
+
+	if (!(rec->lfsr_valid & LLAPI_SCAN_EVENT) ||
+	    rec->lfsr_event_type != CL_RENAME ||
+	    !(rec->lfsr_valid & LLAPI_SCAN_FID))
+		return 0;
+	if (fid_same(&rec->lfsr_fid, &res->rn_moved))
+		res->rn_moved_hits++;
+	if (fid_same(&rec->lfsr_fid, &res->rn_over))
+		res->rn_over_hits++;
+	if (fid_same(&rec->lfsr_fid, &res->rn_victim))
+		res->rn_victim_hits++;
+	return 0;
+}
+
+#define T8_DESC "a rename is about the object that moved"
+static void test8(void)
+{
