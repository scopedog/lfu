diff --git a/lustre/utils/liblustreapi_scan_changelog.c b/lustre/utils/liblustreapi_scan_changelog.c
new file mode 100644
index 0000000000..33a645bd4b
--- /dev/null
+++ b/lustre/utils/liblustreapi_scan_changelog.c
@@ -0,0 +1,1356 @@
+// SPDX-License-Identifier: LGPL-2.1+
+/*
+ * Copyright (c) 2026, The Lustre Collective.
+ */
+/*
+ * This file is part of Lustre, http://www.lustre.org/
+ *
+ * lustreapi library for reading a Lustre Changelog as an Object Stream:
+ * one record per event, or one per object once its events have settled.
+ *
+ * The other two scanners enumerate what exists.  This one enumerates what
+ * happened, and delivers it in the same record, so a consumer written against
+ * llapi_scan_namespace() or llapi_scan_device() can be fed by a delta without
+ * being rewritten.
+ *
+ * What a changelog record carries is FID, parent FID, name, the event and its
+ * time, and -- with the extensions -- uid, gid and a job id.  It carries no
+ * size, mode, times, layout or HSM state at any setting, so those are either
+ * delivered absent, with their lfsr_valid bit clear, or filled by a lookup the
+ * caller asked for with LLAPI_SCAN_CL_F_RESOLVE.  Resolution fills; it never
+ * removes an object from the stream and never overrides what the event said.
+ *
+ * Two modes.  Event mode delivers one record per event, in order.  Object
+ * mode (LLAPI_SCAN_CL_F_COALESCE) holds events in a FID-keyed cache and
+ * delivers one record per object once it has been quiet for sc_min_age
+ * seconds, which is what turns a hundred writes to one file into one record
+ * and one lookup.  The cache is a window, so an object touched again after
+ * it has left arrives a second time; LLAPI_SCAN_CL_F_ONCE keeps the FIDs
+ * delivered so far and drops those repeats, at a FID per distinct object.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <libcfs/util/list.h>
+#include <linux/lustre/lustre_fid.h>
+#include <linux/lustre/lustre_idl.h>
+#include <lustre/lustreapi.h>
+
+#include "lustreapi_internal.h"
+
+/* Held before emitting, so a burst of events on one object is one record. */
+#define SCAN_CL_MIN_AGE_DEF	600
+/*
+ * An object changed without pause is never quiet for sc_min_age.  Held past
+ * this many times sc_min_age, it is delivered on its next event and held
+ * afresh.
+ */
+#define SCAN_CL_MAX_HOLD	6
+/* Objects held while coalescing before the oldest is pushed out early. */
+#define SCAN_CL_MAX_CACHED_DEF	100000
+/* Buckets in the coalescing cache.  A power of two; the FID hash shifts. */
+#define SCAN_CL_HASH_SHIFT	12
+#define SCAN_CL_HASH_SIZE	(1 << SCAN_CL_HASH_SHIFT)
+/* Slots in the delivered-object set, before it grows.  A power of two. */
+#define SCAN_CL_SEEN_MIN_SHIFT	10
+/* Records accepted between one clear and the next: clearing is an ioctl, and
+ * once per record is a syscall per event for no gain.
+ */
+#define SCAN_CL_CLEAR_BATCH	1000
+
+/* What an event carries.  LLAPI_SCAN_TYPE is here because scan_cl_mode()
+ * reads it off four record types.
+ */
+#define SCAN_CL_EVENT_MASK	(LLAPI_SCAN_EVENT | LLAPI_SCAN_EVENT_SRC | \
+				 LLAPI_SCAN_JOBID | LLAPI_SCAN_FID | \
+				 LLAPI_SCAN_PARENT | LLAPI_SCAN_EVENT_UID | \
+				 LLAPI_SCAN_TYPE)
+
+/*
+ * What llapi_scan_changelog() can answer for, which is less than either
+ * sibling: a changelog carries the event and the object's identity, and a
+ * resolve adds what one stat(2) of the object gives.  A project id, a
+ * layout, an LMV, HSM state, a linkea, an inode number, a class and an OST
+ * object's owner are never filled at any setting, and sc_got is what says
+ * so before the first record rather than leaving a caller to infer it.
+ */
+#define SCAN_CL_RESOLVE_MASK	(LLAPI_SCAN_MODE | LLAPI_SCAN_TYPE | \
+				 LLAPI_SCAN_NLINK | LLAPI_SCAN_UID | \
+				 LLAPI_SCAN_GID | LLAPI_SCAN_ATIME | \
+				 LLAPI_SCAN_MTIME | LLAPI_SCAN_CTIME | \
+				 LLAPI_SCAN_BTIME | \
+				 LLAPI_SCAN_SIZE | LLAPI_SCAN_BLOCKS | \
+				 LLAPI_SCAN_LAZY_SIZE | LLAPI_SCAN_LAZY_BLOCKS)
+
+/*
+ * One object's accumulated events, while object mode waits for it to settle.
+ * The name and the rename source are copied rather than pointed at: the
+ * changelog record they came from is freed as soon as the next one is read.
+ */
+struct scan_cl_obj {
+	struct list_head	 co_link;	/* by last-seen, oldest first */
+	struct list_head	 co_hash;
+	struct lu_fid		 co_fid;
+	struct lu_fid		 co_pfid;
+	struct lu_fid		 co_src_fid;
+	struct lu_fid		 co_src_pfid;
+	__u64			 co_valid;	/* LLAPI_SCAN_* it can answer */
+	__u64			 co_index;	/* the latest event's */
+	__u64			 co_first;	/* the earliest event's: what
+						 * a clear must not run past
+						 */
+	__u64			 co_prev;
+	__s64			 co_time;	/* the latest event's */
+	__s64			 co_first_time;	/* the earliest event's */
+	__u32			 co_type;	/* the latest event's */
+	__u32			 co_flags;
+	__u32			 co_event_uid;	/* who acted, not who owns */
+	__u32			 co_event_gid;
+	__u32			 co_mode;	/* S_IFMT, from the event */
+	char			*co_name;
+	char			*co_src_name;
+	char			*co_jobid;
+};
+
+/*
+ * Every object already handed to the callback, under LLAPI_SCAN_CL_F_ONCE.
+ * Open addressing, power-of-two capacity, no deletion, and a FID per entry:
+ * the coalescing cache is a window that an object can leave and re-enter,
+ * so "at most once for the whole scan" is a question the window cannot
+ * answer.  It costs memory in the number of distinct objects the log
+ * touched, which is the size of the answer rather than of the log.
+ */
+struct scan_cl_seen {
+	struct lu_fid		*sn_tab;
+	unsigned int		 sn_shift;	/* capacity is 1 << this */
+	size_t			 sn_used;
+};
+
+struct scan_cl {
+	const struct llapi_scan_changelog_param *sl_param;
+	llapi_scan_cb_t		 sl_cb;
+	void			*sl_data;
+	void			*sl_priv;	/* the changelog reader */
+	int			 sl_mnt_fd;	/* for resolution, or -1 */
+	__u64			 sl_want;
+	__u64			 sl_last_cleared;
+	__u64			 sl_clear_walked; /* sl_accepted at last walk */
+	__u64			 sl_accepted;	/* the last index a consumer
+						 * decided about, in sl_cb or
+						 * in sc_filter, for _CLEAR
+						 */
+	__s64			 sl_now;	/* the latest event time seen:
+						 * the stream's clock, not the
+						 * reader's
+						 */
+	__u32			 sl_min_age;
+	__u32			 sl_max_cached;
+	__u32			 sl_cached;
+	int			 sl_stop_rc;
+	struct llapi_scan_stats	 sl_stats;
+	struct scan_cl_seen	 sl_seen;	/* with _ONCE */
+	struct list_head	 sl_aged;	/* oldest first */
+	struct list_head	 sl_hash[SCAN_CL_HASH_SIZE];
+};
+
+/* The S_IFMT an event implies, or 0 where it implies nothing.  A creation's
+ * type is chosen from the mode in mdd_dir.c, so it can be read back; CL_MKNOD
+ * narrows only to one of four, which is not an S_IFMT.
+ */
+static __u32 scan_cl_mode(__u32 type)
+{
+	switch (type) {
+	case CL_CREATE:
+		return S_IFREG;
+	case CL_MKDIR:
+	case CL_RMDIR:
+		return S_IFDIR;
+	case CL_SOFTLINK:
+		return S_IFLNK;
+	default:
+		return 0;
+	}
+}
+
+static void scan_cl_obj_free(struct scan_cl_obj *o)
+{
+	free(o->co_name);
+	free(o->co_src_name);
+	free(o->co_jobid);
+	free(o);
+}
+
+/*
+ * The record as the event describes it.  Nothing here costs I/O: every field
+ * either came in the changelog record or is left absent for the consumer to
+ * see in lfsr_valid.
+ */
+static void scan_cl_rec_event(const struct scan_cl_obj *o,
+			      struct llapi_scan_rec *rec)
+{
+	memset(rec, 0, sizeof(*rec));
+	rec->lfsr_size = sizeof(*rec);
+	/*
+	 * The memset leaves these 0, which is stdin.  lustreapi.h documents
+	 * both as -1 when the scanner holds no descriptor, and a consumer
+	 * written against llapi_scan_namespace() tests lfsr_parent_fd and then
+	 * calls fstatat(rec->lfsr_parent_fd, rec->lfsr_name, ...) on it.
+	 */
+	rec->lfsr_parent_fd = -1;
+	rec->lfsr_fd = -1;
+
+	rec->lfsr_fid = o->co_fid;
+	rec->lfsr_parent_fid = o->co_pfid;
+	rec->lfsr_name = o->co_name;
+	rec->lfsr_event_uid = o->co_event_uid;
+	rec->lfsr_event_gid = o->co_event_gid;
+	rec->lfsr_stx.stx_mode = o->co_mode;
+	rec->lfsr_event_type = o->co_type;
+	rec->lfsr_event_flags = o->co_flags;
+	rec->lfsr_event_time = o->co_time;
+	rec->lfsr_event_index = o->co_index;
+	rec->lfsr_event_prev = o->co_prev;
+	rec->lfsr_src_fid = o->co_src_fid;
+	rec->lfsr_src_parent_fid = o->co_src_pfid;
+	rec->lfsr_src_name = o->co_src_name;
+	rec->lfsr_jobid = o->co_jobid;
+	/*
+	 * co_valid is kept in the one vocabulary sc_want is written in, and
+	 * split here into the two masks that report it.
+	 */
+	rec->lfsr_valid = o->co_valid & ~LLAPI_SCAN_STATX_MASK;
+	rec->lfsr_stx.stx_mask = o->co_valid & LLAPI_SCAN_STATX_MASK;
+}
+
+/*
+ * FIDs are unique only within one filesystem, so a mount of another one
+ * opens whatever has the same FID there and fills the record from it with
+ * no error.  @mnt is a mount point or a bare fsname, as
+ * llapi_root_path_open() takes it; an MDT name without "-MDT" in it gives
+ * nothing to compare and is let through.
+ */
+static int scan_cl_same_fs(const char *mnt, const char *mdtname)
+{
+	const char *dash = strstr(mdtname, "-MDT");
+	char mfs[PATH_MAX] = "";
+	size_t len;
+	int rc;
+
+	if (dash == NULL)
+		return 0;
+	len = dash - mdtname;
+	if (mnt[0] != '/') {
+		snprintf(mfs, sizeof(mfs), "%s", mnt);
+	} else {
+		rc = llapi_search_fsname(mnt, mfs);
+		if (rc < 0)
+			return rc;
+	}
+	if (strlen(mfs) != len || strncmp(mfs, mdtname, len) != 0) {
+		llapi_error(LLAPI_MSG_ERROR | LLAPI_MSG_NO_ERRNO, -EXDEV,
+			    "'%s' is a mount of '%s', not of the filesystem %s belongs to",
+			    mnt, mfs, mdtname);
+		return -EXDEV;
+	}
+	return 0;
+}
+
+/*
+ * Stat the object through its O_PATH fd.  Without AT_STATX_DONT_SYNC llite
+ * revalidates the inode with the MDT, so a cached inode cannot answer for an
+ * owner or mode another client has changed.  It also glimpses a regular
+ * file's size when the request names a size, blocks or a time, as stat(2)
+ * does.  No open is needed for either: an open is an MDS open, and it writes
+ * CL_OPEN and CL_CLOSE records when the changelog mask includes OPEN.
+ *
+ * With @glimpse false the request leaves out size, blocks and mtime, so the
+ * OSTs are not asked, and a regular file's size is the lazy one, read with
+ * AT_STATX_DONT_SYNC; *lazy says so.
+ *
+ * Return: 0, 1 if only the lazy size could not be read, or -errno.
+ */
+static int scan_cl_mdt_stat(int fd, bool glimpse, struct statx *stx,
+			    bool *lazy)
+{
+#ifdef HAVE_STATX
+	__u32 mask = STATX_BASIC_STATS | STATX_BTIME;
+	struct statx lz = { 0 };
+	int rc = 0;
+
+	if (!glimpse)
+		mask &= ~(STATX_SIZE | STATX_BLOCKS | STATX_MTIME);
+	if (statx(fd, "", AT_EMPTY_PATH, mask, stx) != 0)
+		return -errno;
+	/*
+	 * The lazy read second, and not first.  ll_getattr_dentry() skips
+	 * ll_inode_revalidate() for AT_STATX_DONT_SYNC, and
+	 * llapi_open_by_fid_at() sends no RPC for an inode already in cache,
+	 * so read first it answers from the last revalidation -- often this
+	 * FID's previous resolve in event mode -- and the revalidating call
+	 * below it never reaches the size.  After it, the cached size is at
+	 * least as new as the attributes beside it.
+	 */
+	*lazy = !glimpse && S_ISREG(stx->stx_mode);
+	if (*lazy &&
+	    statx(fd, "", AT_EMPTY_PATH | AT_STATX_DONT_SYNC,
+		  STATX_SIZE | STATX_BLOCKS, &lz) != 0)
+		rc = 1;
+
+	if (*lazy) {
+		stx->stx_size = lz.stx_size;
+		stx->stx_blocks = lz.stx_blocks;
+	}
+	return rc;
+#else
+	struct stat st;
+
+	/* fstat(2) always revalidates and glimpses, in whole seconds */
+	if (fstat(fd, &st) != 0)
+		return -errno;
+	memset(stx, 0, sizeof(*stx));
+	stx->stx_mask = STATX_BASIC_STATS;
+	stx->stx_mode = st.st_mode;
+	stx->stx_nlink = st.st_nlink;
+	stx->stx_uid = st.st_uid;
+	stx->stx_gid = st.st_gid;
+	stx->stx_size = st.st_size;
+	stx->stx_blocks = st.st_blocks;
+	stx->stx_atime.tv_sec = st.st_atime;
+	stx->stx_mtime.tv_sec = st.st_mtime;
+	stx->stx_ctime.tv_sec = st.st_ctime;
+	*lazy = false;
+	return 0;
+#endif
+}
+
+/*
+ * Fill what the changelog does not carry, from the object itself.
+ *
+ * This is one open by FID and a stat or two per object, and a glimpse for a
+ * regular file whose size or mtime is wanted, which is why it is opt-in and
+ * why object mode exists: a file written a hundred times is one lookup
+ * here, not a hundred.  An object that has since been unlinked cannot be
+ * opened, and that is not an error -- the record is delivered with what the
+ * event said and the rest absent, and a predicate that needed more counts
+ * undecided.
+ */
+static void scan_cl_resolve(struct scan_cl *sl, struct llapi_scan_rec *rec)
+{
+	bool glimpse;
+	bool lazy = false;
+	bool stated;
+	struct statx st = { 0 };
+	int fd;
+	int rc;
+
+	if (sl->sl_mnt_fd < 0 || !(rec->lfsr_valid & LLAPI_SCAN_FID))
+		return;
+
+	/*
+	 * The demand mask decides whether this costs anything: a consumer
+	 * that wants nothing a resolve can fill gets no open at all, even
+	 * with _RESOLVE set.
+	 */
+	if (sl->sl_want != 0 && (sl->sl_want & SCAN_CL_RESOLVE_MASK) == 0)
+		return;
+
+	/*
+	 * O_PATH first: it is what makes a symlink openable at all, since
+	 * open_by_handle_at() answers -ELOOP without it, and the attributes
+	 * that come back are the link's own rather than its target's.
+	 * O_NOFOLLOW says the same intent and does nothing to enforce it --
+	 * there is no pathname here to resolve -- so it rides along as
+	 * documentation.  O_PATH is also the only open this does: a real open
+	 * of a device node opens its driver, and any real open is an MDS open
+	 * that the changelog may record.
+	 */
+	fd = llapi_open_by_fid_at(sl->sl_mnt_fd, &rec->lfsr_fid,
+				  O_PATH | O_NOFOLLOW);
+	if (fd < 0)
+		return;		/* gone, or not ours to open */
+
+	glimpse = sl->sl_want == 0 ||
+		  (sl->sl_want & (LLAPI_SCAN_SIZE | LLAPI_SCAN_BLOCKS |
+				  LLAPI_SCAN_MTIME | LLAPI_SCAN_ATIME |
+				  LLAPI_SCAN_CTIME));
+	rc = scan_cl_mdt_stat(fd, glimpse, &st, &lazy);
+	stated = rc >= 0;
+
+	if (stated) {
+		rec->lfsr_stx.stx_mode = st.stx_mode;
+		rec->lfsr_stx.stx_nlink = st.stx_nlink;
+		/*
+		 * The owner, which no event carries: the changelog's uidgid
+		 * extension records who acted, and that arrives as
+		 * lfsr_event_uid.  So this never overwrites a recorded field,
+		 * and -uid is answerable only once a lookup has run.
+		 */
+		rec->lfsr_stx.stx_uid = st.stx_uid;
+		rec->lfsr_stx.stx_gid = st.stx_gid;
+		/* with the nanoseconds, as llapi_scan_namespace() gives them */
+		rec->lfsr_stx.stx_atime = st.stx_atime;
+		rec->lfsr_stx.stx_mtime = st.stx_mtime;
+		rec->lfsr_stx.stx_ctime = st.stx_ctime;
+		rec->lfsr_stx.stx_mask |= STATX_MODE | STATX_TYPE |
+					STATX_NLINK | STATX_UID | STATX_GID;
+		if (st.stx_mask & STATX_BTIME) {
+			rec->lfsr_stx.stx_btime = st.stx_btime;
+			rec->lfsr_stx.stx_mask |= STATX_BTIME;
+		}
+		/*
+		 * A regular file's times are exact only after a glimpse:
+		 * the OSTs move all three, and the MDT catches up at close.
+		 */
+		if (!lazy)
+			rec->lfsr_stx.stx_mask |= STATX_ATIME | STATX_MTIME |
+						  STATX_CTIME;
+		/*
+		 * A regular file's size is strict only after a glimpse;
+		 * otherwise it is the MDT's lazy size and LLAPI_SCAN_LAZY_*
+		 * say so.  Nothing else has stripes, so for the rest the
+		 * MDT's answer is the answer -- a symlink included, whose
+		 * size is the length of its target.
+		 */
+		rec->lfsr_stx.stx_size = st.stx_size;
+		rec->lfsr_stx.stx_blocks = st.stx_blocks;
+		if (!lazy) {
+			rec->lfsr_stx.stx_mask |= STATX_SIZE | STATX_BLOCKS;
+		} else if (rc == 0) {	/* not if the lazy read failed */
+			/*
+			 * With no SOM on the MDT, llite answers the inode's
+			 * own size, 0 when nothing has filled it: no answer,
+			 * and not told apart from an empty file.
+			 */
+			if (st.stx_size != 0)
+				rec->lfsr_valid |= LLAPI_SCAN_LAZY_SIZE;
+			if (st.stx_blocks != 0)
+				rec->lfsr_valid |= LLAPI_SCAN_LAZY_BLOCKS;
+		}
+	}
+
+	close(fd);
+}
+
+/* -------------------------------------------------------------------- */
+/* The delivered-object set: what LLAPI_SCAN_CL_F_ONCE tests against	 */
+
+/* an entry is keyed on a FID the coalescing cache accepted, and
+ * scan_cl_object() sends everything fid_is_sane() rejects the other way, so
+ * a zero slot is an empty one
+ */
+static bool scan_cl_fid_zero(const struct lu_fid *f)
+{
+	return f->f_seq == 0 && f->f_oid == 0;
+}
+
+static int scan_cl_seen_add(struct scan_cl_seen *sn, const struct lu_fid *fid);
+
+static int scan_cl_seen_grow(struct scan_cl_seen *sn, unsigned int shift)
+{
+	struct scan_cl_seen bigger = { 0 };
+	size_t cap = sn->sn_tab != NULL ? (size_t)1 << sn->sn_shift : 0;
+	size_t i;
+
+	bigger.sn_tab = calloc((size_t)1 << shift, sizeof(*bigger.sn_tab));
+	if (bigger.sn_tab == NULL)
+		return -ENOMEM;
+	bigger.sn_shift = shift;
+
+	for (i = 0; i < cap; i++) {
+		if (scan_cl_fid_zero(&sn->sn_tab[i]))
+			continue;
+		/* into a table at most three eighths full: cannot grow again,
+		 * so the recursion is one deep
+		 */
+		scan_cl_seen_add(&bigger, &sn->sn_tab[i]);
+	}
+
+	free(sn->sn_tab);
+	*sn = bigger;
+
+	return 0;
+}
+
+static int scan_cl_seen_add(struct scan_cl_seen *sn, const struct lu_fid *fid)
+{
+	size_t cap;
+	size_t i;
+
+	/* grown at three quarters full, as the directory map is: open
+	 * addressing turns into a walk of the whole table as it fills
+	 */
+	if (sn->sn_tab == NULL ||
+	    sn->sn_used * 4 >= ((size_t)1 << sn->sn_shift) * 3) {
+		int rc = scan_cl_seen_grow(sn, sn->sn_tab == NULL ?
+					   SCAN_CL_SEEN_MIN_SHIFT :
+					   sn->sn_shift + 1);
+
+		if (rc < 0)
+			return rc;
+	}
+
+	cap = (size_t)1 << sn->sn_shift;
+	i = llapi_fid_hash(fid, sn->sn_shift);
+	while (!scan_cl_fid_zero(&sn->sn_tab[i])) {
+		if (lu_fid_eq(&sn->sn_tab[i], fid))
+			return 0;
+		i = (i + 1) & (cap - 1);
+	}
+
+	sn->sn_tab[i] = *fid;
+	sn->sn_used++;
+
+	return 0;
+}
+
+static bool scan_cl_seen_has(const struct scan_cl_seen *sn,
+			     const struct lu_fid *fid)
+{
+	size_t cap;
+	size_t i;
+
+	if (sn->sn_tab == NULL)
+		return false;
+
+	cap = (size_t)1 << sn->sn_shift;
+	i = llapi_fid_hash(fid, sn->sn_shift);
+	while (!scan_cl_fid_zero(&sn->sn_tab[i])) {
+		if (lu_fid_eq(&sn->sn_tab[i], fid))
+			return true;
+		i = (i + 1) & (cap - 1);
+	}
+
+	return false;
+}
+
+static void scan_cl_seen_free(struct scan_cl_seen *sn)
+{
+	free(sn->sn_tab);
+	sn->sn_tab = NULL;
+	sn->sn_shift = 0;
+	sn->sn_used = 0;
+}
+
+/*
+ * Raised, never lowered: a held object flushed after a later one was
+ * delivered has a lower index, and lowering would stop _CLEAR short.
+ */
+static void scan_cl_accept(struct scan_cl *sl, __u64 index)
+{
+	if (index > sl->sl_accepted)
+		sl->sl_accepted = index;
+}
+
+/*
+ * @keyed says the object came out of the coalescing cache, so its FID is the
+ * one the cache keyed it on.  A record routed through scan_cl_event() is not
+ * keyed: in event mode every record is delivered, and in object mode it is a
+ * record about no object, which is not a duplicate of the next.
+ */
+static int scan_cl_deliver(struct scan_cl *sl, struct scan_cl_obj *o,
+			   bool keyed)
+{
+	const struct llapi_scan_changelog_param *sc = sl->sl_param;
+	bool once = keyed && (sc->sc_flags & LLAPI_SCAN_CL_F_ONCE);
+	struct llapi_scan_rec rec;
+	int rc;
+
+	scan_cl_rec_event(o, &rec);
+
+	if (sc->sc_filter != NULL) {
+		rc = sc->sc_filter(&rec, sl->sl_data);
+		if (rc > 0) {
+			sl->sl_stats.ss_filtered++;
+			/*
+			 * Consumed, as a record the callback took is: the
+			 * consumer's own code read it and said no.  Left
+			 * behind, _CLEAR stalls outright on a stream the
+			 * filter rejects entirely -- sl_accepted stays 0 and
+			 * scan_cl_clear() returns on it, while the registered
+			 * user's backlog grows without bound -- and on a
+			 * mixed stream it re-reads whatever tail of filtered
+			 * records a run ends on.  Object mode is still
+			 * bounded by scan_cl_held_first().
+			 */
+			scan_cl_accept(sl, o->co_index);
+			return 0;
+		}
+		if (rc < 0)
+			return rc;
+	}
+
+	/*
+	 * _ONCE: this object has been delivered already, so the events it
+	 * gathered since are dropped.  After sc_filter, which stays a view
+	 * of the whole stream -- lfs find's --since-cookie anchor is taken
+	 * there -- and before the resolve, which is what a duplicate would
+	 * cost.  sl_accepted moves anyway: the records were consumed, and
+	 * holding it back would stall _CLEAR on a log whose tail is all
+	 * repeats.
+	 */
+	if (once && scan_cl_seen_has(&sl->sl_seen, &o->co_fid)) {
+		scan_cl_accept(sl, o->co_index);
+		return 0;
+	}
+
+	if (sc->sc_flags & LLAPI_SCAN_CL_F_RESOLVE)
+		scan_cl_resolve(sl, &rec);
+
+	/* counted as handed over, as the other scanners count it */
+	sl->sl_stats.ss_emitted++;
+	rc = sl->sl_cb(&rec, sl->sl_data);
+	if (rc != 0)
+		return rc;
+
+	/* after the callback took it, so a scan the consumer stopped on this
+	 * record has not recorded it as delivered
+	 */
+	if (once) {
+		rc = scan_cl_seen_add(&sl->sl_seen, &o->co_fid);
+		if (rc < 0)
+			return rc;
+	}
+
+	scan_cl_accept(sl, o->co_index);
+
+	return 0;
+}
+
+/* -------------------------------------------------------------------- */
+/* Object mode: one record per object, once its events have settled       */
+
+static struct list_head *scan_cl_bucket(struct scan_cl *sl,
+					const struct lu_fid *fid)
+{
+	return &sl->sl_hash[llapi_fid_hash(fid, SCAN_CL_HASH_SHIFT)];
+}
+
+static struct scan_cl_obj *scan_cl_find(struct scan_cl *sl,
+					const struct lu_fid *fid)
+{
+	struct list_head *bucket = scan_cl_bucket(sl, fid);
+	struct scan_cl_obj *o;
+
+	list_for_each_entry(o, bucket, co_hash) {
+		if (lu_fid_eq(&o->co_fid, fid))
+			return o;
+	}
+
+	return NULL;
+}
+
+static void scan_cl_unlink(struct scan_cl *sl, struct scan_cl_obj *o)
+{
+	list_del(&o->co_hash);
+	list_del(&o->co_link);
+	sl->sl_cached--;
+}
+
+/*
+ * Emit everything that has been quiet for long enough, oldest first.  With
+ * @all, emit the lot: the stream has ended, or a consumer has stopped it.
+ *
+ * "Quiet for long enough" is measured on the stream's clock -- the latest
+ * event time read -- and not on the reader's.  Catching up on a log written
+ * an hour ago would otherwise find every object already older than sc_min_age
+ * the moment it arrived, and deliver a record per event, which is the mode
+ * the caller asked not to have.
+ */
+static int scan_cl_flush(struct scan_cl *sl, bool all)
+{
+	struct scan_cl_obj *o, *tmp;
+	int rc = 0;
+
+	list_for_each_entry_safe(o, tmp, &sl->sl_aged, co_link) {
+		if (!all && sl->sl_now - o->co_time < (__s64)sl->sl_min_age)
+			break;	/* the list is in last-seen order */
+
+		/*
+		 * Delivered first, and unlinked only once it was accepted.
+		 * An object that leaves the cache is no longer counted by
+		 * scan_cl_held_first(), so freeing one the consumer refused
+		 * would let scan_cl_clear() purge records nothing accepted --
+		 * and a restart from sc_startrec cannot read them back.
+		 */
+		rc = scan_cl_deliver(sl, o, true);
+		if (rc != 0)
+			return rc;	/* still cached, so still held */
+		scan_cl_unlink(sl, o);
+		scan_cl_obj_free(o);
+	}
+
+	return 0;
+}
+
+/* -------------------------------------------------------------------- */
+
+static char *scan_cl_strdup(const char *s, size_t len)
+{
+	char *copy;
+
+	if (s == NULL || len == 0)
+		return NULL;
+
+	copy = malloc(len + 1);
+	if (copy == NULL)
+		return NULL;
+
+	memcpy(copy, s, len);
+	copy[len] = '\0';
+
+	return copy;
+}
+
+/*
+ * What one changelog record says, in the terms the record uses, about the
+ * object @fid names: one of scan_cl_rec_fids(), or NULL for a record about
+ * none.
+ */
+static void scan_cl_absorb(struct scan_cl_obj *o, const struct changelog_rec *r,
+			   const struct lu_fid *fid)
+{
+	__u32 mode;
+
+	if (fid != NULL)
+		o->co_fid = *fid;
+	else
+		memset(&o->co_fid, 0, sizeof(o->co_fid));
+	/*
+	 * Only a namespace record carries a parent: it has a name, and a
+	 * CL_MARK's name is the MDT's.  The MDS fills cr_pfid for the others
+	 * (CL_CLOSE, CL_LAYOUT, CL_HSM, ...) only when it has one, in a
+	 * reused buffer, so there it can be the previous record's parent.
+	 */
+	if (r->cr_namelen != 0 && r->cr_type != CL_MARK &&
+	    fid_is_sane(&r->cr_pfid))
+		o->co_pfid = r->cr_pfid;
+	o->co_type = r->cr_type;
+	o->co_flags = r->cr_flags & CLF_FLAGMASK;
+	o->co_time = (__s64)(r->cr_time >> 30);	/* cr_time is 30-bit shifted */
+	o->co_index = r->cr_index;
+	/* no MDS writes cr_prev, and the reused buffer leaves old bytes */
+	o->co_prev = 0;
+	o->co_valid |= LLAPI_SCAN_EVENT;
+
+	if (fid_is_sane(&o->co_fid))
+		o->co_valid |= LLAPI_SCAN_FID;
+	else
+		o->co_valid &= ~LLAPI_SCAN_FID;
+	if (fid_is_sane(&o->co_pfid))
+		o->co_valid |= LLAPI_SCAN_PARENT;
+	else
+		o->co_valid &= ~LLAPI_SCAN_PARENT;
+
+	if (r->cr_namelen != 0) {
+		free(o->co_name);
+		/*
+		 * A copy that failed leaves no name rather than the previous
+		 * object's, which lfsr_name is documented to allow: NULL is
+		 * "no name could be recovered".
+		 *
+		 * Bounded with strnlen() rather than cr_namelen: for a
+		 * CLF_RENAME record mdd_changelog_rec_ext_rename() stores the
+		 * source name after the target one and adds its length to
+		 * cr_namelen, so the field spans both.  lustre_rsync.c bounds
+		 * it the same way.
+		 */
+		o->co_name = scan_cl_strdup(changelog_rec_name(r),
+					    strnlen(changelog_rec_name(r),
+						    r->cr_namelen));
+	}
+
+	/*
+	 * The S_IFMT a creation implies, and nothing more: LLAPI_SCAN_TYPE is
+	 * documented as the S_IFMT alone, which is exactly what this is.
+	 *
+	 * Only an event that implies a type answers it -- the three creations
+	 * and CL_RMDIR, whose target is a directory by definition -- so a
+	 * later event must not overwrite the answer with its own nothing.
+	 * Setting the mode whenever an event arrived, while the bit is only
+	 * ever OR'd in, would leave a coalesced object claiming to know its
+	 * type and carrying zero for it -- the one thing the validity mask
+	 * exists to keep apart, "cannot answer" from "the answer is zero".
+	 * An object's type does not change, so the first answer stands for
+	 * every event after it.
+	 */
+	mode = scan_cl_mode(r->cr_type);
+	if (mode != 0) {
+		o->co_mode = mode;
+		o->co_valid |= LLAPI_SCAN_TYPE;
+	}
+
+	if (r->cr_flags & CLF_RENAME) {
+		struct changelog_ext_rename *rn = changelog_rec_rename(r);
+
+		if (fid_is_sane(&rn->cr_sfid)) {
+			o->co_src_fid = rn->cr_sfid;
+			o->co_src_pfid = rn->cr_spfid;
+			free(o->co_src_name);
+			o->co_src_name = scan_cl_strdup(changelog_rec_sname(r),
+						changelog_rec_snamelen(r));
+			/* the bit says the source is there to read, so it
+			 * is not set over a copy that failed
+			 */
+			if (o->co_src_name != NULL)
+				o->co_valid |= LLAPI_SCAN_EVENT_SRC;
+			else
+				o->co_valid &= ~LLAPI_SCAN_EVENT_SRC;
+		}
+	}
+
+	if (r->cr_flags & CLF_JOBID) {
+		struct changelog_ext_jobid *j = changelog_rec_jobid(r);
+
+		if (j->cr_jobid[0] != '\0') {
+			free(o->co_jobid);
+			o->co_jobid = strdup(j->cr_jobid);
+			/* likewise: the bit promises a string, not a NULL */
+			if (o->co_jobid != NULL)
+				o->co_valid |= LLAPI_SCAN_JOBID;
+			else
+				o->co_valid &= ~LLAPI_SCAN_JOBID;
+		}
+	}
+
+	if (r->cr_flags & CLF_EXTRA_FLAGS) {
+		struct changelog_ext_extra_flags *ef =
+			changelog_rec_extra_flags(r);
+
+		if (ef->cr_extra_flags & CLFE_UIDGID) {
+			struct changelog_ext_uidgid *ug =
+				changelog_rec_uidgid(r);
+
+			/*
+			 * The acting client's credentials, not the object's
+			 * owner: mdd_changelog_ns_store() fills this from
+			 * lu_ucred(env).  lfsr_stx.stx_uid is the owner
+			 * wherever it is filled, and lfs find -uid matches
+			 * on that, so this goes to lfsr_event_uid and only a
+			 * resolve supplies the owner.
+			 */
+			o->co_event_uid = (__u32)ug->cr_uid;
+			o->co_event_gid = (__u32)ug->cr_gid;
+			o->co_valid |= LLAPI_SCAN_EVENT_UID;
+		}
+	}
+}
+
+/*
+ * The objects a record is about: at most two, in @fids.  Usually the target.
+ * A rename to a new name has a zero cr_tfid -- mdd_rename() passes no target
+ * to mdd_changelog_ns_store() -- and the object that moved is only in the
+ * rename extension, so it is that one.  A rename over an existing name is
+ * about both: the object it replaced and the one that moved.  A migrate
+ * is about one object, under its new FID.
+ *
+ * A CL_MARK is about none.  mdd_changelog_write_header() writes
+ * cr_markerflags into the union with cr_tfid, and CLM_ON|CLM_START lands
+ * inside FID_SEQ_IGIF, which fid_is_sane() accepts.
+ */
+static int scan_cl_rec_fids(const struct changelog_rec *r,
+			    struct lu_fid fids[2])
+{
+	int n = 0;
+
+	if (r->cr_type == CL_MARK)
+		return 0;
+	if (fid_is_sane(&r->cr_tfid))
+		fids[n++] = r->cr_tfid;
+	/* a CL_MIGRATE's cr_sfid is the object's old FID, now gone */
+	if ((r->cr_flags & CLF_RENAME) && r->cr_type != CL_MIGRATE) {
+		struct changelog_ext_rename *rn = changelog_rec_rename(r);
+
+		if (fid_is_sane(&rn->cr_sfid) &&
+		    (n == 0 || !lu_fid_eq(&rn->cr_sfid, &fids[0])))
+			fids[n++] = rn->cr_sfid;
+	}
+	return n;
+}
+
+/* one record per object the event is about, or one with no FID for none */
+static int scan_cl_event(struct scan_cl *sl, const struct changelog_rec *r)
+{
+	struct lu_fid fids[2];
+	int n = scan_cl_rec_fids(r, fids);
+	__u64 before = sl->sl_accepted;
+	int rc = 0;
+	int i = 0;
+
+	do {
+		struct scan_cl_obj one = { 0 };
+
+		scan_cl_absorb(&one, r, n > 0 ? &fids[i] : NULL);
+		rc = scan_cl_deliver(sl, &one, false);
+
+		free(one.co_name);
+		free(one.co_src_name);
+		free(one.co_jobid);
+	} while (rc == 0 && ++i < n);
+
+	/*
+	 * A rename over an existing name is two objects under one cr_index,
+	 * and sl_accepted moves per object.  A consumer that stops on the
+	 * second would otherwise leave the whole record counted as consumed,
+	 * and _CLEAR would purge it with no callback having seen that
+	 * object -- which is what llapi_scan_changelog.3 promises cannot
+	 * happen.  The cache is empty in event mode, so scan_cl_held_first()
+	 * does not hold it back either.  Put it back where it was: a record
+	 * is consumed only when all of it is.
+	 */
+	if (rc != 0)
+		sl->sl_accepted = before;
+
+	return rc;
+}
+
+static int scan_cl_object_one(struct scan_cl *sl, const struct changelog_rec *r,
+			      const struct lu_fid *fid)
+{
+	struct scan_cl_obj *o;
+
+	o = scan_cl_find(sl, fid);
+	if (o != NULL) {
+		/* seen again: it keeps its place in the hash and goes to the
+		 * back of the age list, carrying what the new event said
+		 */
+		list_del(&o->co_link);
+		scan_cl_absorb(o, r, fid);
+		list_add_tail(&o->co_link, &sl->sl_aged);
+		/*
+		 * Busy past the limit: delivered now, so that it is reported
+		 * at all and its first record can be cleared.  Its next event
+		 * starts it afresh.
+		 */
+		if (o->co_time - o->co_first_time >=
+		    (__s64)sl->sl_min_age * SCAN_CL_MAX_HOLD) {
+			int rc = scan_cl_deliver(sl, o, true);
+
+			if (rc != 0)
+				return rc;
+			scan_cl_unlink(sl, o);
+			scan_cl_obj_free(o);
+		}
+		return 0;
+	}
+
+	o = calloc(1, sizeof(*o));
+	if (o == NULL)
+		return -ENOMEM;
+
+	scan_cl_absorb(o, r, fid);
+	o->co_first = o->co_index;	/* only here: absorb() moves co_index */
+	o->co_first_time = o->co_time;
+	list_add_tail(&o->co_link, &sl->sl_aged);
+	list_add(&o->co_hash, scan_cl_bucket(sl, &o->co_fid));
+	sl->sl_cached++;
+
+	/*
+	 * The cache is a window, not a database.  When it is full the oldest
+	 * object leaves early, which costs a second record if that object is
+	 * touched again -- the alternative is holding a busy filesystem's
+	 * whole working set.
+	 */
+	if (sl->sl_cached > sl->sl_max_cached) {
+		struct scan_cl_obj *old;
+		int rc;
+
+		old = list_first_entry(&sl->sl_aged, struct scan_cl_obj,
+				       co_link);
+		/* as scan_cl_flush(): held until it is accepted */
+		rc = scan_cl_deliver(sl, old, true);
+		if (rc != 0)
+			return rc;
+		scan_cl_unlink(sl, old);
+		scan_cl_obj_free(old);
+	}
+
+	return 0;
+}
+
+/*
+ * Coalesce the record under each object it is about.  A record about none --
+ * a CL_MARK, or a rename whose FIDs are not sane -- is delivered per event
+ * instead: coalescing keys on the FID, and all of them would share one entry.
+ */
+static int scan_cl_object(struct scan_cl *sl, const struct changelog_rec *r)
+{
+	struct lu_fid fids[2];
+	int n = scan_cl_rec_fids(r, fids);
+	int rc = 0;
+	int i;
+
+	if (n == 0)
+		return scan_cl_event(sl, r);
+
+	for (i = 0; i < n && rc == 0; i++)
+		rc = scan_cl_object_one(sl, r, &fids[i]);
+
+	return rc;
+}
+
+/*
+ * The oldest record any cached object still depends on, or 0 for an empty
+ * cache.  Coalescing means an object's records can sit well below the last
+ * one delivered: create B at 10, create A at 11, touch B at 1000, and A can
+ * age out and be accepted while B is still held with a record at 10.
+ */
+static __u64 scan_cl_held_first(const struct scan_cl *sl)
+{
+	const struct scan_cl_obj *o;
+	__u64 first = 0;
+
+	list_for_each_entry(o, &sl->sl_aged, co_link) {
+		if (first == 0 || o->co_first < first)
+			first = o->co_first;
+	}
+
+	return first;
+}
+
+static void scan_cl_clear(struct scan_cl *sl, bool final)
+{
+	const struct llapi_scan_changelog_param *sc = sl->sl_param;
+	__u64 upto = sl->sl_accepted;
+	__u64 held;
+	int rc;
+
+	if (!(sc->sc_flags & LLAPI_SCAN_CL_F_CLEAR))
+		return;
+
+	/*
+	 * The batch test first: scan_cl_held_first() below walks the whole
+	 * cache, and it can only lower upto, so a batch too small to clear
+	 * is too small either way.  Walking first cost a pass over
+	 * sc_max_cached entries per record.
+	 */
+	if (upto == 0 || upto == sl->sl_last_cleared)
+		return;
+	/* from the last walk, not the last clear: a held object can pin that */
+	if (!final && upto - sl->sl_clear_walked < SCAN_CL_CLEAR_BATCH)
+		return;
+	sl->sl_clear_walked = upto;
+
+	/*
+	 * Never past a record an object still in the cache was built from.
+	 * Clearing to the last accepted index alone would purge it, and a
+	 * consumer that stops the scan there loses the object without any
+	 * callback having seen it -- and a restart from sc_startrec cannot
+	 * read it back, because the record is gone.
+	 */
+	held = scan_cl_held_first(sl);
+	if (held != 0 && held - 1 < upto)
+		upto = held - 1;
+
+	if (upto == 0 || upto <= sl->sl_last_cleared)
+		return;
+
+	/*
+	 * Only up to a record the consumer has taken or chosen not to
+	 * see -- one sc_filter rejected, or an _ONCE repeat.  Clearing is
+	 * irreversible and it is the registered user's whole backlog, not
+	 * ours alone, so it never runs ahead of the consumer.
+	 */
+	rc = llapi_changelog_clear(sc->sc_mdtname, sc->sc_user, upto);
+	if (rc < 0)
+		llapi_error(LLAPI_MSG_ERROR, rc,
+			    "cannot clear %s past record %llu",
+			    sc->sc_mdtname, (unsigned long long)upto);
+	else
+		sl->sl_last_cleared = upto;
+}
+
+/**
+ * llapi_scan_changelog() - an Object Stream from one MDT's changelog
+ * @sc: what to read and what to answer for
+ * @cb: called once per event, or once per object with _COALESCE
+ * @data: passed to @cb and to sc_filter untouched
+ *
+ * Reads @sc->sc_mdtname's changelog through the client's character device
+ * and delivers the records described in llapi_scan_changelog(3).  The stream
+ * ends at sc_endrec, at the end of the log, or when @cb returns non-zero,
+ * whose value is returned unchanged.
+ *
+ * A changelog answers what changed, never what exists: an object that has not
+ * been touched does not appear, however well it matches.  With
+ * LLAPI_SCAN_CL_F_CLEAR the consumed records are purged as they are accepted,
+ * which needs sc_user and cannot be undone.
+ *
+ * Return: 0 on success, the value a callback returned to stop the stream
+ * unchanged -- which need not be negative -- or a negative errno.
+ */
+int llapi_scan_changelog(const struct llapi_scan_changelog_param *sc,
+			 llapi_scan_cb_t cb, void *data)
+{
+	struct llapi_scan_changelog_param scl = { 0 };
+	enum changelog_send_flag flags;
+	struct changelog_rec *rec;
+	struct scan_cl *sl;
+	__u64 idx;
+	int crc;	/* what a consumer or a flush returned, not the read */
+	int rc;
+	int i;
+
+	if (sc == NULL || cb == NULL)
+		return -EINVAL;
+	rc = scan_cl_param_copyin(&scl, sc);
+	if (rc < 0)
+		return rc;
+
+	/*
+	 * Off the copy, and only after sc_size: sc_mdtname sits at the end of
+	 * the minimum, so reading it off the caller's own struct first would
+	 * read past a struct too short to carry it -- the size check is what
+	 * establishes that it is there at all.
+	 */
+	if (scl.sc_mdtname == NULL)
+		return -EINVAL;
+
+	/*
+	 * Only now, and off the copy.  sc_user and sc_mnt sit past the
+	 * minimum sc_size, so a caller whose struct stops short of them has
+	 * declared no such field: the copy reads zero there, the caller's
+	 * own memory would be read past its end.  llapi_scan_device() defers
+	 * its own lfsp_stats check for the same reason.
+	 */
+	if ((scl.sc_flags & LLAPI_SCAN_CL_F_CLEAR) && scl.sc_user == NULL)
+		return -EINVAL;
+	if ((scl.sc_flags & LLAPI_SCAN_CL_F_RESOLVE) && scl.sc_mnt == NULL)
+		return -EINVAL;
+	/*
+	 * Refused rather than ignored: event mode already delivers one record
+	 * per event by definition, so there is nothing for _ONCE to mean
+	 * there, and a caller that asked for at most one record per object
+	 * and got one per event would hear nothing about it.
+	 */
+	if ((scl.sc_flags & LLAPI_SCAN_CL_F_ONCE) &&
+	    !(scl.sc_flags & LLAPI_SCAN_CL_F_COALESCE))
+		return -EINVAL;
+	/*
+	 * sc_type_mask is intersected with the registered user's own mask,
+	 * which the client's mdc asks the MDS for; the mdc then drops the
+	 * other records as it reads them.  Without a user there is nothing
+	 * to intersect with, and the mask was dropped in silence.  Refused
+	 * rather than given a second meaning: sc_filter already filters
+	 * without a user.
+	 */
+	if (scl.sc_type_mask != 0 && scl.sc_user == NULL)
+		return -EINVAL;
+	/* a clear purges every type, so it would drop what the mask hid */
+	if (scl.sc_type_mask != 0 && (scl.sc_flags & LLAPI_SCAN_CL_F_CLEAR))
+		return -EINVAL;
+	if (scl.sc_stats != NULL &&
+	    scl.sc_stats->ss_size < LLAPI_SCAN_STATS_MIN_SIZE)
+		return -EINVAL;
+
+	sl = calloc(1, sizeof(*sl));
+	if (sl == NULL)
+		return -ENOMEM;
+
+	sl->sl_param = &scl;
+	sl->sl_cb = cb;
+	sl->sl_data = data;
+	sl->sl_mnt_fd = -1;
+	sl->sl_want = scl.sc_want;
+	if (scl.sc_got != NULL) {
+		__u64 known = SCAN_CL_EVENT_MASK;
+
+		/* a lookup is what adds the object's own attributes, and it
+		 * needs both the flag and a mount to open through
+		 */
+		if ((scl.sc_flags & LLAPI_SCAN_CL_F_RESOLVE) &&
+		    scl.sc_mnt != NULL)
+			known |= SCAN_CL_RESOLVE_MASK;
+		*scl.sc_got = scl.sc_want != 0 ? (scl.sc_want & known) : known;
+	}
+	sl->sl_min_age = scl.sc_min_age ?: SCAN_CL_MIN_AGE_DEF;
+	sl->sl_max_cached = scl.sc_max_cached ?: SCAN_CL_MAX_CACHED_DEF;
+	sl->sl_stats.ss_size = sizeof(sl->sl_stats);
+	INIT_LIST_HEAD(&sl->sl_aged);
+	for (i = 0; i < SCAN_CL_HASH_SIZE; i++)
+		INIT_LIST_HEAD(&sl->sl_hash[i]);
+
+	if (scl.sc_flags & LLAPI_SCAN_CL_F_RESOLVE) {
+		rc = llapi_root_path_open(scl.sc_mnt, &sl->sl_mnt_fd);
+		if (rc < 0) {
+			llapi_error(LLAPI_MSG_ERROR, rc,
+				    "cannot open '%s' to resolve FIDs; it has to be a client mount of the same filesystem",
+				    scl.sc_mnt);
+			goto out;
+		}
+		rc = scan_cl_same_fs(scl.sc_mnt, scl.sc_mdtname);
+		if (rc < 0)
+			goto out;
+	}
+
+	/*
+	 * EXTRA_FLAGS is what carries the uid and gid of whoever acted; asking
+	 * for JOBID costs nothing when the
+	 * server did not record one.
+	 */
+	flags = CHANGELOG_FLAG_EXTRA_FLAGS | CHANGELOG_FLAG_JOBID;
+	if (scl.sc_flags & LLAPI_SCAN_CL_F_FOLLOW)
+		flags |= CHANGELOG_FLAG_FOLLOW;
+
+	/*
+	 * Only a type mask needs the user: the filter ioctl looks the user up
+	 * on the MDS, which an MDS before 2.17.0 cannot do.  sc_user is
+	 * otherwise needed only to clear.
+	 */
+	if (scl.sc_type_mask != 0)
+		rc = llapi_changelog_start_user(&sl->sl_priv, flags,
+						scl.sc_mdtname, scl.sc_user,
+						scl.sc_type_mask,
+						(long long)scl.sc_startrec);
+	else
+		rc = llapi_changelog_start(&sl->sl_priv, flags, scl.sc_mdtname,
+					   (long long)scl.sc_startrec);
+	if (rc < 0) {
+		llapi_error(LLAPI_MSG_ERROR, rc, "cannot read %s's changelog",
+			    scl.sc_mdtname);
+		/*
+		 * llapi_changelog_start_user() opens the device and sets
+		 * *priv before it issues OBD_IOC_CHANGELOG_FILTER, so a
+		 * failure there leaves the reader live.  The fini here is
+		 * what closes it: the error path jumps past the one at the
+		 * end, and the fd, its buffer and the kernel-side reader
+		 * state stay pinned until the process exits otherwise.
+		 */
+		if (sl->sl_priv != NULL)
+			llapi_changelog_fini(&sl->sl_priv);
+		goto out;
+	}
+
+	/*
+	 * sc_want of 0 is "everything", so it is tested for on its own: it
+	 * is the caller that most needs the extension, and any test of the
+	 * form `sc_want & <bits>` reads 0 as wanting none of them.  Without
+	 * the flag the uidgid extension is dropped on repack and
+	 * LLAPI_SCAN_EVENT_UID never reaches lfsr_valid.
+	 */
+	if (scl.sc_want == 0 || scl.sc_want & LLAPI_SCAN_EVENT_UID)
+		llapi_changelog_set_xflags(sl->sl_priv,
+					   CHANGELOG_EXTRA_FLAG_UIDGID);
+
+	while ((rc = llapi_changelog_recv(sl->sl_priv, &rec)) == 0) {
+		sl->sl_now = (__s64)(rec->cr_time >> 30);
+
+		/* before the count: the record that ends the range was read
+		 * but not examined, and counting it made a bounded scan
+		 * report one more than it processed
+		 */
+		if (scl.sc_endrec != 0 && rec->cr_index > scl.sc_endrec) {
+			llapi_changelog_free(&rec);
+			break;
+		}
+
+		sl->sl_stats.ss_seen++;
+
+		if (scl.sc_flags & LLAPI_SCAN_CL_F_COALESCE)
+			crc = scan_cl_object(sl, rec);
+		else
+			crc = scan_cl_event(sl, rec);
+
+		idx = rec->cr_index;
+		llapi_changelog_free(&rec);
+		/*
+		 * Kept out of rc, which below decides whether the log may be
+		 * cleared: that turns on the READ having reached an end, and
+		 * a consumer's own sentinel is not a read failure whichever
+		 * sign it has.  sl_stop_rc carries it out as the return.
+		 */
+		if (crc != 0) {
+			sl->sl_stop_rc = crc;
+			rc = 0;
+			break;
+		}
+
+		if (scl.sc_flags & LLAPI_SCAN_CL_F_COALESCE) {
+			crc = scan_cl_flush(sl, false);
+			if (crc != 0) {
+				sl->sl_stop_rc = crc;
+				rc = 0;
+				break;
+			}
+		}
+
+		scan_cl_clear(sl, false);
+
+		/* sc_endrec is inclusive: under _FOLLOW the next record may
+		 * never come, so the range ends on this one
+		 */
+		if (scl.sc_endrec != 0 && idx >= scl.sc_endrec)
+			break;
+	}
+
+	if (rc == 1)		/* the end of the log, not an error */
+		rc = 0;
+
+	/* whatever is still held is delivered before the stream closes */
+	if (sl->sl_stop_rc == 0 && (scl.sc_flags & LLAPI_SCAN_CL_F_COALESCE)) {
+		int frc = scan_cl_flush(sl, true);
+
+		if (frc != 0)
+			sl->sl_stop_rc = frc;
+	}
+
+	/*
+	 * Not after a failed read.  Clearing is irreversible and purges the
+	 * registered user's whole backlog, so only a failed read keeps it
+	 * from advancing -- the same rule the
+	 * --since-cookie anchor follows, and for the same reason: a caller
+	 * that treats a negative return as "this run produced nothing" and
+	 * retries from its old position must still find the records there.
+	 *
+	 * The end of the log has already been folded into rc 0 above, and a
+	 * break out of the loop -- a consumer's stop, sc_endrec reached, or
+	 * a flush that failed -- sets it to 0 too; all of those are ends
+	 * this clears for, and the consumer's own value leaves as
+	 * sl_stop_rc instead.  rc is the read's, so only the read failing
+	 * leaves it negative, whatever sign a consumer chose for its
+	 * sentinel.  The flush above still runs either way: delivering what
+	 * is held costs the caller nothing, where clearing cannot be undone.
+	 */
+	if (rc >= 0)
+		scan_cl_clear(sl, true);
+	llapi_changelog_fini(&sl->sl_priv);
+
+	if (sl->sl_stop_rc != 0)
+		rc = sl->sl_stop_rc;
+out:
+	if (sl->sl_mnt_fd >= 0)
+		close(sl->sl_mnt_fd);
+
+	/* anything still cached after an error leaves with the scan */
+	while (!list_empty(&sl->sl_aged)) {
+		struct scan_cl_obj *o = list_first_entry(&sl->sl_aged,
+							 struct scan_cl_obj,
+							 co_link);
+		scan_cl_unlink(sl, o);
+		scan_cl_obj_free(o);
+	}
+
+	scan_cl_seen_free(&sl->sl_seen);
+
+	if (scl.sc_stats != NULL) {
+		__u32 room = scl.sc_stats->ss_size;
+
+		if (room > sizeof(sl->sl_stats))
+			room = sizeof(sl->sl_stats);
+		/* a whole counter, never half of one */
+		room = scan_stats_whole(room);
+		memcpy(scl.sc_stats, &sl->sl_stats, room);
+		scl.sc_stats->ss_size = room;
+	}
+
+	free(sl);
+
+	return rc;
+}
