+	/*
+	 * What the caller wrote, without a trailing slash: names are composed
+	 * by appending to this string, and "dir/" would compose "dir//name".
+	 * "/" keeps its slash, being the whole name.
+	 *
+	 * A walk does print the doubled separator -- llapi_semantic_traverse()
+	 * appends to the argument as given, and GNU find does the same --
+	 * so this is the one place --since's spelling differs from the same
+	 * search without it, deliberately: the set of objects is identical,
+	 * only the separator is tidied.
+	 */
+	if (snprintf(spelledbuf, sizeof(spelledbuf), "%s", path) >=
+	    (int)sizeof(spelledbuf))
+		return -ENAMETOOLONG;
+	spelledlen = strlen(spelledbuf);
+	while (spelledlen > 1 && spelledbuf[spelledlen - 1] == '/')
+		spelledbuf[--spelledlen] = '\0';
+	st.fss_spelled = spelledbuf;
+
+	rc = llapi_search_fsname(path, fsname);
+	if (rc < 0) {
+		llapi_error(LLAPI_MSG_ERROR, rc,
+			    "cannot find the filesystem of '%s'", path);
+		return rc;
+	}
+
+	/*
+	 * From rootbuf, not from @path.  The subtree test below compares
+	 * resolved pathnames against rootbuf, so the mount has to be the one
+	 * rootbuf is under: llapi_search_mounts() matches mnt_dir as a
+	 * literal prefix, so /home/user/data -> /mnt/lustre/data answers
+	 * -ENODEV from the spelling the caller gave, and a relative path
+	 * resolved through the fsname finds the first mount of that
+	 * filesystem rather than the one the caller is standing in -- which
+	 * with $MOUNT2 rejects every object and prints nothing.
+	 */
+	rc = llapi_search_mounts(rootbuf, 0, mnt_path, NULL);
+	if (rc < 0) {
+		llapi_error(LLAPI_MSG_ERROR, rc,
+			    "cannot find the mount point of '%s'", path);
+		return rc;
+	}
+
+	/*
+	 * LL_IOC_GETOBDCOUNT answers with the size of the LMV's target array,
+	 * not the number of MDTs that exist -- a single-MDT filesystem
+	 * reports 64 -- so it is an upper bound, and every index is confirmed
+	 * before its changelog is read.  Getting this wrong is not a slow
+	 * search but a wrong one: the count is what decides whether a bare
+	 * index is ambiguous.
+	 */
+	rc = llapi_get_obd_count(mnt_path, &mdt_bound, 1);
+	if (rc < 0) {
+		llapi_error(LLAPI_MSG_ERROR, rc,
+			    "cannot count the MDTs of '%s'", mnt_path);
+		return rc;
+	}
+	if (mdt_bound <= 0)
+		mdt_bound = 1;
+
+	mdts = calloc(mdt_bound, sizeof(*mdts));
+	if (mdts == NULL)
+		return -ENOMEM;
+
+	for (i = 0; i < mdt_bound; i++) {
+		snprintf(mdtname, sizeof(mdtname), "%s-MDT%04x_UUID",
+			 fsname, i);
+		if (llapi_search_tgt(fsname, NULL, mdtname, true) > 0)
+			mdts[mdt_count++] = i;
+	}
+
+	if (mdt_count == 0) {
+		llapi_error(LLAPI_MSG_ERROR | LLAPI_MSG_NO_ERRNO, 0,
+			    "'%s' has no MDT this client can see", fsname);
+		rc = -ENODEV;
+		goto out;
+	}
+
+	/*
+	 * cr_index is one MDT's counter, so a bare index names a different
+	 * instant on each of them.  Refused rather than answered from MDT0000
+	 * alone, which would be a short answer with nothing to say so.
+	 */
+	if (param->fp_since_kind == LLAPI_SINCE_INDEX && mdt_count > 1) {
+		llapi_error(LLAPI_MSG_ERROR | LLAPI_MSG_NO_ERRNO, 0,
+			    "--since %llu is an index, and an index belongs to one MDT: '%s' has %d. Give a time (--since 2h, --since @%lld) or name one MDT",
+			    (unsigned long long)param->fp_since_index,
+			    fsname, mdt_count, (long long)time(NULL));
+		rc = -EINVAL;
+		goto out;
+	}
+
+	rc = llapi_root_path_open(mnt_path, &st.fss_mnt_fd);
+	if (rc < 0) {
+		llapi_error(LLAPI_MSG_ERROR, rc,
+			    "cannot open '%s' to resolve FIDs", mnt_path);
+		goto out;
+	}
+
+	rc = common_param_init(param, (char *)path);
+	if (rc < 0)
+		goto out;
+
+	st.fss_param = param;
+	st.fss_mnt_path = mnt_path;
+	st.fss_fileset = find_mount_is_fileset(mnt_path) == 1;
+	st.fss_since = param->fp_since_kind == LLAPI_SINCE_TIME ?
+		       param->fp_since_time : 0;
+	/* the walk's own mask: the gather then matches a walk field by field */
+	st.fss_want = find_want(param, 0, false);
+	if (st.fss_want == 0)
+		/* 0 would be read as "the default"; this is the cheap floor */
+		st.fss_want = LLAPI_SCAN_FID | LLAPI_SCAN_MODE |
+			      LLAPI_SCAN_TYPE;
+
+	st.fss_multi_mdt = mdt_count > 1;
+	for (i = 0; i < mdt_count; i++) {
+		struct llapi_scan_changelog_param sc = { 0 };
+
+		snprintf(mdtname, sizeof(mdtname), "%s-MDT%04x", fsname,
+			 mdts[i]);
+		sc.sc_size = sizeof(sc);
+		/*
+		 * _ONCE for --since and not for --changelog: coalescing
+		 * reduces an object to one record only within sc_min_age, so
+		 * over a longer window an object touched in two bursts
+		 * arrives twice, is looked up twice and prints its path
+		 * twice -- where a walk prints it once.  --changelog reports
+		 * the log, and a second burst is a second thing that
+		 * happened, so it keeps both.
+		 */
+		sc.sc_flags = LLAPI_SCAN_CL_F_COALESCE | LLAPI_SCAN_CL_F_ONCE;
+		sc.sc_filter = find_since_filter_cb;
+		sc.sc_mdtname = mdtname;
+		/* the FID to verify, and the time to cut a window at */
+		sc.sc_want = LLAPI_SCAN_FID | LLAPI_SCAN_EVENT;
+		if (param->fp_since_kind == LLAPI_SINCE_INDEX)
+			sc.sc_startrec = param->fp_since_index;
+
+		rc = llapi_scan_changelog(&sc, find_since_cand_cb, &st);
+		if (rc < 0) {
+			llapi_error(LLAPI_MSG_ERROR, rc,
+				    "cannot read the changelog of '%s'",
+				    mdtname);
+			break;
+		}
+	}
+
+	if (rc == 0 && st.fss_scan_rc != 0)
+		rc = st.fss_scan_rc;
+
+	if (st.fss_gone != 0)
+		llapi_error(LLAPI_MSG_WARN | LLAPI_MSG_NO_ERRNO, 0,
+			    "%llu of %llu changed objects no longer exist%s and are not in the answer",
+			    (unsigned long long)st.fss_gone,
+			    (unsigned long long)st.fss_cand,
+			    st.fss_fileset ? ", or are outside this fileset," :
+			    "");
+	if (st.fss_undecided != 0)
+		llapi_error(LLAPI_MSG_WARN | LLAPI_MSG_NO_ERRNO, 0,
+			    "%llu objects could not be decided and are not in the answer",
+			    (unsigned long long)st.fss_undecided);
+	if (st.fss_dropped != 0)
+		llapi_error(LLAPI_MSG_WARN | LLAPI_MSG_NO_ERRNO, 0,
+			    "%llu objects were dropped with it",
+			    (unsigned long long)st.fss_dropped);
+out:
+	tdestroy(st.fss_seen, free);
+	free(mdts);
+	if (st.fss_mnt_fd >= 0)
+		close(st.fss_mnt_fd);
+	find_param_fini(param);
+
+	/* param_callback()'s convention: a positive is not a failure */
+	return rc < 0 ? rc : 0;
+}
+
 int llapi_find_device(const char *target, struct find_param *param,
 		      const struct llapi_scan_param *sp)
 {
