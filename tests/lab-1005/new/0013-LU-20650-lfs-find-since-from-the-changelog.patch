+/*
+ * A walk prints a path as the caller spelled it: param_callback() copies the
+ * argument into a buffer and llapi_semantic_traverse() appends to it, so
+ * "lfs find ." answers ./sub/f.  Every name here is instead mnt_path plus
+ * what fid2path returned, which is absolute, and --since would otherwise be
+ * a different answer from the same find without it for anything downstream
+ * that strips or compares the prefix.  So the spelling goes back on.
+ *
+ * Returns @abs unchanged when there is nothing to put back, which is the
+ * ordinary case of a caller who gave an already-canonical absolute path.
+ */
+static const char *find_since_respell(struct find_since_state *st,
+				      const char *abs, char *buf, size_t buflen)
+{
+	size_t rootlen = strlen(st->fss_root);
+	int rc;
+
+	if (abs == NULL || strcmp(st->fss_spelled, st->fss_root) == 0)
+		return abs;
+	if (strncmp(abs, st->fss_root, rootlen) != 0)
+		return abs;
+	if (abs[rootlen] == '\0')
+		return st->fss_spelled;
+	if (abs[rootlen] != '/')
+		return abs;
