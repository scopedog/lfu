+	 * "lfs find --threads 8 --since 2h" would run on one thread with
+	 * nothing said.
+	 */
+	if (param->fp_thread_count > 1) {
+		llapi_error(LLAPI_MSG_ERROR | LLAPI_MSG_NO_ERRNO, -ENOTSUP,
+			    "--threads describes a walk; --since reads one changelog per MDT in turn");
+		return -ENOTSUP;
+	}
