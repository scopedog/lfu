+	 * The path-ful form, unlike a target scan's: llapi_scan_fid() walked
+	 * to the object, so the steps that need a path -- the size glimpse,
+	 * the project id on demand -- work here as they do on a walk.  fc_fdp
+	 * is a descriptor of our own rather than the record's, so that
+	 * closing it cannot close one the scan still owns.
+	 */
+	fc.fc_rec = rec;
+	/* read only, as elsewhere; the subtree test above used the resolved
+	 * name, and what is printed is the caller's spelling of it
+	 */
+	fc.fc_path = (char *)find_since_respell(st, rec->lfsr_path, spelled,
