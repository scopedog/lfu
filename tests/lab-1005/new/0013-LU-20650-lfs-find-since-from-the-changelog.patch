diff --git a/lustre/utils/lfs_find_parse.c b/lustre/utils/lfs_find_parse.c
index 352481fa50..a970c17b9c 100644
--- a/lustre/utils/lfs_find_parse.c
+++ b/lustre/utils/lfs_find_parse.c
@@ -881,6 +881,132 @@ static void xattr_match_info_free(struct xattr_match_info *xmi)
 	xmi->xattr_value_buf = NULL;
 }
 
+/*
+ * --since takes one of four things and never guesses between them, because a
+ * bare 1787674596 could be a changelog index or an epoch second and the two
+ * answers are nothing alike:
+ *
+ *	4200			an index into one MDT's changelog
+ *	30m, 2h, 7d		that far back from now
+ *	2026-08-25T18:00	that time
+ *	@1787674596		that epoch second, said explicitly
+ *
+ * A bare integer means the index because that is what "lfs changelog MDT
+ * <startrec>" already takes, and the index is also the form that cannot mean
+ * one thing on every MDT -- so the spelling that has to be qualified is the
+ * one that is qualified.
+ */
+static int set_since(struct find_param *param, time_t now, const char *str)
+{
+	/*
+	 * -newerXt's table plus the ISO "T" separator, minus the bare "%s":
+	 * an unqualified number is an index here, which is why the epoch
+	 * second has to be written "@N".  The two today-relative forms are
+	 * -newerXt's and lfs-find(1) documents them for a reference time, so
+	 * they are here too.
+	 */
+	static const char *const fmts[] = { "@%s", "%Y-%m-%dT%H:%M:%S",
+					    "%Y-%m-%d %H:%M:%S",
+					    "%Y-%m-%dT%H:%M", "%Y-%m-%d %H:%M",
+					    "%Y-%m-%d",
+					    "%H:%M:%S", "%H:%M", NULL };
+	unsigned long long val;
+	struct tm tm;
+	char *end;
+	int i;
+
+	if (str == NULL || *str == '\0')
+		goto bad;
+
+	/*
+	 * strtoull() accepts a leading sign and wraps it, so "-5" would come
+	 * back as an index near 2^64 rather than as the mistake it is.
+	 * Neither an index nor a duration is ever signed here.
+	 */
+	if (*str == '-' || *str == '+')
+		goto bad;
+
+	errno = 0;
+	val = strtoull(str, &end, 10);
+
+	/* a bare integer: an index */
+	if (errno == 0 && end != str && *end == '\0') {
+		param->fp_since_kind = LLAPI_SINCE_INDEX;
+		param->fp_since_index = val;
+		return 0;
+	}
+
+	/* a duration with a single unit: that far back from now */
+	if (errno == 0 && end != str && *end != '\0' && *(end + 1) == '\0') {
+		unsigned long long unit = 0;
+
+		switch (*end) {
+		case 's':
+			unit = 1;
+			break;
+		case 'm':
+			unit = 60;
+			break;
+		case 'h':
+			unit = 60 * 60;
+			break;
+		case 'd':
+			unit = 24 * 60 * 60;
+			break;
+		case 'w':
+			unit = 7 * 24 * 60 * 60;
+			break;
+		case 'y':
+			unit = 365 * 24 * 60 * 60;
+			break;
+		default:
+			break;
+		}
+		/* a window that reaches past the epoch is a typo, not a scan */
+		if (unit != 0 && val <= (unsigned long long)now / unit) {
+			param->fp_since_kind = LLAPI_SINCE_TIME;
+			param->fp_since_time = now - (time_t)(val * unit);
+			return 0;
+		}
+		if (unit != 0)
+			goto bad;
+	}
+
+	/* a timestamp, or @<epoch second> */
+	for (i = 0; fmts[i] != NULL; i++) {
+		char *ptr;
+
+		/* the today-relative forms carry no date: seed one, as the
+		 * -newerXt parser does with its reference time
+		 */
+		if (strncmp(fmts[i], "%H", 2) == 0) {
+			localtime_r(&now, &tm);
+			tm.tm_sec = 0;	/* "%H:%M" sets no seconds */
+		} else {
+			memset(&tm, 0, sizeof(tm));
+			tm.tm_isdst = -1;
+		}
+		ptr = strptime(str, fmts[i], &tm);
+		while (ptr != NULL && isspace(*ptr))
+			ptr++;
+		if (ptr != NULL && *ptr == '\0') {
+			param->fp_since_kind = LLAPI_SINCE_TIME;
+			param->fp_since_time = mktime(&tm);
+			if (param->fp_since_time == (time_t)-1)
+				goto bad;
+			return 0;
+		}
+	}
+bad:
+	fprintf(stderr,
+		"%s: bad --since '%s'\n"
+		"an index is a bare number (4200); a time is a duration\n"
+		"(30s, 30m, 2h, 7d, 2w, 1y), a timestamp (2026-08-25T18:00 or\n"
+		"18:00 for today), or an epoch second as @1787674596\n",
+		progname, str != NULL ? str : "");
+	return -EINVAL;
+}
+
 /* The option table and its loop, moved out of lfs_find() unchanged. */
 int lfs_find_parse(int argc, char **argv, struct find_param *param,
 		   int *pathstartp, int *pathendp, bool *stopped)
@@ -1030,6 +1156,8 @@ int lfs_find_parse(int argc, char **argv, struct find_param *param,
 /* getstripe { .val = 'R', .name = "raw",	.has_arg = no_argument }, */
