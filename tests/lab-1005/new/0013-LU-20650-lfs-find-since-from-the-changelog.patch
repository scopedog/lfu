+/*
+ * Is @path inside the subtree the search was rooted at, and within the depth
+ * it asked for?  A walk gets both from the traversal; a changelog has neither,
+ * so they are recovered from the resolved pathname.
+ */
+static bool find_since_under(struct find_since_state *st, const char *path)
+{
+	const struct find_param *param = st->fss_param;
+	unsigned int depth = 0;
+	size_t rootlen;
+	const char *p;
+
+	rootlen = strlen(st->fss_root);
+	if (strncmp(path, st->fss_root, rootlen) != 0)
+		return false;
+	/* the root itself, or something below it -- not a sibling prefix */
+	if (path[rootlen] != '\0' && path[rootlen] != '/')
+		return false;
