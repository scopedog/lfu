+ * lfs find --since: the changelog is a candidate set, not the answer.
+ *
+ * The three pieces are already here.  llapi_scan_changelog() says which
+ * objects had an event, llapi_scan_fid() fills each one's record the way a
+ * walk fills it, and find_decide() judges it with the predicates a walk uses.
+ * So --since answers exactly what a plain find answers, over fewer objects:
+ * a strict subset, narrowed and never different.
+ */
+struct find_since_state {
+	struct find_param	*fss_param;
+	int			 fss_mnt_fd;
+	const char		*fss_mnt_path;
+	/* the mount is a fileset: a FID outside it does not resolve either */
+	bool			 fss_fileset;
+	/* the subtree the search was rooted at, and its depth */
+	const char		*fss_root;
+	/* and how the caller spelled it, which is what gets printed */
+	const char		*fss_spelled;
+	/*
+	 * Whether the lookup for this candidate reached its callback.  An
+	 * -ENOENT the callback itself returned -- find_get_projid() answers
+	 * one when the open fails -- is otherwise indistinguishable from
+	 * llapi_scan_fid()'s own "the FID no longer resolves", and a
+	 * per-object failure would be counted as an object that has gone.
+	 */
+	bool			 fss_cb_called;
+	__u64			 fss_undecided;	/* nothing settled them */
+	__u64			 fss_want;
+	time_t			 fss_since;	/* 0: the anchor is an index */
+	__u64			 fss_cand;	/* candidates seen */
+	__u64			 fss_gone;	/* candidates since unlinked */
+	/* the first per-object failure, returned once the scan is done */
+	int			 fss_scan_rc;
+	/*
+	 * How many objects that failure and its successors cost.  Without
+	 * it the run reports one errno at the end and nothing about how
+	 * much of the answer went with it, which fss_gone says for its own
+	 * case.
+	 */
+	__u64			 fss_dropped;
