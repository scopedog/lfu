+/*
+ * What the stream is asked before a record becomes a candidate: whether the
+ * record is inside the window at all.
+ *
+ * It is asked here rather than in the callback because sc_filter sees every
+ * record the stream produced, in order and before any lookup, and the
+ * callback does not: under LLAPI_SCAN_CL_F_ONCE an object already delivered
+ * is dropped before the callback.
+ */
+static int find_since_filter_cb(const struct llapi_scan_rec *rec, void *data)
+{
+	struct find_since_state *st = data;
+
+	/*
+	 * A time anchor is cut here rather than at the start record: an index
+	 * is per-MDT, so a time cannot be turned into one without reading the
+	 * log.  Coalescing reduces an object to its latest event only within
+	 * sc_min_age -- scan_cl_flush() delivers it once the stream clock has
+	 * moved that far past it -- so over a longer window an object arrives
+	 * once per burst.  Each of those carries its own event time, and this
+	 * drops the ones behind the window; an object that changed inside it
+	 * still arrives with an event inside it.
+	 *
+	 * Refused here and not in the callback because _ONCE records what
+	 * the callback was handed: a burst from before the window taken as a
+	 * delivery would suppress the burst inside it that follows, and turn
+	 * a duplicate line into a missing one.
+	 */
+	if (st->fss_since != 0 && (rec->lfsr_valid & LLAPI_SCAN_EVENT) &&
+	    rec->lfsr_event_time < st->fss_since)
+		return 1;
+
+	return 0;
+}
+
+static int find_fid_cmp(const void *a, const void *b)
+{
+	const struct lu_fid *x = a, *y = b;
+
+	if (x->f_seq != y->f_seq)
+		return x->f_seq < y->f_seq ? -1 : 1;
+	if (x->f_oid != y->f_oid)
+		return x->f_oid < y->f_oid ? -1 : 1;
+	if (x->f_ver != y->f_ver)
+		return x->f_ver < y->f_ver ? -1 : 1;
+	return 0;
+}
+
+/*
+ * Whether another MDT's log already gave this FID.  A remote mkdir or a
+ * cross-MDT rename puts one object in two logs.
+ *
+ * Return: 1 if seen, 0 if not (now recorded), or -ENOMEM.
+ */
+static int find_since_seen(struct find_since_state *st,
+			   const struct lu_fid *fid)
+{
+	struct lu_fid *key;
+	void *node;
+
+	key = malloc(sizeof(*key));
+	if (key == NULL)
+		return -ENOMEM;
+	*key = *fid;
+	node = tsearch(key, &st->fss_seen, find_fid_cmp);
+	if (node == NULL) {
+		free(key);
+		return -ENOMEM;
+	}
+	if (*(struct lu_fid **)node != key) {
+		free(key);
+		return 1;
+	}
+	return 0;
+}
+
+/* One coalesced object out of an MDT's changelog. */
+static int find_since_cand_cb(const struct llapi_scan_rec *rec, void *data)
+{
+	struct find_since_state *st = data;
+	struct llapi_scan_param sp = { .lfsp_size = sizeof(sp) };
+	int rc;
+
+	if (!(rec->lfsr_valid & LLAPI_SCAN_FID))
+		return 0;
+
+	if (st->fss_multi_mdt) {
+		rc = find_since_seen(st, &rec->lfsr_fid);
+		if (rc != 0)
+			return rc < 0 ? rc : 0;
+	}
+
+	/* the window cut is find_since_filter_cb()'s, before this */
+	st->fss_cand++;
+	sp.lfsp_want = st->fss_want;
+
+	st->fss_cb_called = false;
+	rc = llapi_scan_fid(st->fss_mnt_fd, st->fss_mnt_path, &rec->lfsr_fid,
+			    &sp, find_since_rec_cb, st);
+	/*
+	 * Unlinked between the event and now.  --since answers as it is now,
+	 * so an object that cannot be verified is not in the answer -- which
+	 * is what the flag gives up, and not an error.
+	 */
+	if ((rc == -ENOENT || rc == -ESTALE) && !st->fss_cb_called) {
+		st->fss_gone++;
+		return 0;
+	}
+
+	/*
+	 * A per-object failure is not the search's.  A walk records one and
+	 * reads the next dirent -- llapi_semantic_traverse() carries on
+	 * unless fp_stop_on_error -- and --since answers the same question
+	 * of the same objects, so it answers it the same way: keep the
+	 * first error, return it once the scan is done, and go on to the
+	 * candidates behind this one.
+	 *
+	 * llapi_scan_changelog() returns a callback's value unchanged and
+	 * the loop over the MDTs breaks on it, so returning rc here ended
+	 * the whole run -- this MDT and every one after it -- for a single
+	 * object.  One changed object under a directory the caller cannot
+	 * search is enough to do it: llapi_scan_fid() statx()es the
+	 * resolved pathname before opening anything, so that answers
+	 * -EACCES, which is neither -ENOENT nor -ESTALE and so is not
+	 * counted as gone either.
+	 */
+	if (rc < 0 && !st->fss_param->fp_stop_on_error) {
+		if (st->fss_scan_rc == 0)
+			st->fss_scan_rc = rc;
+		st->fss_dropped++;
+		return 0;
+	}
+
+	return rc;
+}
