+/* Stage 5, on a record llapi_scan_fid() filled: the ordinary predicates. */
+static int find_since_rec_cb(const struct llapi_scan_rec *rec, void *data)
+{
+	struct find_since_state *st = data;
+	struct find_param *param = st->fss_param;
+	struct llapi_scan_rec named;
+	char alt[PATH_MAX + 1];
+	char spelled[PATH_MAX + 1];
+	struct find_ctx fc = { 0 };
+	int checked_type = 0;
+	bool isdir;
+	int fd = -1;
+	int rc;
