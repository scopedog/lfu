+	    rec->lfsr_stx.stx_nlink <= 1)
+		return false;
+	if ((rec->lfsr_stx.stx_mask & STATX_MODE) &&
+	    S_ISDIR(rec->lfsr_stx.stx_mode))
+		return false;
