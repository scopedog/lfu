+/*
+ * The subtree test and the pre-filter, against every name the object has.
+ *
+ * llapi_scan_fid() resolves linkno 0, so a hardlinked file arrives under
+ * whichever of its names fid2path answered with first.  Testing only that
+ * one drops a file the search should have printed: for /mnt/lustre/a/f and
+ * /mnt/lustre/b/f the same inode, "lfs find /mnt/lustre/a --since 2h" is
+ * answered from b/f and rejects it, though a walk of a prints a/f.  -name
+ * has the same shape, which is why find_device_prefilter() walks every
+ * linkea name; here the names come from fid2path instead, one ioctl each.
+ *
+ * Only a file that has another name pays for that: the resolved one is
+ * tried first, and the link count says whether there is anywhere else to
+ * look.  @out is the record to go on with -- @rec itself, or a copy naming
+ * the link that answered.  A record with no pathname cannot be placed in
+ * the subtree at all, and --since has no answer without one.
+ */
+static bool find_since_pick(struct find_since_state *st,
+			    const struct llapi_scan_rec *rec,
+			    struct llapi_scan_rec *out, char *buf,
+			    size_t buflen, int *checked_type)
+{
+	struct find_param *param = st->fss_param;
+	char rel[PATH_MAX];
+	int linkno = 0;
+
+	*out = *rec;
+
+	if (rec->lfsr_path == NULL)
+		return false;
+
+	if (find_since_under(st, rec->lfsr_path) &&
+	    !find_prefilter(rec, param, checked_type))
+		return true;
+
+	if (!find_since_hardlinked(rec) || !(rec->lfsr_valid & LLAPI_SCAN_FID))
+		return false;
+
+	for (;;) {
+		long long recno = -1;
+		int prev = linkno;
+		const char *name;
+		const char *rp;
+		int rc;
+
+		rc = llapi_fid2path_at(st->fss_mnt_fd, &rec->lfsr_fid, rel,
+				       sizeof(rel), &recno, &linkno);
+		if (rc < 0)
+			return false;
+
+		/*
+		 * As llapi_scan_fid() and llapi_scan_rec_path() compose it.
+		 * mdt_path_current() keeps the leading '/' for a file with
+		 * LUSTRE_ENCRYPT_FL set -- it skips it only when isenc != 1
+		 * -- so an encrypted object answers "/a/f" where every other
+		 * one answers "a/f".  Composed unstripped that is
+		 * "<mnt>//a/f", which find_since_under() rejects against any
+		 * root below the mount, losing every alternate name of a
+		 * hardlinked encrypted file.
