diff --git a/lustre/tests/sanity.sh b/lustre/tests/sanity.sh
index 3e708d9863..d6b93685f2 100755
--- a/lustre/tests/sanity.sh
+++ b/lustre/tests/sanity.sh
@@ -22733,6 +22733,506 @@ test_160x() {
 }
 run_test 160x "changelog users do not disappear"
 
+test_160Aa() {
+	[[ $PARALLEL != "yes" ]] || skip "skip parallel run"
+	remote_mds_nodsh && skip "remote MDS with nodsh"
+
+	local all since nall nsince
+
+	mkdir_on_mdt0 $DIR/$tdir || error "mkdir $tdir failed"
+
+	changelog_register || error "changelog_register failed"
+	# after the registration, so its trap restores the mask this found.
+	# Creations only, deliberately: under a wide mask this test's own
+	# "lfs find" records events against the older files, which moves them
+	# back inside the --since window and the narrowing below stops being
+	# true.  160Ac asks for "creat" for the same reason.
+	changelog_chmask "creat"
+	changelog_clear 0 || error "changelog_clear failed"
+
+	# five before the window.  The gap is wide relative to the window on
+	# purpose -- a loaded node can spend seconds in sync, and the test has
+	# to keep meaning what it says when it does.
+	createmany -o $DIR/$tdir/old 5 || error "createmany failed"
+	sync; sleep 15
+	# two inside it
+	touch $DIR/$tdir/new1 $DIR/$tdir/new2 || error "touch failed"
+	sync; sleep 2
+
+	local raw
+
+	raw=$($LFS find $DIR/$tdir -type f) || error "lfs find failed"
+	all=$(sort <<< "$raw")
+	raw=$($LFS find $DIR/$tdir --since 8s -type f) ||
+		error "lfs find --since failed"
+	since=$(sort <<< "$raw")
+
+	# the promise: narrowed, never different
+	[[ -z "$(comm -13 <(echo "$all") <(echo "$since"))" ]] ||
+		error "--since returned objects a plain find did not"
+
+	nall=$(echo "$all" | grep -c .)
+	nsince=$(echo "$since" | grep -c .)
+	(( nsince < nall )) ||
+		error "--since returned $nsince of $nall: it narrowed nothing"
+
+	# and it kept the recent ones rather than just some ones: a count that
+	# merely shrank would also be satisfied by returning nothing at all
+	grep -q "/new1$" <<< "$since" || error "--since lost $tdir/new1"
+	grep -q "/new2$" <<< "$since" || error "--since lost $tdir/new2"
+	grep -q "/old" <<< "$since" &&
+		error "--since kept a file created before the window"
+
+	# a bare index is one MDT's, and is refused where that is ambiguous
+	if (( MDSCOUNT > 1 )); then
+		$LFS find $DIR/$tdir --since 1 -type f &> /dev/null &&
+			error "a bare --since index should be refused under DNE"
+	fi
+
+	# The spellings, and above all that a number is never guessed at: a
+	# bare one is an index and "@N" is an epoch second, which is the whole
+	# reason the epoch form has to be qualified.  An anchor an hour ago is
+	# a time on any filesystem, so it has to keep new1 and new2 the way
+	# "8s" did; the same number written bare is an index, which on a
+	# single-MDT filesystem is accepted and answers something else.
+	local hourago=$(($(date +%s) - 3600))
+
+	raw=$($LFS find $DIR/$tdir --since @$hourago -type f) ||
+		error "--since @$hourago failed"
+	since=$(sort <<< "$raw")
+	grep -q "/new1$" <<< "$since" || error "--since @N lost $tdir/new1"
+	grep -q "/new2$" <<< "$since" || error "--since @N lost $tdir/new2"
+
+	# the same instant as a timestamp, which has to give the same answer
+	local stamp=$(date -d @$hourago +%Y-%m-%dT%H:%M:%S)
+	local bystamp
+
+	raw=$($LFS find $DIR/$tdir --since "$stamp" -type f) ||
+		error "--since $stamp failed"
+	bystamp=$(sort <<< "$raw")
+	[[ "$bystamp" == "$since" ]] ||
+		error "--since $stamp and --since @$hourago disagree"
+
+	# a bare number is read as an index and not as that epoch second: on
+	# one MDT it is accepted, and an epoch second read as an index is far
+	# past the end of the log, so the answer is empty rather than the two
+	# above
+	if (( MDSCOUNT == 1 )); then
+		local byindex
+
+		byindex=$($LFS find $DIR/$tdir --since $hourago -type f) ||
+			error "--since $hourago failed"
+		[[ -z "$byindex" ]] ||
+			error "--since $hourago was read as an epoch second"
+	fi
+
+	# and the spellings that are not accepted
+	$LFS find $DIR/$tdir --since -5 -type f &> /dev/null &&
+		error "--since -5 should be refused"
+	$LFS find $DIR/$tdir --since 2h30m -type f &> /dev/null &&
+		error "--since 2h30m should be refused"
+	$LFS find $DIR/$tdir --since "" -type f &> /dev/null &&
+		error "an empty --since should be refused"
+
+	rm -rf $DIR/$tdir
+	changelog_deregister || error "changelog_deregister failed"
+}
+run_test 160Aa "lfs find --since is a subset of the same find"
+
+test_160Ab() {
+	[[ $PARALLEL != "yes" ]] || skip "skip parallel run"
+	remote_mds_nodsh && skip "remote MDS with nodsh"
+
+	local m=$MOUNT
+	local out
+
+	mkdir_on_mdt0 $DIR/$tdir || error "mkdir $tdir failed"
+
+	changelog_register || error "changelog_register failed"
+	changelog_chmask "ALL"
+	changelog_clear 0 || error "changelog_clear failed"
+
+	# with content, so the --resolve case below has something -size can
+	# match; a zero-length file makes "-size +0" succeed by finding nothing
+	echo data > $DIR/$tdir/f1 || error "create f1 failed"
+	sync; sleep 2
+
+	# it answers what the record carries -- and has to answer with
+	# something, or the case passes while the command found nothing
+	out=$($LFS find $m --changelog all --since 2m -type f) ||
+		error "--changelog -type f failed"
+	[[ -n "$out" ]] || error "--changelog -type f reported nothing"
+
+	# and refuses, rather than approximates, what it does not carry
+	$LFS find $m --changelog all -size +1 &> /dev/null &&
+		error "--changelog -size should be refused without --resolve"
+	$LFS find $m --changelog all -mtime -1 &> /dev/null &&
+		error "--changelog -mtime should be refused"
+	$LFS find $m --changelog all --maxdepth 1 &> /dev/null &&
+		error "--changelog --maxdepth should be refused"
+	$LFS find $DIR/$tdir --changelog all -type f &> /dev/null &&
+		error "--changelog below the mount should be refused"
+	$LFS find $m --changelog no-such-MDT9999 &> /dev/null &&
+		error "--changelog with an unknown MDT should be refused"
+	# a record carries none of these, and answering them from its zeroes
+	# is worse than saying so: --perm 644 would match nothing and its
+	# negation everything
+	$LFS find $m --changelog all --perm 644 &> /dev/null &&
+		error "--changelog --perm should be refused"
+	$LFS find $m --changelog all -links 1 &> /dev/null &&
+		error "--changelog -links should be refused"
+	# the directory-stripe options live behind fp_get_lmv, which needs a
+	# mode the record does not carry: accepted, they were never evaluated
+	$LFS find $m --changelog all --mdt-count 2 &> /dev/null &&
+		error "--changelog --mdt-count should be refused"
+	# -H/--mdt-hash is the spelling that sets fp_hash_type and
+	# fp_check_hash_flag; "--hash-type" is not an lfs find option at all,
+	# so it would exit non-zero from getopt whatever the refusal did
+	$LFS find $m --changelog all --mdt-hash fnv_1a_64 &> /dev/null &&
+		error "--changelog --mdt-hash should be refused"
+	# and a changelog cannot answer whose object it is, only who acted
+	$LFS find $m --changelog all -uid 0 &> /dev/null &&
+		error "--changelog -uid should be refused"
+	$LFS find $m --changelog all --xattr user.foo &> /dev/null &&
+		error "--changelog --xattr should be refused"
+
+	# a named MDT is the other half of --changelog's argument, and the
+	# only one that makes a bare --since index legal under DNE
+	$LFS find $m --changelog $FSNAME-MDT0000 -type f > /dev/null ||
+		error "--changelog with a named MDT failed"
+
+	# -name is answered from the record, and a record whose events are all
+	# data stores carries no name at all -- that reached fnmatch(NULL)
+	$LFS find $m --changelog all -name '*' > /dev/null ||
+		error "--changelog -name failed"
+
+	# --resolve on its own means nothing and is refused rather than dropped
+	$LFS find $m --resolve -type f &> /dev/null &&
+		error "--resolve without --changelog should be refused"
+
+	# --resolve is what lets the refused ones through, and the answer is
+	# asserted rather than just the exit status: -size needs a strict size,
+	# the MDT only has the lazy one, and a resolution that did not glimpse
+	# left every object "could not be decided" while still exiting 0.
+	out=$($LFS find $m --changelog all --since 2m --resolve -size +0) ||
+		error "--changelog --resolve -size failed"
+	grep -q "/f1$" <<< "$out" ||
+		error "--changelog --resolve -size did not report $tdir/f1"
+	# and it is the size that decided it, not everything matching
+	out=$($LFS find $m --changelog all --since 2m --resolve -size +1G) ||
+		error "--changelog --resolve -size +1G failed"
+	grep -q "/f1$" <<< "$out" &&
+		error "--changelog --resolve -size +1G matched a small file"
+
+	# --resolve answers -projid and -printf as well, which need a
+	# descriptor and a widened gather rather than the record alone: both
+	# used to fail on the first object, or report the MDT's lazy size
+	$LFS find $m --changelog all --since 2m --resolve --projid 0 \
+		> /dev/null || error "--changelog --resolve --projid failed"
+	out=$($LFS find $m --changelog all --since 2m --resolve -type f \
+		-printf '%p %s\n') ||
+		error "--changelog --resolve -printf failed"
+	# f1 holds "data": five bytes, and not the zero a lazy size reports
+	grep -q "/f1 5$" <<< "$out" ||
+		error "--resolve -printf did not report f1's real size"
+
+	# and --resolve is the escape hatch the below-the-mount refusal names,
+	# so it has to actually restrict to that subtree rather than answer
+	# for the whole filesystem
+	mkdir_on_mdt0 $DIR/${tdir}-other || error "mkdir other failed"
+	# it lives outside $tdir, so the rm at the end of the test does not
+	# cover an error between here and there, as 160Ac's cookies are
+	stack_trap "rm -rf $DIR/${tdir}-other"
+	echo data > $DIR/${tdir}-other/outside || error "create outside failed"
+	sync; sleep 2
+	out=$($LFS find $DIR/$tdir --changelog all --since 2m --resolve \
+		-type f) || error "--changelog --resolve below the mount failed"
+	grep -q "/f1$" <<< "$out" ||
+		error "--resolve subtree lost $tdir/f1"
+	grep -q "/outside$" <<< "$out" &&
+		error "--resolve answered outside the subtree it was given"
+
+	# and the two things that make --changelog worth having over --since:
+	# it answers as the event was recorded, so an object unlinked since
+	# then is still in the answer, and its FID names it once no pathname
+	# does.  --since verifies through the mount and so cannot report one.
+	local gonefid
+
+	echo data > $DIR/$tdir/gone || error "create gone failed"
+	gonefid=$($LFS path2fid $DIR/$tdir/gone) || error "path2fid failed"
+	sync
+	rm -f $DIR/$tdir/gone || error "rm gone failed"
+	sync; sleep 2
+
+	out=$($LFS find $m --changelog all --since 2m) ||
+		error "--changelog after an unlink failed"
+	grep -qF "$gonefid" <<< "$out" ||
+		error "--changelog did not name the unlinked $gonefid"
+
+	out=$($LFS find $m --since 2m) || error "lfs find --since failed"
+	grep -qF "$gonefid" <<< "$out" &&
+		error "--since reported $gonefid, which no longer exists"
+
+	# And -name selects rather than only surviving a NULL.  The name comes
+	# from the record, and coalescing carries it forward from whichever
+	# record in the same burst had one, so a window a few seconds wide does
+	# not remove it.
+	# So the creation has to be gone from the log entirely: clear it, then
+	# only write to f1, and the object has no name at all.  Last in the
+	# test, because clearing is what everything above still needs intact.
+	changelog_clear 0 || error "changelog_clear failed"
+	echo more >> $DIR/$tdir/f1 || error "write f1 failed"
+	echo new > $DIR/$tdir/f_new.log || error "create f_new.log failed"
+	sync; sleep 2
+
+	out=$($LFS find $m --changelog all -name 'f_new.log') ||
+		error "--changelog -name 'f_new.log' failed"
+	grep -q "/f_new.log$" <<< "$out" ||
+		error "--changelog -name missed f_new.log"
+
+	out=$($LFS find $m --changelog all -name 'f1') ||
+		error "--changelog -name 'f1' failed"
+	grep -q "/f1$" <<< "$out" &&
+		error "--changelog -name matched f1, whose records have no name"
+
+	rm -rf $DIR/$tdir $DIR/${tdir}-other
+	changelog_deregister || error "changelog_deregister failed"
+}
+run_test 160Ab "lfs find --changelog refuses what a record cannot answer"
+
+test_160Ac() {
+	[[ $PARALLEL != "yes" ]] || skip "skip parallel run"
+	remote_mds_nodsh && skip "remote MDS with nodsh"
+
+	local ck=$TMP/lfs-find-cookie.$$
+	local out
+	local sum
+
+	mkdir_on_mdt0 $DIR/$tdir || error "mkdir $tdir failed"
+	rm -f $ck
+	stack_trap "rm -f $ck"
+
+	changelog_register || error "changelog_register failed"
+	# creations only: a wide mask records this test's own reads, and then
+	# "nothing changed" is never true
+	changelog_chmask "creat"
+	changelog_clear 0 || error "changelog_clear failed"
+
+	touch $DIR/$tdir/a || error "touch a failed"
+	sync; sleep 2
+
+	$LFS find $DIR/$tdir --since-cookie $ck -type f > /dev/null ||
+		error "the first run failed"
+	[[ -s $ck ]] || error "no cookie was written to $ck"
+
+	touch $DIR/$tdir/b || error "touch b failed"
+	sync; sleep 2
+
+	out=$($LFS find $DIR/$tdir --since-cookie $ck -type f) ||
+		error "the second run failed"
+	grep -q "/b$" <<< "$out" || error "the second run missed $DIR/$tdir/b"
+	grep -q "/a$" <<< "$out" &&
+		error "the second run repeated $DIR/$tdir/a"
+
+	# nothing created since: the cookie has to have advanced past it
+	out=$($LFS find $DIR/$tdir --since-cookie $ck -type f) ||
+		error "the third run failed"
+	[[ -z "$out" ]] || error "the third run returned '$out'"
+
+	# bound to the root it was written under, not only the filesystem
+	sum=$(cksum < $ck)
+	out=$($LFS find $DIR --since-cookie $ck -type f 2>&1) &&
+		error "a cookie written under $DIR/$tdir was used under $DIR"
+	grep -q "is a cookie for a search under" <<< "$out" ||
+		error "refused for another reason: $out"
+	[[ "$(cksum < $ck)" == "$sum" ]] ||
+		error "the cookie refused for its root was rewritten"
+
+	# matches that could not be written leave the anchors where they were
+	touch $DIR/$tdir/c || error "touch c failed"
+	sync; sleep 2
+	$LFS find $DIR/$tdir --since-cookie $ck -type f > /dev/full \
+		2> /dev/null &&
+		error "a run whose output was lost reported success"
+	[[ "$(cksum < $ck)" == "$sum" ]] ||
+		error "a run whose output was lost advanced the cookie"
+	out=$($LFS find $DIR/$tdir --since-cookie $ck -type f) ||
+		error "the run after a lost one failed"
+	grep -q "/c$" <<< "$out" || error "the run after a lost one missed c"
+
+	# Both of these run while the cookie is still fresh, which is the
+	# right order but not for the reason it once said: neither refusal
+	# can be preempted by the staleness check.  llapi_find_since() tests
+	# --since against --since-cookie in its first block, and lfs_find()
+	# rejects a second path before it calls llapi_find_since() at all.
+
+	# the two anchors are alternatives
+	$LFS find $DIR/$tdir --since 2h --since-cookie $ck &> /dev/null &&
+		error "--since with --since-cookie should be refused"
+
+	# one path: the search runs once per path and each run advances the
+	# anchors, so a second path would start past the end of the log and
+	# report nothing at all
+	$LFS find $DIR/$tdir $DIR --since-cookie $ck &> /dev/null &&
+		error "--since-cookie with two paths should be refused"
+
+	# An anchor older than the oldest surviving record is refused.  The gap
+	# has to be made, not assumed: writing index 1 is only older than the
+	# oldest record on a filesystem that already has changelog history, and
+	# on a fresh one index 1 IS the oldest record, so nothing was purged and
+	# refusing would be wrong.  So write records this cookie has not
+	# consumed, purge them, and write one more past the hole.
+	createmany -o $DIR/$tdir/gap 5 || error "createmany failed"
+	sync; sleep 2
+	changelog_clear 0 || error "changelog_clear failed"
+	touch $DIR/$tdir/after || error "touch after failed"
+	sync; sleep 2
+	$LFS find $DIR/$tdir --since-cookie $ck -type f &> /dev/null &&
+		error "a stale cookie should be refused"
+
+	# An anchor past the newest record is what a restarted log looks like:
+	# indexes start again at 1 after the last user is deregistered and the
+	# MDT remounts.  A run from there would skip every record.
+	stack_trap "rm -f $ck.future"
+	sed "s/^\($FSNAME-MDT0000\) [0-9]*$/\1 999999999/" $ck > $ck.future
+	grep -q "^$FSNAME-MDT0000 999999999$" $ck.future ||
+		error "cannot make a cookie past the end of the log"
+	out=$($LFS find $DIR/$tdir --since-cookie $ck.future -type f 2>&1) &&
+		error "a cookie past the end of the log should be refused"
+	grep -q "changelog was restarted" <<< "$out" ||
+		error "refused for another reason: $out"
+
+	# a cookie that cannot be written is refused before anything is
+	# printed, not after the whole log has been read
+	$LFS find $DIR/$tdir --since-cookie $TMP/no-such-dir.$$/ck \
+		&> /dev/null &&
+		error "an unwritable cookie should be refused"
+
+	# Lines the cookie is never written with: a malformed MDT name is
+	# ignored, not read as an anchor.
+	stack_trap "rm -f $ck.bad $ck.other $ck.noroot"
+	{ head -n 1 $ck; echo "$FSNAME-MDT-1 42"; echo "$FSNAME-MDT-800 42"; } \
+		> $ck.bad
+	$LFS find $DIR/$tdir --since-cookie $ck.bad -type f > /dev/null ||
+		error "a malformed MDT name should be ignored"
+
+	# the run always writes its root, so a header without one is refused
+	cat > $ck.noroot <<-EOF
+		# lfs find --since-cookie for $FSNAME
+		$FSNAME-MDT0000 1
+	EOF
+	$LFS find $DIR/$tdir --since-cookie $ck.noroot -type f &> /dev/null &&
+		error "a cookie with no root should be refused"
+
+	# A cookie written for another filesystem anchors nothing here, and
+	# rewriting it would drop that filesystem's anchors as well.
+	cat > $ck.other <<-EOF
+		# lfs find --since-cookie for ${FSNAME}x
+		${FSNAME}x-MDT0000 7
+	EOF
+	$LFS find $DIR/$tdir --since-cookie $ck.other -type f &> /dev/null &&
+		error "a cookie for another filesystem should be refused"
+	grep -q "^${FSNAME}x-MDT0000 7" $ck.other ||
+		error "the refused cookie was rewritten"
+
+	rm -rf $DIR/$tdir
+	changelog_deregister || error "changelog_deregister failed"
+}
+run_test 160Ac "lfs find --since-cookie resumes where it stopped"
+
+test_160Ad() {
+	[[ $PARALLEL != "yes" ]] || skip "skip parallel run"
+	remote_mds_nodsh && skip "remote MDS with nodsh"
+
+	local found
+
+	mkdir_on_mdt0 $DIR/$tdir || error "mkdir $tdir failed"
+	mkdir $DIR/$tdir/a $DIR/$tdir/b || error "mkdir a b failed"
+
+	changelog_register || error "changelog_register failed"
+	# ALL, unlike 160Aa: nothing here is asserted absent, so this test's
+	# own events cost it nothing
+	changelog_chmask "ALL"
+	changelog_clear 0 || error "changelog_clear failed"
+
+	touch $DIR/$tdir/a/f || error "touch failed"
+	ln $DIR/$tdir/a/f $DIR/$tdir/b/g || error "ln failed"
+	sync; sleep 2
+
+	# A changelog names an object by FID, and fid2path answers with one of
+	# its names -- the first linkea entry, which is the one it was created
+	# under.  So a search rooted at b is answered about a/f, and a search
+	# for -name g is answered about "f".  Both have to look at the other
+	# names before dropping the object, the way a walk of b would have
+	# met it as b/g.
+	found=$($LFS find $DIR/$tdir/a --since 1h -type f) ||
+		error "lfs find --since under a failed"
+	[[ -n "$found" ]] ||
+		error "--since under $tdir/a lost the hardlinked file"
+
+	found=$($LFS find $DIR/$tdir/b --since 1h -type f) ||
+		error "lfs find --since under b failed"
+	[[ -n "$found" ]] ||
+		error "--since under $tdir/b lost the hardlinked file"
+
+	found=$($LFS find $DIR/$tdir --since 1h -name g) ||
+		error "lfs find --since -name failed"
+	[[ -n "$found" ]] ||
+		error "--since -name g did not match the second link"
+
+	# and the subtree still means something: a sibling holds no link
+	mkdir $DIR/$tdir/c || error "mkdir c failed"
+	found=$($LFS find $DIR/$tdir/c --since 1h -type f) ||
+		error "lfs find --since under c failed"
+	[[ -z "$found" ]] ||
+		error "--since under $tdir/c returned $found"
+
+	rm -rf $DIR/$tdir
+	changelog_deregister || error "changelog_deregister failed"
+}
+run_test 160Ad "lfs find --since finds a hardlink under either name"
+
+test_160Ae() {
+	[[ $PARALLEL != "yes" ]] || skip "skip parallel run"
+	remote_mds_nodsh && skip "remote MDS with nodsh"
+
+	local m=$MOUNT
+	local found
+
+	mkdir_on_mdt0 $DIR/$tdir || error "mkdir $tdir failed"
+	mkdir $DIR/$tdir/x $DIR/$tdir/a || error "mkdir x a failed"
+	touch $DIR/$tdir/x/f $DIR/$tdir/x/over $DIR/$tdir/a/old ||
+		error "touch failed"
+
+	changelog_register || error "changelog_register failed"
+	changelog_chmask "ALL"
+	changelog_clear 0 || error "changelog_clear failed"
+
+	# A rename to a new name leaves the record's target FID zero; the
+	# moved object is only the rename source.  A rename over a name has
+	# the replaced object as its target.  Both searches have to find the
+	# moved object under its new name.
+	mv $DIR/$tdir/x/f $DIR/$tdir/a/g || error "mv to a new name failed"
+	mv $DIR/$tdir/x/over $DIR/$tdir/a/old || error "mv over a name failed"
+	sync; sleep 2
+
+	found=$($LFS find $DIR/$tdir/a --since 1h -type f) ||
+		error "lfs find --since failed"
+	grep -qx "$DIR/$tdir/a/g" <<< "$found" ||
+		error "--since lost the file renamed to a new name: '$found'"
+	grep -qx "$DIR/$tdir/a/old" <<< "$found" ||
+		error "--since lost the file renamed over a name: '$found'"
+
+	found=$($LFS find $m --changelog all -name g) ||
+		error "lfs find --changelog -name g failed"
+	[[ -n "$found" ]] ||
+		error "--changelog -name g did not report the renamed file"
+
+	rm -rf $DIR/$tdir
+	changelog_deregister || error "changelog_deregister failed"
+}
+run_test 160Ae "lfs find --since and --changelog see a renamed file"
