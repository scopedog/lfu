diff --git a/Documentation/man1/lfs-find.1 b/Documentation/man1/lfs-find.1
index 615dfc700c..4b9e331acf 100644
--- a/Documentation/man1/lfs-find.1
+++ b/Documentation/man1/lfs-find.1
@@ -1,6 +1,6 @@
-.TH LFS-FIND 1 2026-03-06 Lustre "Lustre User Utilities"
+.TH LFS-FIND 1 2026-09-11 Lustre "Lustre User Utilities"
 .SH NAME
-lfs-find \- Lustre client utility to list files with specific attributes
+lfs-find \- Lustre utility to list files with specific attributes
 .SH SYNOPSIS
 .SY "lfs find"
 .IR DIRECTORY | FILENAME " ..."
@@ -166,6 +166,16 @@ lfs-find \- Lustre client utility to list files with specific attributes
 .RB [[ ! ]
 .BR --xattr
 .IR NAME [= VALUE ]]
+.SY "lfs find"
+.RB { --target
+.IR NAME |
+.B --fsname
+.IR FSNAME |
+.RB [ --device ]
+.IR DEVICE |\c
+.BR --local }
+.RB [ --internal ]
+.RI [ OPTION ]...
 .YS
 .SH DESCRIPTION
 .B lfs find
@@ -177,6 +187,22 @@ the same options as
 .BR find (1),
 as well as Lustre-specific attributes such as stripe count and size,
 OST and MDT location, and composite layout attributes.
+.PP
+Given a target instead of a directory,
+.B lfs find
+reads that MDT or OST straight off its device
+and matches the target's own objects with the same options.
+No client or MDS is involved.
+For a device named with
+.B --device
+or given as a block device, nothing needs to be mounted;
+.BR --target ,
+.B --fsname
+and
+.B --local
+read targets mounted on this node.
+This needs read access to the device and the scan backend
+that the Lustre server package installs.
 .SH OPTIONS
 .TP
 .BR -A ", " --atime
@@ -783,6 +809,82 @@ The regular expressions must match the complete attribute names and values,
 and not just a substring.
 This option may be specified multiple times, and the file must match all
 provided arguments.
+.SS Searching a target
+.TP
+.BI --device " DEVICE"
+Read the target on
+.IR DEVICE ,
+a block device, disk image, or snapshot,
+instead of walking a directory.
+A block device may also be given where a directory would be,
+without
+.BR --device ,
+unless the device node is itself stored on Lustre:
+that is a file, and is walked as before.
+A disk image may not, since it cannot be told apart from a file.
+.TP
+.BI --target " NAME"
+Read a target mounted on this node,
+named as
+.B mkfs.lustre
+labelled it, such as
+.BR testfs-MDT0000 .
+Its device is found through the
+.BI osd-*. NAME .mntdev
+parameter, which exists only while the target is mounted.
+.TP
+.BI --fsname " FSNAME"
+Read every MDT and OST of filesystem
+.I FSNAME
+that is mounted on this node, one after another, as
+.B --local
+does for all of them.
+.I FSNAME
+is the name
+.B mkfs.lustre
+was given, so it has to be one it would accept:
+1 to 8 letters, digits,
+.BR _ " or " - .
+A bare
+.I FSNAME
+without the option is a path, as it always is.
+.TP
+.B --local
+Read every MDT and OST mounted on this node, one after another.
+The MGS is skipped.
+Where the sweep finds more than one target,
+a line naming each one it reads goes to standard error ahead of its objects,
+so standard output stays a plain list.
+A target that cannot be read is reported and the others are still read,
+and the exit status is non-zero.
+So is a target this build has no scan backend for,
+and one that cannot answer an option, such as an OST asked about layouts.
+.B --ost
+and
+.B --mdt
+are different: here and under
+.BR --fsname ,
+a sweep skips the targets of the other kind rather than failing on them,
+and refuses the two options together, since no target would be left.
+.TP
+.B --internal
+Also report the objects a target keeps for itself,
+such as its OI and quota files,
+which are otherwise left out.
+One with no FID is printed as obj:ID, its object number on the target.
+.PP
+Only one of
+.BR --device ,
+.BR --target ,
+.B --fsname
+and
+.B --local
+may be given, and only one target named;
+.B --fsname
+and
+.B --local
+may read several.
+A target holds no pathnames, so each match is printed as its FID.
 .SH NOTES
 Specifying
 .B !
@@ -814,6 +916,43 @@ MDT inode attributes for each matching filename. If it can make a
 positive or negative decision for a file based only on the MDT attributes
 (e.g. newer than specified time, user/group/project ID) it will not fetch
 the OST object attributes for that file.
+.SS Searching a target
+A target is read as it is on disk, without locks or journal replay,
+so on a target in service the answer may not exactly match
+what a client would see at the same moment.
+Objects caught mid-update are skipped and counted, not reported wrongly.
+.PP
+Some options answer differently against a target:
+.TP
+.B One MDT is part of the namespace
+Under DNE, a directory's entries may be on another MDT,
+so a scan of one MDT can return fewer results with nothing to say so.
+.TP
+.BR --size ", " --blocks
+A striped file's size lives on its OSTs,
+so these use the size-on-MDT answer that
+.B --lazy
+gives, and a file without one is counted as undecided.
+.TP
+.BR --ost ", " --stripe-index ", " --mdt
+These name the target being read, so every object on it matches or none does.
+.B --ost
+applies to an OST, and so does
+.BR --stripe-index ,
+which is taken the same way;
+.B --mdt
+applies to an MDT.
+.TP
+.BR --xattr ", " --maxdepth ", " --mindepth ", " --threads ", " "-printf %p"
+These are refused.
+A target has no mount to read an extended attribute through,
+no directory tree to limit, and no pathnames to print.
+.B --ls
+is refused too, because its format ends in
+.BR %p .
+.PP
+.BR llapi_find_device (3)
+describes each difference in full.
 .SH BASH COMPLETION
 The
 .B lfs find
@@ -863,6 +1002,20 @@ number:
 .RE
 .EE
 .PP
+Lists the regular files over a gigabyte on an unmounted MDT, by FID:
+.EX
+.RS
+.B # lfs find --device /dev/vdb --type f --size +1G
+.RE
+.EE
+.PP
+Lists every object of project 1999 on this server's targets of testfs:
+.EX
+.RS
+.B # lfs find --fsname testfs --projid 1999
+.RE
+.EE
+.PP
 Recursively list all regular files in given directory more than 30 days old:
 .EX
 .RS
@@ -957,6 +1110,7 @@ filesystem package since release 0.10.0
 .BR lfs-getstripe (1),
 .BR lfs-migrate (1),
 .BR xargs (1),
+.BR llapi_find_device (3),
 .BR projid (5),
 .BR lustre (7),
 .BR regex (7)
diff --git a/Documentation/man3/llapi_find_device.3 b/Documentation/man3/llapi_find_device.3
index c46d45c6ae..36953c678b 100644
--- a/Documentation/man3/llapi_find_device.3
+++ b/Documentation/man3/llapi_find_device.3
@@ -19,7 +19,10 @@ to the objects of the MDT or OST named by
 which
 .BR llapi_scan_device (3)
 reads directly, and prints what matches.  The predicates are
-.BR lfs-find (1)'s.
+.BR lfs-find (1)'s,
+and it is what
+.B lfs find --device
+runs.
 .SS What it prints
 A target holds names and parent FIDs, not paths, so a match is named by its
 FID:
diff --git a/include/lustre/lustreapi.h b/include/lustre/lustreapi.h
index 958ed612ee..0b7b4c9f52 100644
--- a/include/lustre/lustreapi.h
+++ b/include/lustre/lustreapi.h
@@ -433,7 +433,9 @@ struct find_param {
 				 fp_obds_printed:1,
 				 fp_no_follow:1,
 				 fp_hex_idx:1,
-				 fp_unused_bits:28;
+				 fp_local_targets:1,	/* --local */
+				 fp_scan_internal:1,	/* --internal */
+				 fp_unused_bits:26;
 	unsigned int		 fp_depth;
 	unsigned int		 fp_hash_type;
 	unsigned int		 fp_time_margin; /* time margin in seconds */
@@ -489,6 +491,15 @@ struct find_param {
 	struct xattr_match_info	*fp_xattr_match_info;
 	struct find_work_queue	*fp_queue;
 	void			*fp_cb_data; /* Callback data */
+	/*
+	 * lfs find --device, --target and --fsname: a target read directly
+	 * rather than a namespace walked.  Only lfs uses these: its parser
+	 * returns everything it reads in this struct.  The library ignores
+	 * them.
+	 */
+	char			*fp_device;
+	char			*fp_target;
+	char			*fp_fsname;
 };
 
 /* Work unit for parallel directory processing */
diff --git a/lustre/tests/conf-sanity.sh b/lustre/tests/conf-sanity.sh
index 46d0e71250..a96cb180ff 100755
--- a/lustre/tests/conf-sanity.sh
+++ b/lustre/tests/conf-sanity.sh
@@ -13315,8 +13315,12 @@ test_300() {
 	local client_fids=$TMP/$tfile.client
 	local scan_fids=$TMP/$tfile.scan
 	local scan_err=$TMP/$tfile.scanerr
+	local file_fids=$TMP/$tfile.files
+	local find_fids=$TMP/$tfile.find
 	local missing
 
+	stack_trap "rm -f $TMP/$tfile.*"
+
 	# an error and not a skip: past the version check a scanner missing
 	# from mds1 is a packaging fault, which a skip would hide
 	do_facet mds1 "test -x $scanner" ||
@@ -13327,12 +13331,83 @@ test_300() {
 	createmany -o $DIR/$tdir/$tfile- 100 || error "createmany failed"
 	test_mkdir -c 1 -i 0 $DIR/$tdir/subdir || error "mkdir subdir failed"
 
-	# every FID the namespace can see, from the client that made them
-	$LFS find $DIR/$tdir | while read -r f; do
-		$LFS path2fid "$f"
-	done | sort > $client_fids
+	# every FID the namespace can see, from the client that made them.
+	# FIDs are compared without their brackets throughout.
+	$LFS find $DIR/$tdir -printf "%LF\n" | sort > $client_fids
 	[[ -s $client_fids ]] || error "no FIDs from the client"
 
+	# and the same question with a predicate, for lfs find to answer later
+	$LFS find $DIR/$tdir -type f -printf "%LF\n" | sort > $file_fids
+	[[ -s $file_fids ]] || error "no regular files from the client"
+
+	# and the directory's own FID, which --type f must not report.  Taken
+	# now: after stopall there is no client to ask, and an empty one would
+	# leave the grep below testing nothing.
+	local dirfid=$($LFS find $DIR/$tdir/subdir -maxdepth 0 -printf "%LF")
+
+	[[ -n "$dirfid" ]] || error "no FID for $DIR/$tdir/subdir"
+
+	# a --local sweep with --ost or --mdt reads only targets of that type,
+	# so where one node serves both it skips the other type.  ost1 must be
+	# ldiskfs too: a ZFS pool in use is refused.
+	if [[ "$ost1_FSTYPE" == ldiskfs ]] &&
+	   [[ $(facet_active_host mds1) == $(facet_active_host ost1) ]]; then
+		local ostsvc=$(facet_svc ost1)
+		local mdtsvc=$(facet_svc mds1)
+
+		do_facet mds1 "$LFS find --local --ost $ostsvc --type f" \
+			> /dev/null 2> $scan_err || {
+			cat $scan_err
+			error "lfs find --local --ost $ostsvc failed"
+		}
+		# the naming line is only printed when more than one target
+		# was swept, so assert the right one was read as well as that
+		# the wrong one was not -- otherwise an empty $scan_err
+		# passes both greps while checking nothing
+		grep -q -- "-OST" $scan_err || {
+			cat $scan_err
+			error "lfs find --local --ost $ostsvc did not read the OST"
+		}
+		grep -q -- "-MDT" $scan_err && {
+			cat $scan_err
+			error "lfs find --local --ost $ostsvc read an MDT"
+		}
+		do_facet mds1 "$LFS find --local --mdt $mdtsvc --type f" \
+			> /dev/null 2> $scan_err || {
+			cat $scan_err
+			error "lfs find --local --mdt $mdtsvc failed"
+		}
+		grep -q -- "-MDT" $scan_err || {
+			cat $scan_err
+			error "lfs find --local --mdt $mdtsvc did not read the MDT"
+		}
+		grep -q -- "-OST" $scan_err && {
+			cat $scan_err
+			error "lfs find --local --mdt $mdtsvc read an OST"
+		}
+	else
+		echo "not sweeping: mds1 and ost1 are not one ldiskfs node"
+	fi
+
+	# --target and --fsname while mds1 is up, which is where they are meant
+	# to answer; the sweep above runs only where mds1 and ost1 share a node.
+	local mdt1svc=$(facet_svc mds1)
+	local n
+
+	n=$(do_facet mds1 "$LFS find --target $mdt1svc --type f" \
+		2> $scan_err | wc -l)
+	(( n > 0 )) || {
+		cat $scan_err
+		error "lfs find --target $mdt1svc found no files"
+	}
+	n=$(do_facet mds1 \
+		"$LFS find --fsname $FSNAME --mdt $mdt1svc --type f" \
+		2> $scan_err | wc -l)
+	(( n > 0 )) || {
+		cat $scan_err
+		error "--fsname $FSNAME --mdt $mdt1svc found no files"
+	}
+
 	# and now the same objects, read off the device with nothing mounted:
 	# an unmounted target has no journal to replay and nothing moving, so
 	# a difference here is the scanner's and not the timing's
@@ -13345,7 +13420,7 @@ test_300() {
 		cat $scan_err
 		error "scanning $mdt1 failed"
 	}
-	sort $scan_fids.raw > $scan_fids
+	tr -d '[]' < $scan_fids.raw | sort > $scan_fids
 	do_facet mds1 "$scanner -d $mdt1" ||
 		error "llapi_scan_device_test on $mdt1 failed"
 
@@ -13372,9 +13447,114 @@ test_300() {
 
 	echo "scanned $(wc -l < $scan_fids) objects;" \
 		"found all $(wc -l < $client_fids) visible FIDs"
-	rm -f $client_fids $scan_fids $scan_fids.raw $scan_err
+
+	# lfs find runs the same predicates over that scan: every regular file
+	# the client listed has to come back, and no directory with it
+	do_facet mds1 "$LFS find --device $mdt1 --type f -printf '%LF\n'" \
+		> $find_fids.raw || error "lfs find on $mdt1 failed"
+	sort $find_fids.raw > $find_fids
+
+	missing=$(comm -23 $file_fids $find_fids)
+	[[ -z "$missing" ]] || {
+		echo "$missing" | head -20
+		error "lfs find lost $(echo "$missing" | wc -l) files"
+	}
+
+	# a directory must not be in a --type f answer
+	grep -qxF -- "$dirfid" $find_fids &&
+		error "lfs find --type f reported the directory $dirfid"
+
+	echo "lfs find --type f found all $(wc -l < $file_fids) files"
+
+	# the plain-argument form of the same target, and --device=VALUE.
+	# Redirect and sort as two steps: a pipeline's status is the last
+	# command's, so "| sort || error" would be testing sort.
+	#
+	# A plain argument is a target only when it is a block device: a
+	# file-backed MDT is a regular file, which cannot be told from a path
+	# and is walked as one, so that form needs --device.
+	if do_facet mds1 "test -b $mdt1"; then
+		do_facet mds1 "$LFS find $mdt1 --type f -printf '%LF\n'" \
+			> $find_fids.out ||
+			error "lfs find with a plain device argument failed"
+		sort $find_fids.out > $find_fids.raw
+		cmp -s $find_fids $find_fids.raw ||
+			error "lfs find $mdt1 differs from --device $mdt1"
+	fi
+
+	do_facet mds1 "$LFS find --device=$mdt1 --type f -printf '%LF\n'" \
+		> $find_fids.out || error "lfs find --device=$mdt1 failed"
+	sort $find_fids.out > $find_fids.raw
+	cmp -s $find_fids $find_fids.raw ||
+		error "lfs find --device=$mdt1 answered differently"
+
+	# naming a target twice is refused, not answered from the first --
+	# both as two selectors and as a selector plus a plain argument
+	do_facet mds1 "$LFS find --device $mdt1 $mdt1 --type f" &&
+		error "lfs find took two targets"
+	do_facet mds1 "$LFS find --device $mdt1 --device $mdt1 --type f" &&
+		error "lfs find took --device twice"
+
+	# --internal is the same scan without the class filter, so it can
+	# only add: an MDT's own objects -- O, oi.N, the d* buckets -- are
+	# what a cleanup tool must be able to see and must not act on
+	do_facet mds1 "$LFS find --device $mdt1" \
+		> $find_fids.out || error "lfs find on $mdt1 failed"
+	sort $find_fids.out > $find_fids.all
+	do_facet mds1 "$LFS find --device $mdt1 \
+			--internal" > $find_fids.out ||
+		error "lfs find --internal on $mdt1 failed"
+	sort $find_fids.out > $find_fids.int
+
+	missing=$(comm -23 $find_fids.all $find_fids.int)
+	[[ -z "$missing" ]] || {
+		echo "$missing" | head -20
+		error "--internal lost $(echo "$missing" | wc -l) objects"
+	}
+	(( $(wc -l < $find_fids.int) > $(wc -l < $find_fids.all) )) ||
+		error "--internal reported none of the target's own objects"
+
+	echo "--internal added $(( $(wc -l < $find_fids.int) -
+				   $(wc -l < $find_fids.all) )) objects"
+
+	# the selectors that need a mounted target, with nothing mounted:
+	# each has to say which target it could not find rather than scan
+	# something else or report an empty filesystem as an answer
+	do_facet mds1 "$LFS find --local --type f" > /dev/null 2> $scan_err &&
+		error "lfs find --local answered with every target stopped"
+	grep -q "no local Lustre targets" $scan_err || {
+		cat $scan_err
+		error "lfs find --local did not say there are none"
+	}
+
+	local svc=$(facet_svc mds1)
+
+	do_facet mds1 "$LFS find --target $svc --type f" \
+		> /dev/null 2> $scan_err &&
+		error "lfs find --target $svc answered with $svc stopped"
+	grep -q "no target '$svc' mounted here" $scan_err || {
+		cat $scan_err
+		error "lfs find --target did not say $svc is not mounted"
+	}
+
+	do_facet mds1 "$LFS find --fsname $FSNAME --type f" \
+		> /dev/null 2> $scan_err &&
+		error "lfs find --fsname $FSNAME answered with it stopped"
+	grep -q "no local targets of '$FSNAME'" $scan_err || {
+		cat $scan_err
+		error "lfs find --fsname did not say $FSNAME has none here"
+	}
+
+	# a name mkfs.lustre would refuse is refused, not searched for
+	do_facet mds1 "$LFS find --fsname fsname_too_long --type f" \
+		> /dev/null 2> $scan_err &&
+		error "lfs find took a --fsname over 8 characters"
+	grep -q "filesystem name" $scan_err || {
+		cat $scan_err
+		error "lfs find did not refuse fsname_too_long as a name"
+	}
 }
-run_test 300 "llapi_scan_device finds every object the namespace has"
+run_test 300 "a target scan finds every object, lfs find answers over it"
 
