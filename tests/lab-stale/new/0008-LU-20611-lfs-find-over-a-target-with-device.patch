+/* A target this node serves: what it is called, and what it lives on. */
+struct lfs_find_target {
+	/* an osd service name, char od_svname[MAX_OBD_NAME] on the far side */
+	char	lt_name[MAX_OBD_NAME];
+	char	lt_device[PATH_MAX];
+};
