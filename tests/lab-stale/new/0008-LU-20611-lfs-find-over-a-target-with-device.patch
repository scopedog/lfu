+			argv[0], named);
+		return CMD_HELP;
+	}
+
+	/* a sweep keeps only targets of the kind named: both leaves none */
+	if (device == NULL && param->fp_target == NULL &&
+	    param->fp_obd_uuid != NULL && param->fp_mdt_uuid != NULL) {
+		fprintf(stderr,
+			"%s: --ost and --mdt together match no target of a sweep\n",
+			argv[0]);
