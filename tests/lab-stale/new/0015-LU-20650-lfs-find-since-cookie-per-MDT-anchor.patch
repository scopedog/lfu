+	sc.sc_size = sizeof(sc);
+	sc.sc_mdtname = mdtname;
+	sc.sc_want = LLAPI_SCAN_FID | LLAPI_SCAN_EVENT;
+	sc.sc_startrec = startrec;
+
+	*first = 0;
+	rc = llapi_scan_changelog(&sc, find_cl_first_cb, first);
