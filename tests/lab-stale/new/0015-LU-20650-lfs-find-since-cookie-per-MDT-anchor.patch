+/*
+ * The temporary a cookie is written through, beside it and private to this
+ * run: two runs over one cookie -- a cron job that outlasts its interval --
+ * must not truncate or unlink each other's copy between write and rename.
+ * O_EXCL rather than mkstemp(), which would give a first run's cookie 0600
+ * instead of the umask's answer.
+ *
+ * Return: an open descriptor, or a negative errno.
+ */
+static int find_cookie_tmp(const char *file, char *tmp, size_t len)
+{
+	int i;
+
+	for (i = 0; i < 100; i++) {
+		int fd;
+
+		if (snprintf(tmp, len, "%s.%d.%d.new", file, (int)getpid(),
+			     i) >= (int)len)
+			return -ENAMETOOLONG;
+		fd = open(tmp, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0666);
+		if (fd >= 0)
+			return fd;
+		if (errno != EEXIST)
+			return -errno;
+	}
+
+	return -EEXIST;
+}
+
+/*
+ * Written whole and renamed over, so an interrupted run leaves the previous
+ * anchors rather than half of the new ones.  A cookie that is half written
+ * is worse than one that is stale, and find_cookie_check() catches the
+ * stale one.
+ *
+ * Every MDT the file knows of, not only the ones this run covered: a
+ * "--changelog MDT0001" run narrows mdt_count to one, and an MDT that is
+ * offline is not found at all, so writing only what was covered would drop
+ * the rest and make the next run repeat their whole logs.  @seen is indexed
+ * by MDT number and already carries the values read from the file, updated
+ * in place for the MDTs this run reached.
+ */
+static int find_cookie_write(const char *file, const char *fsname,
+			     const char *root, const __u64 *seen, int nseen)
+{
+	char rootesc[2 * PATH_MAX + 1];
+	char tmp[PATH_MAX];
+	struct stat st;
+	FILE *fp;
+	int rc = 0;
+	int fd;
+	int i;
+
+	rc = find_ck_escape(rootesc, sizeof(rootesc), root);
+	if (rc != 0)
+		return rc;
+
+	fd = find_cookie_tmp(file, tmp, sizeof(tmp));
+	if (fd < 0)
+		return fd;
+	fp = fdopen(fd, "w");
+	if (fp == NULL) {
+		rc = -errno;
+		close(fd);
+		unlink(tmp);
+		return rc;
+	}
+
+	/*
+	 * The rename below replaces the cookie, so its mode would be the
+	 * temporary's -- 0666 & ~umask -- and a `chmod 600` on a cookie that
+	 * names a job's search would be undone by the run that uses it.
+	 * Carried over where there is a cookie to carry it from; a first run
+	 * gets the umask's answer, as any created file does.
+	 */
+	if (stat(file, &st) == 0)
+		(void)fchmod(fileno(fp), st.st_mode & 07777);
+
+	fprintf(fp, "# lfs find --since-cookie for %s under %s\n", fsname,
+		rootesc);
+	for (i = 0; i < nseen; i++) {
+		if (seen[i] == 0)
+			continue;	/* never anchored: same as absent */
+		fprintf(fp, "%s-MDT%04x %llu\n", fsname, i,
+			(unsigned long long)seen[i]);
+	}
+
+	if (fflush(fp) != 0)
+		rc = -errno;
+	/* an earlier write failed and the buffer has since drained: errno says
+	 * nothing by now, but the file is short
+	 */
+	else if (ferror(fp) != 0)
+		rc = -EIO;
+	/*
+	 * The rename below is atomic against another process, which is not
+	 * the same as durable: after a host crash the rename can be on disk
+	 * while these bytes are not, and an empty cookie parses as no
+	 * anchors at all -- a whole rescan, reprinting everything, with
+	 * nothing said.
+	 */
+	else if (fsync(fileno(fp)) != 0)
+		rc = -errno;
+	if (fclose(fp) != 0 && rc == 0)
+		rc = -errno;
+
+	if (rc == 0 && rename(tmp, file) != 0)
+		rc = -errno;
+	if (rc != 0) {
+		unlink(tmp);
+	} else {
+		/* and the directory entry the rename made, for the same
+		 * reason; a filesystem that will not sync a directory is
+		 * not a reason to fail a run that wrote its cookie
+		 */
+		char *sep = strrchr(tmp, '/');
+		const char *dir = ".";
+		int dfd;
+
+		if (sep == tmp)
+			dir = "/";	/* the cookie sits in the root */
+		else if (sep != NULL) {
+			*sep = '\0';
+			dir = tmp;
+		}
+		dfd = open(dir, O_RDONLY | O_DIRECTORY);
+		if (dfd >= 0) {
+			fsync(dfd);
+			close(dfd);
+		}
+	}
+
+	return rc;
+}
