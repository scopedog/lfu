+/*
+ * Stop at the first record: its index is the oldest one still in the log.
+ *
+ * A record without an index is not index 0.  Storing 0 for it made a log that
+ * has records indistinguishable from one that has none, and 0 compares false
+ * against every anchor, so the stale check below was skipped in both cases --
+ * silently, on the one guard that exists to stop a short answer.  The scan was
+ * asked for LLAPI_SCAN_EVENT, so its absence is a protocol error to report
+ * rather than a value to record.
+ */
+static int find_cl_first_cb(const struct llapi_scan_rec *rec, void *data)
+{
+	__u64 *idx = data;
+
+	if (!(rec->lfsr_valid & LLAPI_SCAN_EVENT))
+		return -EPROTO;
+
+	*idx = rec->lfsr_event_index;
+	return 1;		/* one is enough */
