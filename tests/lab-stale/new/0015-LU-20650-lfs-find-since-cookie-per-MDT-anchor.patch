+				    -ESTALE,
+				    "'%s' holds records but none at or after %llu, which '%s' records: its changelog was restarted, and a run from there would skip them",
+				    mdtname, (unsigned long long)anchor,
+				    cookie);
+			return -ESTALE;
+		}
+	}
+
+	return 0;
+}
