+/*
+ * --since-cookie: where a previous run got to, per MDT.
+ *
+ * cr_index belongs to one MDT, so "where I got to" on a DNE filesystem is one
+ * number per MDT and not one number.  The file is the honest form of that,
+ * and it is read as a set of anchors and rewritten with the indexes this run
+ * reached.  A line is "<mdtname> <index>"; anything else is ignored, so a
+ * comment or a blank line costs the read nothing -- but the rewrite emits
+ * the header and the anchors and nothing else, so it does not survive the
+ * next run.  The file is this call's to own, not a place to annotate.
+ */
+/* a scanf field width spelled from the buffer's own size */
+#define FIND_CK_W_(x)	#x
+#define FIND_CK_W(x)	FIND_CK_W_(x)
+
+/*
+ * The root is the rest of the header line, and a pathname may hold a
+ * newline: only '/' and NUL are excluded from a name.  Written raw it ended
+ * the line, so the root read back short and every run after the first was
+ * refused naming a path the caller never gave -- the space case one
+ * character further out -- while the remainder became its own line and was
+ * dropped as unparsable.
+ *
+ * Escaped, the header carries any root.  Both sides escape and the reader
+ * compares the escaped forms, so nothing has to decode: the mapping is
+ * injective, which is all a comparison needs.  Backslash is escaped too, or
+ * it would not be.
+ */
+static int find_ck_escape(char *dst, size_t dstsize, const char *src)
+{
+	size_t n = 0;
+
+	for (; *src != '\0'; src++) {
+		const char *rep = NULL;
+
+		if (*src == '\\')
+			rep = "\\\\";
+		else if (*src == '\n')
+			rep = "\\n";
+
+		if (rep != NULL) {
+			if (n + 2 >= dstsize)
+				return -ENAMETOOLONG;
+			dst[n++] = rep[0];
+			dst[n++] = rep[1];
+		} else {
+			if (n + 1 >= dstsize)
+				return -ENAMETOOLONG;
+			dst[n++] = *src;
+		}
+	}
+	dst[n] = '\0';
+	return 0;
+}
+
+static int find_cookie_read(const char *file, const char *fsname,
+			    const char *root, __u64 *starts, int nstarts)
+{
+	/* both sized for a fully escaped root, which is twice its length */
+	char line[2 * PATH_MAX + NAME_MAX + 64];
+	char rootesc[2 * PATH_MAX + 1];
+	size_t fslen = strlen(fsname);
+	struct stat st;
+	FILE *fp;
+	int fd;
+	int rc;
+
+	rc = find_ck_escape(rootesc, sizeof(rootesc), root);
+	if (rc != 0)
+		return rc;
+
+	/* O_NONBLOCK so a FIFO cannot hang the open */
+	fd = open(file, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+	if (fd < 0) {
+		/* the first run has no cookie: start at the oldest record */
+		if (errno == ENOENT)
+			return 0;
+		return -errno;
+	}
+	if (fstat(fd, &st) != 0) {
+		rc = -errno;
+		close(fd);
+		return rc;
+	}
+	/* before any read: /dev/zero never reaches EOF */
+	if (!S_ISREG(st.st_mode)) {
+		close(fd);
+		llapi_error(LLAPI_MSG_ERROR | LLAPI_MSG_NO_ERRNO, -EINVAL,
+			    "the cookie '%s' is not a regular file", file);
+		return -EINVAL;
+	}
+	fp = fdopen(fd, "r");
+	if (fp == NULL) {
+		rc = -errno;
+		close(fd);
+		return rc;
+	}
+
+	while (fgets(line, sizeof(line), fp) != NULL) {
+		char name[NAME_MAX + 1];
+		char idxbuf[32];
+		unsigned long long idx;
+		unsigned int mdt;
+		const char *num;
+		char *end;
+		int pos;
+
+		/*
+		 * The header names the filesystem the file was written for.
+		 * Its lines would all be skipped below and then dropped by
+		 * the rewrite, so a cookie for another filesystem is refused
+		 * rather than read as no anchors at all.
+		 *
+		 * The fsname is a field; the root is the rest of the line.
+		 * A pathname can hold a space and %s cuts it at the first
+		 * one, so a search under "/mnt/lustre/my data" was recorded
