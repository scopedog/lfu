+/*
+ * The first record an MDT holds at or after @startrec (0: the oldest), in
+ * *@first.  A cookie older than the oldest means the records between them
+ * were purged, so the run would return a short answer with nothing to say
+ * so -- which is the failure a cookie exists to prevent.
+ *
+ * *@first is 0 only when there is no such record; changelog indexes start
+ * at 1, so the caller can tell that from a real index.  See the caller for
+ * why an empty log proceeds rather than refuses.
+ */
+static int find_cl_first(const char *mdtname, __u64 startrec, __u64 *first)
+{
+	struct llapi_scan_changelog_param sc = { 0 };
+	int rc;
