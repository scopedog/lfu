diff --git a/lustre/utils/liblustreapi_pfind.c b/lustre/utils/liblustreapi_pfind.c
index 2ce2955446..6ee73b2d2c 100644
--- a/lustre/utils/liblustreapi_pfind.c
+++ b/lustre/utils/liblustreapi_pfind.c
@@ -6500,6 +6500,37 @@ int llapi_find_since(const char *path, struct find_param *param)
 		if (param->fp_since_kind == LLAPI_SINCE_INDEX)
 			sc.sc_startrec = param->fp_since_index;
 
+		/*
+		 * find_cookie_check() ran before any MDT was read, so a purge
+		 * on this MDT while an earlier one was being read got past it.
+		 * Ask again just before reading: one record, as there.  The
+		 * cookie is not rewritten, so every later run is refused the
+		 * same way until it is removed, rather than skip the records.
+		 */
+		if (i > 0 && param->fp_since_cookie != NULL &&
+		    starts[mdts[i]] != 0) {
+			__u64 oldest = 0;
+
+			rc = find_cl_first(mdtname, 0, &oldest);
+			if (rc < 0) {
+				llapi_error(LLAPI_MSG_ERROR, rc,
+					    "cannot read the changelog of '%s'",
+					    mdtname);
+				break;
+			}
+			if (oldest > starts[mdts[i]] + 1) {
+				rc = -ESTALE;
+				llapi_error(LLAPI_MSG_ERROR |
+					    LLAPI_MSG_NO_ERRNO, rc,
+					    "'%s' purged past the cookie during this run: it starts at %llu, but '%s' records %llu, so the records in between are gone; '%s' is left where it was",
+					    mdtname, (unsigned long long)oldest,
+					    param->fp_since_cookie,
+					    (unsigned long long)starts[mdts[i]],
+					    param->fp_since_cookie);
+				break;
+			}
+		}
+
 		rc = llapi_scan_changelog(&sc, find_since_cand_cb, &st);
 		if (rc < 0) {
 			llapi_error(LLAPI_MSG_ERROR, rc,
