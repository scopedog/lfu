+	llapi_scan_test -d $DIR/$tdir -p $TMP ||
+		error "llapi_scan_test failed"
+}
+run_test 157c "llapi namespace scanner API tests"
+
 test_160a() {
 	[ $PARALLEL == "yes" ] && skip "skip parallel run"
 	remote_mds_nodsh && skip "remote MDS with nodsh"
