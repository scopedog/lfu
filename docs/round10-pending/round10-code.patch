diff --git a/lustre/utils/liblustreapi_scan_device.c b/lustre/utils/liblustreapi_scan_device.c
index 9cf7442779..34c648f500 100644
--- a/lustre/utils/liblustreapi_scan_device.c
+++ b/lustre/utils/liblustreapi_scan_device.c
@@ -403,7 +403,19 @@ static void scan_size(const struct llapi_scan_obj *obj, __u64 want,
 
 	rec->sr_size_bytes = __le64_to_cpu(som->lsa_size);
 	rec->sr_blocks = __le64_to_cpu(som->lsa_blocks);
-	rec->sr_valid |= LLAPI_SCAN_LAZY_SIZE | LLAPI_SCAN_LAZY_BLOCKS;
+	/*
+	 * SOM_FL_STRICT is "known strictly correct", and the MDT hands that
+	 * one to a client as a real size: mdt_pack_attr2body() sets
+	 * OBD_MD_FLSIZE and OBD_MD_FLBLOCKS for it while
+	 * mdt_enable_strict_som is on, which it is by default.  Collapsing
+	 * all three states to lazy would report the same file as approximate
+	 * from a target and exact from a namespace, which is the difference
+	 * the two bits exist to carry.
+	 */
+	if (valid & SOM_FL_STRICT)
+		rec->sr_valid |= LLAPI_SCAN_SIZE | LLAPI_SCAN_BLOCKS;
+	else
+		rec->sr_valid |= LLAPI_SCAN_LAZY_SIZE | LLAPI_SCAN_LAZY_BLOCKS;
 }
 
