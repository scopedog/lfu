diff --git a/lustre/utils/lfs_find_parse.h b/lustre/utils/lfs_find_parse.h
index d1401edee8..85578b9a33 100644
--- a/lustre/utils/lfs_find_parse.h
+++ b/lustre/utils/lfs_find_parse.h
@@ -87,10 +87,10 @@ enum {
 
 /*
  * Parse lfs find's predicates into @param.  @pathstartp and @pathendp come
- * back as the range of argv that is not an option, and are written only on
- * the success path; @stopped is set when the parse gave up, which the return
- * value alone does not always say, and is written only when it does.  So the
- * caller initialises all three, as lfs_find() does.
+ * back as the range of argv that is not an option, or -1 if there is none.
+ * @stopped is set when the parse gave up, which the return value alone does
+ * not always say.  All three are written at entry, so none of them reads
+ * back what the caller left there.
  *
  * A parse that got as far as an argument may have left heap in @param
  * whether it succeeded or not, so lfs_find_parse_fini() is owed either way.
diff --git a/lustre/utils/liblustreapi_pfind.c b/lustre/utils/liblustreapi_pfind.c
index a48a18857d..9b557e98a2 100644
