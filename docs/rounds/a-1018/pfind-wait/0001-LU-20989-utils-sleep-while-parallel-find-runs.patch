From 76979884abe0dad03d6468ab192b6323619ca3a3 Mon Sep 17 00:00:00 2001
From: Hiroshi Nishida <hnishida@thelustrecollective.com>
Date: Sun, 18 Oct 2026 16:52:19 -0700
Subject: [PATCH] LU-20989 utils: sleep while parallel find runs

pfind_param_callback() waits for the parallel find workers in a
loop that calls sched_yield(). lfs find uses at least 4 threads
by default, so every lfs find takes this path. sched_yield()
returns at once while the workers wait on the MDS, so the main
thread spins on a CPU for the whole walk. On a 4-CPU test node,
a find over 100k files spent 1.9s of its 4.7s CPU time in this
loop and took about 15% longer. On shutdown it also spins taking
fwq_lock in cleanup_work_queue(). The loop came with LU-17814.

Add fwq_done_cond. A worker signals it under fwq_lock when it
finishes the last unit or after a shutdown, and the main thread
sleeps on it under the same lock.

Signed-off-by: Hiroshi Nishida <hnishida@thelustrecollective.com>
Change-Id: Id63bff6afb076f2c96e91e18ee87a735002e252c
---
 include/lustre/lustreapi.h        |  1 +
 lustre/utils/liblustreapi_pfind.c | 20 ++++++++++++++++----
 2 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/include/lustre/lustreapi.h b/include/lustre/lustreapi.h
index fc7e0e7b72..8a0618ab58 100644
--- a/include/lustre/lustreapi.h
+++ b/include/lustre/lustreapi.h
@@ -540,6 +540,7 @@ struct find_work_queue {
 	struct find_work_unit *fwq_tail; /* ... add to tail */
 	pthread_mutex_t fwq_lock;
 	pthread_cond_t fwq_sleep_cond;
+	pthread_cond_t fwq_done_cond;	 /* Last unit done, or shutdown */
 	/* Atomic counter, active work units */
 #if HAS_STDATOMIC
 	atomic_int fwq_active_units;
diff --git a/lustre/utils/liblustreapi_pfind.c b/lustre/utils/liblustreapi_pfind.c
index 9f8941532e..1b77ae86ba 100644
--- a/lustre/utils/liblustreapi_pfind.c
+++ b/lustre/utils/liblustreapi_pfind.c
@@ -3456,7 +3456,12 @@ static void *find_worker(void *arg)
 		}
 
 		work_unit_free(unit);
-		ll_atomic_fetch_sub(&queue->fwq_active_units, 1);
+		/* under fwq_lock, so the waiter cannot miss the wakeup */
+		pthread_mutex_lock(&queue->fwq_lock);
+		if (ll_atomic_fetch_sub(&queue->fwq_active_units, 1) == 1 ||
+		    queue->fwq_shutdown)
+			pthread_cond_signal(&queue->fwq_done_cond);
+		pthread_mutex_unlock(&queue->fwq_lock);
 	}
 
 	return NULL;
@@ -3472,6 +3477,7 @@ static void find_work_queue_init(struct find_work_queue *queue,
 	queue->fwq_active_units = 0;
 	pthread_mutex_init(&queue->fwq_lock, NULL);
 	pthread_cond_init(&queue->fwq_sleep_cond, NULL);
+	pthread_cond_init(&queue->fwq_done_cond, NULL);
 	queue->fwq_shutdown = false;
 	queue->fwq_error = 0;
 	queue->fwq_cb_init = cb_init;
@@ -3884,13 +3890,18 @@ static int pfind_param_callback(char *path, struct find_param *param,
 		goto out;
 
 	/* Wait for all work to complete */
+	pthread_mutex_lock(&queue->fwq_lock);
 	while (ll_atomic_fetch_add(&queue->fwq_active_units, 0) > 0) {
 		/* if a worker hit an error, it forces shutdown... */
-		if (queue->fwq_shutdown)
+		if (queue->fwq_shutdown && queue->fwq_head) {
+			pthread_mutex_unlock(&queue->fwq_lock);
 			cleanup_work_queue(queue);
-		else
-			sched_yield();
+			pthread_mutex_lock(&queue->fwq_lock);
+			continue;
+		}
+		pthread_cond_wait(&queue->fwq_done_cond, &queue->fwq_lock);
 	}
+	pthread_mutex_unlock(&queue->fwq_lock);
 	/* collect error if one occurred... */
 	ret = queue->fwq_error;
 
@@ -3943,6 +3954,7 @@ cleanup:
 	free(threads);
 	pthread_mutex_destroy(&queue.fwq_lock);
 	pthread_cond_destroy(&queue.fwq_sleep_cond);
+	pthread_cond_destroy(&queue.fwq_done_cond);
 
 	return rc;
 }
-- 
